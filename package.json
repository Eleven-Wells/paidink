{
  "name": "Paidink",
  "version": "1.0.0",
  "description": "A community reading and writing platform for discovering and sharing stories across all topics",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "dev:serverless": "node scripts/serve-serverless.js",
    "start:serverless": "node scripts/serve-serverless.js",
    "build": "pnpm run build:css",
    "start:worker": "node worker/index.js",
    "build:css": "postcss public/css/tailwind.css -o public/css/output.css",
    "lint": "eslint src/ tests/ || echo 'No ESLint configured'",
    "lint:fix": "eslint src/ tests/ --fix || true"
  },
  "keywords": [
    "blog",
    "ai",
    "fastify",
    "mongodb",
    "sharing",
    "stories",
    "community",
    "reading",
    "writing",
    "discovering"
  ],
  "author": "Eleven Wells",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "@clerk/fastify": "^3.1.45",
    "@fastify/caching": "^9.0.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sse": "^0.4.0",
    "@fastify/static": "^8.3.0",
    "@fastify/view": "^11.1.1",
    "@sentry/node": "^10.48.0",
    "@sentry/profiling-node": "^10.48.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@upstash/redis": "^1.38.0",
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.8.2",
    "cheerio": "^1.1.2",
    "cron": "^3.3.0",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "fastify": "^5.6.1",
    "fastify-cron": "^1.4.0",
    "fastify-plugin": "^5.0.1",
    "i18next": "^25.6.0",
    "ioredis": "^5.4.1",
    "markdown-it": "^14.1.0",
    "mongoose": "^8.19.2",
    "node-fetch": "^2.7.0",
    "openai": "^4.52.7",
    "openid-client": "^6.8.4",
    "p-limit": "^3.1.0",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.0",
    "slugify": "^1.6.6",
    "sprintf-js": "^1.1.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jest": "^29.5.12",
    "@vercel/blob": "^2.4.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.16",
    "wrangler": "^4.118.0"
  }
}