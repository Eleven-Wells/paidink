<!DOCTYPE html>
<html lang="<%= lang || 'en' %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title || 'NOOK - Stay Informed' %>
    </title>
    <meta name="description"
        content="<%= description || 'Stay ahead with the latest in AI, web development, cloud computing, and technology innovation.' %>">

    <meta property="og:title" content="<%= title || 'NOOK - Stay Informed' %>">
    <meta property="og:description"
        content="<%= description || 'Read. Write. Engage. On Nook, attention isn\'t wasted, it\'s returned.' %>">
    <meta property="og:image"
        content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:type" content="<%= typeof ogType !== 'undefined' && ogType ? ogType : 'website' %>">
    <meta property="og:url" content="<%= canonical || '' %>">
    <meta property="og:site_name" content="NOOK">
    <meta property="og:locale" content="<%= lang || 'en_US' %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title || 'NOOK - Stay Informed' %>">
    <meta name="twitter:description"
        content="<%= description || 'Read. Write. Engage. On Nook, attention isn\'t wasted, it\'s returned.' %>">
    <meta name="twitter:image"
        content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large">
    <meta name="language" content="<%= lang || 'en' %>">
    <meta name="theme-color" content="#6d0a0a">

    <link rel="canonical" href="<%= canonical || '' %>">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/public/images/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">
    <link rel="prefetch" href="/browse">
    <link rel="prefetch" href="/dashboard">
    <link rel="prefetch" href="/register">
    <link rel="alternate" hreflang="en" href="<%= canonical || '' %>">
    <link rel="alternate" hreflang="x-default" href="<%= canonical || '' %>">

    <script type="application/ld+json">
    <%- JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "NOOK",
      "url": process.env.BASE_URL || '',
      "description": "Read. Write. Engage. On Nook, attention isn't wasted, it's returned.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": (process.env.BASE_URL || '') + "/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }) %>
    </script>
    <script type="application/ld+json">
    <%- JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "NOOK",
      "url": process.env.BASE_URL || '',
      "logo": (process.env.BASE_URL || '') + '/images/nook-logo.png',
      "sameAs": []
    }) %>
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Zen+Tokyo+Zoo&family=Abhaya+Libre:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <% if (typeof publisherMode !=='undefined' && publisherMode) { %>
        <link rel="stylesheet" href="/public/css/publisher-workspace.css">
        <% } %>

            <style>
                * {
                    box-sizing: border-box;
                }

                body {
                    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                    background-color: <%=(typeof isLightTheme !=='undefined' && isLightTheme) ? '#ffffff': '#ffffff' %>;
                    color: <%=(typeof isLightTheme !=='undefined' && isLightTheme) ? '#000000': '#ffffff' %>;
                    overflow-x: hidden;
                    min-height: 100vh;
                }

                .font-heading {
                    font-family: 'Space Grotesk', sans-serif;
                }

                .font-mono {
                    font-family: 'JetBrains Mono', monospace;
                }

                <% if (typeof isLightTheme !=='undefined' && isLightTheme) {
                    %>.text-muted {
                        color: #5f5a58;
                    }

                    .text-muted-dark {
                        color: #7b736f;
                    }

                    .bg-muted {
                        background-color: rgba(109, 10, 10, 0.04);
                    }

                    .border-muted {
                        border-color: rgba(109, 10, 10, 0.12);
                    }

                    <%
                }

                else {
                    %>.text-muted {
                        color: rgba(255, 255, 255, 0.5);
                    }

                    .text-muted-dark {
                        color: rgba(255, 255, 255, 0.35);
                    }

                    .bg-muted {
                        background-color: rgba(255, 255, 255, 0.05);
                    }

                    .border-muted {
                        border-color: rgba(255, 255, 255, 0.1);
                    }

                    <%
                }

                %>.bg-noise {
                    position: fixed;
                    inset: 0;
                    pointer-events: none;
                    z-index: 0;
                    opacity: 0.03;
                    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160%22 xmlns='http://www.w3.org/2000/svg%22%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.92' numOctaves='2'/%3E%3C/filter%3E%3Crect width='160' height='160' filter='url(%23noise)' opacity='0.95'/%3E%3C/svg%3E");
                }

                .bg-grid {
                    position: fixed;
                    inset: 0;
                    pointer-events: none;
                    z-index: 0;
                    opacity: 0.05;
                    background-image:
                        linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
                    background-size: 120px 120px;
                    mask-image: radial-gradient(circle at center, black 42%, transparent 86%);
                }

                .bg-blobs {
                    position: fixed;
                    inset: 0;
                    pointer-events: none;
                    z-index: 0;
                }

                .blob-1 {
                    position: absolute;
                    left: -8%;
                    top: -6%;
                    height: 34rem;
                    width: 34rem;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.07);
                    filter: blur(120px);
                    animation: blob 20s ease-in-out infinite;
                }

                .blob-2 {
                    position: absolute;
                    right: -12%;
                    top: 18%;
                    height: 38rem;
                    width: 38rem;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.055);
                    filter: blur(150px);
                    animation: blob 20s ease-in-out infinite reverse;
                    animation-delay: -5s;
                }

                .blob-3 {
                    position: absolute;
                    bottom: -24%;
                    left: 16%;
                    height: 40rem;
                    width: 42rem;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.05);
                    filter: blur(155px);
                    animation: blob 20s ease-in-out infinite;
                    animation-delay: -10s;
                }

                @keyframes blob {

                    0%,
                    100% {
                        transform: translate(0, 0) scale(1);
                    }

                    25% {
                        transform: translate(20px, -30px) scale(1.05);
                    }

                    50% {
                        transform: translate(-20px, 20px) scale(0.95);
                    }

                    75% {
                        transform: translate(30px, 10px) scale(1.02);
                    }
                }

                .glass-card {
                    background: linear-gradient(145deg, rgba(16, 16, 16, 0.96), rgba(5, 5, 5, 0.98));
                    border: 1px solid rgba(255, 255, 255, 0.08);
                    backdrop-filter: blur(12px);
                    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.34);
                }

                .glass-card-light {
                    background: rgba(255, 255, 255, 0.02);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    backdrop-filter: blur(16px);
                }

                .glass-nav {
                    background: rgba(4, 4, 4, 0.8);
                    backdrop-filter: blur(20px);
                    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
                }

                .btn-primary-dark {
                    background: #ffffff;
                    color: #000000;
                    font-weight: 700;
                    letter-spacing: 0.05em;
                    text-transform: uppercase;
                    transition: transform 0.3s ease, box-shadow 0.3s ease;
                }

                .btn-primary-dark:hover {
                    transform: scale(1.03);
                    box-shadow: 0 10px 40px rgba(255, 255, 255, 0.15);
                }

                .btn-secondary-dark {
                    background: transparent;
                    border: 1px solid rgba(255, 255, 255, 0.2);
                    color: rgba(255, 255, 255, 0.8);
                    transition: all 0.3s ease;
                }

                .btn-secondary-dark:hover {
                    background: rgba(255, 255, 255, 0.1);
                    border-color: rgba(255, 255, 255, 0.3);
                    color: #ffffff;
                }

                .card-hover {
                    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                        border-color 0.3s ease,
                        box-shadow 0.4s ease;
                }

                .card-hover:hover {
                    transform: translateY(-4px);
                    border-color: rgba(255, 255, 255, 0.15);
                }

                .feed-ad-card,
                .sidebar-ad-widget,
                .banner-ad-container,
                .inline-ad-container {
                    border: 1px solid rgba(0, 0, 0, 0.08);
                    border-radius: 24px;
                    background: #ffffff;
                    box-shadow: 0 18px 38px rgba(15, 23, 42, 0.06);
                    padding: 22px;
                    display: block;
                    width: 100%;
                }

                .feed-ad-card .feed-ad-label,
                .sidebar-ad-header .sidebar-ad-label,
                .banner-ad-label,
                .inline-ad-label {
                    display: inline-flex;
                    align-items: center;
                    padding: 6px 12px;
                    border-radius: 9999px;
                    font-size: 0.72rem;
                    letter-spacing: 0.08em;
                    font-weight: 700;
                    text-transform: uppercase;
                    color: #1d4ed8;
                    background: rgba(59, 130, 246, 0.08);
                    margin-bottom: 16px;
                }

                .feed-ad-content,
                .sidebar-ad-banner,
                .banner-ad-content,
                .inline-ad-content {
                    display: flex;
                    flex-direction: column;
                    gap: 16px;
                }

                .feed-ad-title,
                .feed-ad-description,
                .sidebar-ad-cta,
                .banner-ad-cta,
                .inline-ad-cta {
                    color: #111827;
                }

                .feed-ad-cta,
                .sidebar-ad-cta,
                .banner-ad-cta,
                .inline-ad-cta {
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    width: fit-content;
                    padding: 12px 20px;
                    border-radius: 9999px;
                    background-color: #1d4ed8;
                    color: #ffffff;
                    text-decoration: none;
                    font-weight: 700;
                    transition: opacity 0.2s ease;
                }

                .feed-ad-cta:hover,
                .sidebar-ad-cta:hover,
                .banner-ad-cta:hover,
                .inline-ad-cta:hover {
                    opacity: 0.88;
                }

                .feed-ad-image,
                .sidebar-ad-banner,
                .banner-ad-content svg,
                .inline-ad-content svg {
                    width: 100%;
                    border-radius: 18px;
                    overflow: hidden;
                }

                .inline-ad-container {
                    padding: 20px;
                }

                .banner-ad-container {
                    padding: 24px;
                }

                .sidebar-ad-widget {
                    padding: 16px;
                }

                .sidebar-ad-header {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 8px;
                    margin-bottom: 16px;
                }

                .sidebar-ad-banner {
                    min-height: 120px;
                }

                .banner-ad-label,
                .inline-ad-label {
                    margin-bottom: 16px;
                }

                .feed-ad-description {
                    color: #4b5563;
                    line-height: 1.6;
                }

                .feed-ad-title {
                    font-size: 1rem;
                    font-weight: 700;
                    margin: 0;
                }

                .sidebar-ad-cta,
                .banner-ad-cta,
                .inline-ad-cta {
                    margin-top: 0;
                }

                .feed-ad-card {
                    padding: 20px;
                }

                .sidebar-ad-widget {
                    background: #f8fafc;
                }

                .inline-ad-container {
                    background: #f8fafc;
                }

                .banner-ad-container {
                    background: #f8fafc;
                }

                .section-number {
                    font-family: 'Space Grotesk', sans-serif;
                    font-size: 12rem;
                    line-height: 1;
                    color: rgba(255, 255, 255, 0.03);
                    user-select: none;
                    pointer-events: none;
                }

                .nav-link-dark {
                    color: rgba(255, 255, 255, 0.5);
                    font-size: 0.75rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    letter-spacing: 0.15em;
                    transition: color 0.2s ease;
                }

                .nav-link-dark:hover,
                .nav-link-dark.active {
                    color: #ffffff;
                }

                .category-badge {
                    background: rgba(255, 255, 255, 0.08);
                    border: 1px solid rgba(255, 255, 255, 0.1);
                    font-size: 0.7rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                .line-clamp-2 {
                    display: -webkit-box;
                    -webkit-line-clamp: 2;
                    -webkit-box-orient: vertical;
                    overflow: hidden;
                }

                .line-clamp-3 {
                    display: -webkit-box;
                    -webkit-line-clamp: 3;
                    -webkit-box-orient: vertical;
                    overflow: hidden;
                }

                .fade-up {
                    animation: fadeUp 0.6s ease-out forwards;
                    opacity: 0;
                    transform: translateY(20px);
                }

                @keyframes fadeUp {
                    to {
                        opacity: 1;
                        transform: translateY(0);
                    }
                }

                .scrollbar-hide::-webkit-scrollbar {
                    display: none;
                }

                .scrollbar-hide {
                    -ms-overflow-style: none;
                    scrollbar-width: none;
                }

                .desktop-nav {
                    display: flex;
                }

                @media (max-width: 768px) {
                    .section-number {
                        font-size: 6rem;
                    }
                }

                .input-dark {
                    background: transparent;
                    border: none;
                    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
                    color: #ffffff;
                    padding: 12px 0;
                    font-size: 0.875rem;
                    transition: border-color 0.3s ease;
                }

                .input-dark:focus {
                    outline: none;
                    border-color: #ffffff;
                }

                .input-dark::placeholder {
                    color: rgba(255, 255, 255, 0.4);
                }

                .scroll-top-btn {
                    position: fixed;
                    bottom: 2rem;
                    right: 2rem;
                    width: 48px;
                    height: 48px;
                    border-radius: 50%;
                    background: <%=(typeof isLightTheme !=='undefined' && isLightTheme) ? 'rgba(255, 255, 255, 0.94)': 'rgba(255, 255, 255, 0.08)' %>;
                    border: 1px solid <%=(typeof isLightTheme !=='undefined' && isLightTheme) ? 'rgba(109, 10, 10, 0.14)': 'rgba(255, 255, 255, 0.15)' %>;
                    backdrop-filter: blur(16px);
                    color: <%=(typeof isLightTheme !=='undefined' && isLightTheme) ? '#6d0a0a': '#ffffff' %>;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    cursor: pointer;
                    opacity: 0;
                    pointer-events: none;
                    transform: translateY(20px);
                    transition: all 0.3s ease;
                    z-index: 100;
                    box-shadow: <%=(typeof isLightTheme !=='undefined' && isLightTheme) ? '0 18px 45px rgba(109, 10, 10, 0.12)': 'none' %>;
                }

                .scroll-top-btn.visible {
                    opacity: 1;
                    pointer-events: auto;
                    transform: translateY(0);
                }

                .scroll-top-btn:hover {
                    background: <%=(typeof isLightTheme !=='undefined' && isLightTheme) ? '#6d0a0a': 'rgba(255, 255, 255, 0.1)' %>;
                    border-color: <%=(typeof isLightTheme !=='undefined' && isLightTheme) ? '#6d0a0a': 'rgba(255, 255, 255, 0.2)' %>;
                    color: <%=(typeof isLightTheme !=='undefined' && isLightTheme) ? '#ffffff': '#ffffff' %>;
                }

                .tag-chip {
                    background: rgba(255, 255, 255, 0.05);
                    border: 1px solid rgba(255, 255, 255, 0.08);
                    color: rgba(255, 255, 255, 0.6);
                    font-size: 0.7rem;
                    text-transform: uppercase;
                    letter-spacing: 0.08em;
                    transition: all 0.2s ease;
                }

                .tag-chip:hover {
                    background: rgba(255, 255, 255, 0.1);
                    border-color: rgba(255, 255, 255, 0.15);
                    color: #ffffff;
                }
            </style>
            <%- include('../partials/nook-alert-css') %>
</head>

<body class="min-h-screen<%= typeof publisherMode !== 'undefined' && publisherMode ? ' publisher-mode' : '' %>">
    <!-- <div class="bg-noise"></div>
    <div class="bg-grid"></div>
    <div class="bg-blobs">
        <div class="blob-1"></div>
        <div class="blob-2"></div>
        <div class="blob-3"></div>
    </div> -->

    <% var catEnum=(typeof CATEGORY_ENUM !=='undefined' ) ? CATEGORY_ENUM : []; %>
        <% var globalCatNames=(typeof CATEGORY_NAMES !=='undefined' ) ? CATEGORY_NAMES : { en: {} }; %>
            <% var activeCatNames=(typeof categoryNames !=='undefined' ) ? categoryNames : (globalCatNames.en || {}); %>

                <%- include('../partials/header', { activeCategory: activeCategory, CATEGORY_ENUM: catEnum,
                    CATEGORY_NAMES: globalCatNames, categoryNames: activeCatNames }) %>

                    <script>var isLoggedIn = <%= typeof isLoggedIn !== 'undefined' && isLoggedIn ? 'true' : 'false' %>; var hapticEnabled = <%= (typeof user !== 'undefined' && user && user.preferences?.hapticFeedback !== false) ? 'true' : 'false' %>;</script>

                    <main class="flex-1">
                        <%- body %>
                    </main>

                    <% if (typeof hideFooter==='undefined' || !hideFooter) { %>
                        <%- include('../partials/footer', { CATEGORY_ENUM: catEnum, CATEGORY_NAMES: globalCatNames,
                            categoryNames: activeCatNames }) %>
                            <% } %>

                                <%- include('../partials/scripts') %>

                                    <%- include('../partials/mobile-bottom-nav', { currentPage: typeof currentPage
                                        !=='undefined' ? currentPage : '' , theme: (typeof isLightTheme !=='undefined'
                                        && isLightTheme) ? 'light' : 'dark' }) %>

                                        <button class="scroll-top-btn" id="scrollTopBtn" type="button"
                                            aria-label="Scroll to top">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <path d="m18 15-6-6-6 6" />
                                            </svg>
                                        </button>

                                        <script>
                                            document.addEventListener('DOMContentLoaded', function () {
                                                const scrollBtn = document.getElementById('scrollTopBtn');

                                                if (scrollBtn) {
                                                    scrollBtn.addEventListener('click', function () {
                                                        window.scrollTo({ top: 0, behavior: 'smooth' });
                                                    });
                                                }

                                                window.addEventListener('scroll', function () {
                                                    if (scrollBtn) {
                                                        if (window.scrollY > 300) {
                                                            scrollBtn.classList.add('visible');
                                                        } else {
                                                            scrollBtn.classList.remove('visible');
                                                        }
                                                    }
                                                });

                                                const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
                                                const observer = new IntersectionObserver((entries) => {
                                                    entries.forEach(entry => {
                                                        if (entry.isIntersecting) {
                                                            entry.target.style.opacity = '1';
                                                            entry.target.style.transform = 'translateY(0)';
                                                        }
                                                    });
                                                }, observerOptions);

                                                document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
                                            });
                                        </script>

                                        <script>
                                            if ('serviceWorker' in navigator) {
                                                (async function () {
                                                    try {
                                                        const registration = await navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' });

                                                        function showUpdateBanner(reg) {
                                                            var existing = document.getElementById('pwa-update-banner');
                                                            if (existing) return;

                                                            var banner = document.createElement('div');
                                                            banner.id = 'pwa-update-banner';
                                                            banner.style.cssText =
                                                                'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:9999;background:#1a1a1a;color:#fff;padding:14px 24px;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.4);display:flex;align-items:center;gap:16px;font-family:Inter,sans-serif;font-size:0.85rem;border:1px solid rgba(255,255,255,0.08);';

                                                            var msg = document.createElement('span');
                                                            msg.textContent = 'A new version is available.';
                                                            banner.appendChild(msg);

                                                            var btn = document.createElement('button');
                                                            btn.textContent = 'Refresh';
                                                            btn.style.cssText =
                                                                'background:#fff;color:#000;border:none;padding:8px 20px;border-radius:8px;font-weight:700;font-size:0.8rem;cursor:pointer;text-transform:uppercase;letter-spacing:0.05em;';
                                                            btn.addEventListener('click', function () {
                                                                if (reg.waiting) {
                                                                    reg.waiting.postMessage({ action: 'SKIP_WAITING' });
                                                                }
                                                            });
                                                            banner.appendChild(btn);
                                                            document.body.appendChild(banner);
                                                        }

                                                        if (registration.waiting) {
                                                            showUpdateBanner(registration);
                                                        }

                                                        registration.addEventListener('updatefound', function () {
                                                            var newWorker = registration.installing;
                                                            newWorker.addEventListener('statechange', function () {
                                                                if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                                                                    showUpdateBanner(registration);
                                                                }
                                                            });
                                                        });

                                                        navigator.serviceWorker.addEventListener('controllerchange', function () {
                                                            window.location.reload();
                                                        });
                                                    } catch (e) {
                                                        console.warn('SW registration failed:', e);
                                                    }
                                                })();
                                            }

                                            if ('Notification' in window && 'PushManager' in window && typeof isLoggedIn !== 'undefined' && isLoggedIn) {
                                                (async function () {
                                                    if (Notification.permission === 'granted') {
                                                        try {
                                                            var reg = await navigator.serviceWorker.ready;
                                                            var sub = await reg.pushManager.getSubscription();
                                                            if (!sub) {
                                                                var keyRes = await fetch('/api/push/vapid-public-key');
                                                                var keyData = await keyRes.json();
                                                                var subData = await reg.pushManager.subscribe({
                                                                    userVisibleOnly: true,
                                                                    applicationServerKey: urlB64ToUint8Array(keyData.publicKey)
                                                                });
                                                                await fetch('/api/push/subscribe', {
                                                                    method: 'POST',
                                                                    headers: { 'Content-Type': 'application/json' },
                                                                    body: JSON.stringify({
                                                                        endpoint: subData.endpoint,
                                                                        keys: { p256dh: arrayBufferToBase64(subData.getKey('p256dh')), auth: arrayBufferToBase64(subData.getKey('auth')) },
                                                                        userAgent: navigator.userAgent
                                                                    })
                                                                });
                                                            }
                                                        } catch (e) {
                                                            console.warn('Push subscription failed:', e);
                                                        }
                                                    } else if (Notification.permission !== 'denied') {
                                                        await Notification.requestPermission();
                                                    }
                                                })();
                                            }

                                            function urlB64ToUint8Array(base64String) {
                                                var padding = '='.repeat((4 - base64String.length % 4) % 4);
                                                var base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
                                                var rawData = window.atob(base64);
                                                var output = new Uint8Array(rawData.length);
                                                for (var i = 0; i < rawData.length; i++) {
                                                    output[i] = rawData.charCodeAt(i);
                                                }
                                                return output;
                                            }

                                            function arrayBufferToBase64(buffer) {
                                                var binary = '';
                                                var bytes = new Uint8Array(buffer);
                                                for (var i = 0; i < bytes.byteLength; i++) {
                                                    binary += String.fromCharCode(bytes[i]);
                                                }
                                                return btoa(binary);
                                            }
                                        </script>
