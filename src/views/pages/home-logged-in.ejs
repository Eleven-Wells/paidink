<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'PaidInk - Home' %></title>
    <meta name="description" content="<%= description || 'Your PaidInk home feed.' %>">
    <meta name="theme-color" content="#6d0a0a">
    <link rel="manifest" href="/manifest.json">
    <link rel="prefetch" href="/browse">
    <link rel="prefetch" href="/activity">
    <link rel="prefetch" href="/dashboard">
    <link rel="prefetch" href="/profile">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Abhaya+Libre:wght@400;500;600;700;800&family=Zen+Tokyo+Zoo&display=swap" rel="stylesheet">
    <%- include('../partials/nook-alert-css') %>
    <style>
        * { box-sizing: border-box; }

        html, body { max-width: 100%; overflow-x: hidden; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #fff;
            color: #1f1715;
            --home-nav-width: clamp(220px, 22vw, 300px);
            --home-shell-max: 1800px;
            --home-content-padding: clamp(16px, 2vw, 28px);
            --home-sidebar-width: clamp(280px, 27vw, 360px);
            --home-bottom-space: calc(104px + env(safe-area-inset-bottom));
        }

        #mainNav, #mobileMenu, #mobileOverlay { display: none; }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .home-nav-column {
            position: fixed;
            top: var(--util-bar-height, 48px);
            left: 0;
            width: var(--home-nav-width);
            height: calc(100dvh - var(--util-bar-height, 48px));
            overflow-y: auto;
            z-index: 100;
            background: #fff;
        }

        .home-nav-column .home-side-nav {
            position: static;
            height: 100%;
        }

        .home-container {
            margin-left: var(--home-nav-width);
            width: calc(100% - var(--home-nav-width));
            min-height: 100dvh;
            padding-top: var(--util-bar-height, 48px);
        }

        .home-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) var(--home-sidebar-width);
            gap: clamp(20px, 2vw, 32px);
            align-items: start;
            width: min(100%, var(--home-shell-max));
            margin: 0 auto;
            padding: clamp(14px, 2vw, 22px) var(--home-content-padding) 32px;
        }

        .home-main-column {
            min-width: 0;
        }

        .home-search {
            width: 100%;
            padding: 0 0 clamp(14px, 2vw, 18px);
        }

        .home-search form { width: 100%; }

        .home-search-shell {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            min-height: clamp(48px, 7vw, 58px);
            padding: 8px 10px 8px 16px;
            border-radius: 999px;
            border: 1px solid rgba(109, 10, 10, 0.14);
            background: linear-gradient(180deg, #fff, #fffaf7);
            box-shadow: 0 16px 36px rgba(109, 10, 10, 0.06);
        }

        .home-search-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            flex: 0 0 36px;
            border-radius: 50%;
            background: rgba(109, 10, 10, 0.06);
            color: #6d0a0a;
        }

        .home-search input {
            width: 100%;
            min-width: 0;
            border: 0;
            outline: 0;
            background: transparent;
            font: inherit;
            font-size: 16px;
            color: #1f1715;
        }

        .home-search-scope {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 36px;
            padding: 0 14px;
            border-radius: 999px;
            background: rgba(109, 10, 10, 0.08);
            color: #6d0a0a;
            font-family: 'Abhaya Libre', serif;
            font-size: 17px;
            font-weight: 600;
            white-space: nowrap;
        }

        .home-composer-slot {
            width: 100%;
            padding-bottom: clamp(18px, 2vw, 26px);
        }

        .home-feed {
            width: 100%;
            min-width: 0;
            padding-bottom: 24px;
        }

        .home-sidebar {
            display: flex;
            flex-direction: column;
            gap: 24px;
            min-width: 0;
            position: fixed;
            top: calc(var(--util-bar-height, 48px) + clamp(12px, 1.5vw, 18px));
            right: var(--home-content-padding);
            width: var(--home-sidebar-width);
            height: calc(100dvh - var(--util-bar-height, 48px) - 32px);
            max-height: calc(100dvh - var(--util-bar-height, 48px) - 32px);
            overflow-y: auto;
            scrollbar-width: none;
            padding-bottom: clamp(18px, 2vw, 26px);
        }

        .home-sidebar::-webkit-scrollbar { display: none; }

        .home-suggestions-stack {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .home-sidebar-ad { width: 100%; }

        .home-composer-overlay, .home-composer-drawer, .home-composer-fab { display: none; }

        .install-banner {
            position: fixed;
            bottom: 80px;
            left: 0;
            right: 0;
            background: linear-gradient(135deg, #6d0a0a 0%, #4b0808 100%);
            color: #fdf6f0;
            padding: 16px;
            z-index: 9999;
            box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.15);
        }

        .install-banner-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .install-banner-actions {
            display: flex;
            gap: 8px;
            margin-left: auto;
        }

        .install-btn {
            background: #fdf6f0;
            color: #6d0a0a;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
        }

        .dismiss-btn {
            background: transparent;
            border: 1px solid #fdf6f0;
            color: #fdf6f0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 18px;
        }

        @media (max-width: 1400px) {
            body { --home-nav-width: 260px; }
        }

        @media (max-width: 1100px) {
            .home-layout {
                grid-template-columns: minmax(0, 1fr);
            }

            .home-sidebar {
                display: none;
            }
        }

        @media (max-width: 1024px) {
            body {
                --home-nav-width: 0px;
                --home-content-padding: 16px;
                padding-bottom: var(--home-bottom-space);
            }

            .home-nav-column, .home-container::before { display: none; }

            .home-container {
                margin-left: 0;
                width: 100%;
                padding-top: 0;
            }

            .home-layout {
                padding: 12px 16px 24px;
            }

            .home-search-scope {
                display: none;
            }

            .home-composer-slot {
                display: none;
            }

            .home-composer-overlay, .home-composer-drawer, .home-composer-fab { display: block; }

            .home-composer-fab {
                position: fixed;
                right: 20px;
                bottom: calc(110px + env(safe-area-inset-bottom));
                z-index: 10005;
                width: 56px;
                height: 56px;
                border: none;
                border-radius: 50%;
                background: #6d0a0a;
                color: #fff;
                cursor: pointer;
                align-items: center;
                justify-content: center;
                box-shadow: 0 8px 24px rgba(109, 10, 10, 0.35), 0 2px 8px rgba(109, 10, 10, 0.18);
                touch-action: manipulation;
            }

            .home-composer-fab.is-open { transform: rotate(45deg); background: #4b0808; }

            .home-composer-overlay {
                position: fixed;
                inset: 0;
                z-index: 10000;
                background: rgba(0, 0, 0, 0.4);
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.25s ease;
            }

            .home-composer-overlay.is-visible {
                opacity: 1;
                pointer-events: auto;
            }

            .home-composer-drawer {
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 10010;
                background: #fff;
                border-radius: 20px 20px 0 0;
                box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.12);
                transform: translateY(100%);
                transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
                max-height: 85vh;
                overflow-y: auto;
                padding: 20px 16px max(20px, env(safe-area-inset-bottom));
            }

            .home-composer-drawer.is-visible { transform: translateY(0); }

            .home-composer-drawer__handle {
                width: 36px;
                height: 4px;
                border-radius: 999px;
                background: rgba(0, 0, 0, 0.12);
                margin: 0 auto 16px;
            }

            .home-composer-drawer .home-composer > form {
                border: none;
                box-shadow: none;
                padding: 0;
                background: transparent;
            }

            .home-composer-drawer .home-composer textarea {
                font-size: 20px;
                min-height: 80px;
            }

            .home-composer-drawer .composer-avatar {
                width: 40px;
                height: 40px;
                flex-basis: 40px;
                font-size: 20px;
            }

            .home-composer-drawer .composer-count {
                display: none;
            }

            .home-sidebar {
                display: none !important;
            }
        }

        @media (max-width: 640px) {
            .home-layout {
                padding: 10px 14px 22px;
            }

            .home-search-shell {
                min-height: 44px;
                padding-left: 12px;
            }

            .home-search-icon {
                width: 32px;
                height: 32px;
                flex-basis: 32px;
            }

            .home-composer-fab {
                width: 52px;
                height: 52px;
                right: 16px;
                bottom: calc(106px + env(safe-area-inset-bottom));
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/app-utility-bar', { pageTitle: 'Home', unreadCount: unreadCount, user: user }) %>
    <style>
        .app-utility-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 10020;
        }
    </style>

    <aside class="home-nav-column" aria-label="Main navigation">
        <%- include('../partials/home-side-nav', { unreadCount: unreadCount }) %>
    </aside>

    <div class="home-container">
        <div class="home-layout">
            <main class="home-main-column">
                <section class="home-search" aria-label="Search">
                    <form action="/search" method="GET" role="search">
                        <label for="search-input" class="sr-only">Search</label>
                        <div class="home-search-shell">
                            <span class="home-search-icon" aria-hidden="true">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8" />
                                    <path d="m21 21-4.35-4.35" />
                                </svg>
                            </span>
                            <input id="search-input" name="q" type="search" placeholder="Search PaidInk" aria-label="Search PaidInk" />
                            <span class="home-search-scope" aria-hidden="true">Posts</span>
                        </div>
                        <div id="search-results" class="hidden"></div>
                    </form>
                </section>

                <section class="home-composer-slot" aria-label="Create a post">
                    <%- include('../partials/home-post-composer') %>
                </section>

                <section class="home-feed" aria-label="Home feed">
                    <%- include('../partials/home-activity-feed', { posts: posts, feedSuggestions: feedSuggestions, feedAds: feedAds, user: user }) %>
                </section>
            </main>

            <aside class="home-sidebar" aria-label="Suggestions">
                <div class="home-suggestions-stack">
                    <%- include('../partials/home-trending', { trendingPosts: trendingPosts }) %>
                    <%- include('../partials/home-who-to-follow', { suggestedUsers: suggestedUsers }) %>
                </div>
                <% if (typeof sidebarAd !== 'undefined' && sidebarAd) { %>
                    <div class="home-sidebar-ad">
                        <%- include('../partials/ad-sidebar', { ad: sidebarAd }) %>
                    </div>
                <% } %>
            </aside>
        </div>
    </div>

    <div id="installPrompt" class="install-banner" style="display: none;">
        <div class="install-banner-content">
            <div>
                <strong>Install PaidInk</strong>
                <p>Add PaidInk to your home screen for quick access</p>
            </div>
            <div class="install-banner-actions">
                <button id="installBtn" class="install-btn">Install</button>
                <button id="dismissBtn" class="dismiss-btn">✕</button>
            </div>
        </div>
    </div>

    <button class="home-composer-fab" id="composerFab" aria-label="Create a post" type="button">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
        </svg>
    </button>

    <div class="home-composer-overlay" id="composerOverlay"></div>
    <aside class="home-composer-drawer" id="composerDrawer" role="dialog" aria-modal="true" aria-label="Create a post">
        <div class="home-composer-drawer__handle"></div>
        <%- include('../partials/home-post-composer') %>
    </aside>

    <%- include('../partials/mobile-bottom-nav', { currentPage: 'home', unreadCount: unreadCount }) %>
    <%- include('../partials/nook-alert') %>
    <script defer src="/public/js/nook-alert.js"></script>
    <script defer src="/public/js/post-actions.js"></script>
    <script defer src="/public/js/search.js"></script>
    <script>
        (function () {
            var fab = document.getElementById('composerFab');
            var drawer = document.getElementById('composerDrawer');
            var overlay = document.getElementById('composerOverlay');
            if (!fab || !drawer || !overlay) return;

            function openDrawer() {
                drawer.classList.add('is-visible');
                overlay.classList.add('is-visible');
                fab.classList.add('is-open');
                document.body.style.overflow = 'hidden';
                window.setTimeout(function () {
                    var textarea = drawer.querySelector('#post-composer');
                    if (textarea) textarea.focus();
                }, 320);
            }

            function closeDrawer() {
                drawer.classList.remove('is-visible');
                overlay.classList.remove('is-visible');
                fab.classList.remove('is-open');
                document.body.style.overflow = '';
            }

            fab.addEventListener('click', function () {
                if (drawer.classList.contains('is-visible')) {
                    closeDrawer();
                } else {
                    openDrawer();
                }
            });

            overlay.addEventListener('click', closeDrawer);

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && drawer.classList.contains('is-visible')) {
                    closeDrawer();
                }
            });
        })();
    </script>

    <script>
        let deferredPrompt;
        const installPrompt = document.getElementById('installPrompt');
        const installBtn = document.getElementById('installBtn');
        const dismissBtn = document.getElementById('dismissBtn');

        if (installPrompt && installBtn && dismissBtn) {
            window.addEventListener('beforeinstallprompt', (event) => {
                event.preventDefault();
                deferredPrompt = event;
                installPrompt.style.display = 'block';
            });

            installBtn.addEventListener('click', async () => {
                if (deferredPrompt) {
                    deferredPrompt.prompt();
                    const { outcome } = await deferredPrompt.userChoice;
                    console.log(`User response to the install prompt: ${outcome}`);
                    installPrompt.style.display = 'none';
                    deferredPrompt = null;
                }
            });

            dismissBtn.addEventListener('click', () => {
                installPrompt.style.display = 'none';
            });

            window.addEventListener('appinstalled', () => {
                installPrompt.style.display = 'none';
            });
        }
    </script>
</body>

</html>
