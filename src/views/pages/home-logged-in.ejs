</div>

    <button class="home-composer-fab" id="composerFab" aria-label="Create a post" type="button">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
        </svg>
    </button>

    <div class="home-composer-overlay" id="composerOverlay"></div>
    <aside class="home-composer-drawer" id="composerDrawer" role="dialog" aria-modal="true" aria-label="Create a post">
        <div class="home-composer-drawer__handle"></div>
        <%- include('../partials/home-post-composer') %>
    </aside>

    <%- include('../partials/mobile-bottom-nav', { currentPage: 'home', unreadCount: unreadCount }) %>
    <%- include('../partials/nook-alert') %>
    <script defer src="/public/js/nook-alert.js"></script>
    <script defer src="/public/js/post-actions.js"></script>
    <script defer src="/public/js/search.js"></script>
    <script>
        (function () {
            var fab = document.getElementById('composerFab');
            var drawer = document.getElementById('composerDrawer');
            var overlay = document.getElementById('composerOverlay');
            if (!fab || !drawer || !overlay) return;

            function openDrawer() {
                drawer.classList.add('is-visible');
                overlay.classList.add('is-visible');
                fab.classList.add('is-open');
                document.body.style.overflow = 'hidden';
                window.setTimeout(function () {
                    var textarea = drawer.querySelector('#post-composer');
                    if (textarea) textarea.focus();
                }, 320);
            }

            function closeDrawer() {
                drawer.classList.remove('is-visible');
                overlay.classList.remove('is-visible');
                fab.classList.remove('is-open');
                document.body.style.overflow = '';
            }

            fab.addEventListener('click', function () {
                if (drawer.classList.contains('is-visible')) {
                    closeDrawer();
                } else {
                    openDrawer();
                }
            });

            overlay.addEventListener('click', closeDrawer);

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && drawer.classList.contains('is-visible')) {
                    closeDrawer();
                }
            });
        })();
    </script>

    <script>
        let deferredPrompt;
        const installPrompt = document.getElementById('installPrompt');
        const installBtn = document.getElementById('installBtn');
        const dismissBtn = document.getElementById('dismissBtn');

        if (installPrompt && installBtn && dismissBtn) {
            window.addEventListener('beforeinstallprompt', (event) => {
                event.preventDefault();
                deferredPrompt = event;
                installPrompt.style.display = 'block';
            });

            installBtn.addEventListener('click', async () => {
                if (deferredPrompt) {
                    deferredPrompt.prompt();
                    const { outcome } = await deferredPrompt.userChoice;
                    console.log(`User response to the install prompt: ${outcome}`);
                    installPrompt.style.display = 'none';
                    deferredPrompt = null;
                }
            });

            dismissBtn.addEventListener('click', () => {
                installPrompt.style.display = 'none';
            });

            window.addEventListener('appinstalled', () => {
                installPrompt.style.display = 'none';
            });
        }
    </script>

    <script>
        (function () {
            function escapeHtml(value) {
                return String(value == null ? '' : value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function avatarMarkup(user, size) {
                var fallback = 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80"><circle cx="40" cy="40" r="40" fill="#e5e5e5"/><text x="40" y="52" text-anchor="middle" fill="#6d0a0a" font-size="36" font-family="sans-serif">?</text></svg>');
                var src = (user && user.avatar) ? escapeHtml(user.avatar) : fallback;
                var alt = (user && user.displayName) ? escapeHtml(user.displayName) : 'User';
                return '<img src="' + src + '" alt="' + alt + ' profile" loading="lazy" decoding="async" style="width:' + (size || '55px') + ';height:' + (size || '55px') + ';object-fit:cover;border-radius:50%;flex-shrink:0;" />';
            }

            function buildTrendingHtml(post) {
                var author = post.author || null;
                var title = escapeHtml(post.title || 'Untitled');
                var slug = escapeHtml(post.slug || '#');
                var authorName = author ? escapeHtml(author.displayName) : 'Anonymous';
                var readTime = escapeHtml(post.readTime || '< 1 min read');
                var likes = post.likes ? post.likes.length : 0;
                return [
                    '<article class="trending-post">',
                    '<div class="trending-post-info">',
                    avatarMarkup(author, '55px'),
                    '<div>',
                    '<p class="trending-label">Up next</p>',
                    '<p class="trending-author">' + authorName + '</p>',
                    '<p class="trending-title">' + title + '</p>',
                    '<p class="trending-meta">' + readTime + ' · ' + likes + ' likes</p>',
                    '</div>',
                    '</div>',
                    '<div class="trending-actions">',
                    '<a href="/post/' + slug + '" class="sidebar-secondary-cta">Read</a>',
                    '<button type="button" aria-label="Save article" class="trending-save-btn">',
                    '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>',
                    '</button>',
                    '</div>',
                    '</article>'
                ].join('');
            }

            function buildSidebarAdHtml(ad) {
                var image = ad.imageUrl
                    ? '<img src="' + escapeHtml(ad.imageUrl) + '" alt="Sponsored content" loading="lazy" decoding="async" />'
                    : '<svg width="100%" height="120" viewBox="0 0 300 120" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="300" height="120" fill="#2563eb" fill-opacity="0.05"/><text x="150" y="60" text-anchor="middle" dominant-baseline="middle" fill="#2563eb" font-size="14" font-family="system-ui">Advertisement</text><text x="150" y="80" text-anchor="middle" dominant-baseline="middle" fill="#6b7280" font-size="11" font-family="system-ui">300 x 120</text></svg>';
                return [
                    '<div class="sidebar-ad-widget">',
                    '<div class="sidebar-ad-header">',
                    '<span class="sidebar-ad-label">Sponsored</span>',
                    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
                    '</div>',
                    '<div class="sidebar-ad-banner">' + image + '</div>',
                    '<a href="' + escapeHtml(ad.clickUrl || '#') + '" class="sidebar-ad-cta" target="_blank" rel="sponsored noopener">Learn More</a>',
                    '</div>'
                ].join('');
            }

            function hydrateTrending() {
                var container = document.getElementById('trending-container');
                if (!container) return;
                fetch('/api/v1/feed/trending', { credentials: 'same-origin' })
                    .then(function (res) {
                        if (!res.ok) throw new Error('trending fetch failed');
                        return res.json();
                    })
                    .then(function (json) {
                        var posts = json && json.success && Array.isArray(json.data) ? json.data : [];
                        var inner = container.querySelector('.home-trending-inner');
                        var list = inner ? inner.querySelector('.trending-list') : null;
                        if (!list) return;
                        if (posts.length === 0) {
                            list.innerHTML = '<p class="sidebar-section-copy">Popular posts will appear here once readers start moving through the feed.</p>';
                            return;
                        }
                        var html = '';
                        posts.forEach(function (post, index) {
                            html += buildTrendingHtml(post);
                            if (index < posts.length - 1) {
                                html += '<hr class="trending-divider" />';
                            }
                        });
                        list.innerHTML = html;
                    })
                    .catch(function (err) {
                        var list = container.querySelector('.trending-list');
                        if (list) {
                            list.innerHTML = '<p class="sidebar-section-copy">Trending reads are temporarily unavailable.</p>';
                        }
                    });
            }

            function hydrateAds() {
                var slot = document.getElementById('sidebar-ad-slot');
                fetch('/api/v1/feed/ads', { credentials: 'same-origin' })
                    .then(function (res) {
                        if (!res.ok) throw new Error('ads fetch failed');
                        return res.json();
                    })
                    .then(function (json) {
                        if (!slot) return;
                        var ad = json && json.success && json.sidebarAd ? json.sidebarAd : null;
                        if (ad) {
                            slot.innerHTML = buildSidebarAdHtml(ad);
                        } else {
                            slot.innerHTML = '';
                        }
                    })
                    .catch(function () {
                        if (slot) slot.innerHTML = '';
                    });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function () {
                    hydrateTrending();
                    hydrateAds();
                });
            } else {
                hydrateTrending();
                hydrateAds();
            }
        })();
    </script>
</body>

</html>
