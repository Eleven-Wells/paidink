<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'PaidInk - Home' %></title>
    <meta name="description" content="<%= description || 'Your PaidInk home feed.' %>">
    <meta name="theme-color" content="#6d0a0a">
    <link rel="manifest" href="/manifest.json">
    <link rel="prefetch" href="/browse">
    <link rel="prefetch" href="/activity">
    <link rel="prefetch" href="/dashboard">
    <link rel="prefetch" href="/profile">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Abhaya+Libre:wght@400;500;600;700;800&family=Zen+Tokyo+Zoo&display=swap" rel="stylesheet">
    <%- include('../partials/nook-alert-css') %>
    <style>
        * { box-sizing: border-box; }

        html, body { max-width: 100%; overflow-x: hidden; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #fff;
            color: #1f1715;
            --home-nav-width: clamp(220px, 22vw, 300px);
            --home-shell-max: 1800px;
            --home-content-padding: clamp(16px, 2vw, 28px);
            --home-sidebar-width: clamp(280px, 27vw, 360px);
            --home-bottom-space: calc(104px + env(safe-area-inset-bottom));
        }

        #mainNav, #mobileMenu, #mobileOverlay { display: none; }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .home-nav-column {
            position: fixed;
            top: var(--util-bar-height, 48px);
            left: 0;
            width: var(--home-nav-width);
            height: calc(100dvh - var(--util-bar-height, 48px));
            overflow-y: auto;
            z-index: 100;
            background: #fff;
        }

        .home-nav-column::-webkit-scrollbar { display: none; }
        .home-nav-column { scrollbar-width: none; }

        .home-nav-column .home-side-nav {
            position: static;
            height: 100%;
        }

        .home-container {
            margin-left: var(--home-nav-width);
            width: calc(100% - var(--home-nav-width));
            min-height: 100dvh;
            padding-top: var(--util-bar-height, 48px);
        }

        .home-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) var(--home-sidebar-width);
            gap: clamp(20px, 2vw, 32px);
            align-items: start;
            width: min(100%, var(--home-shell-max));
            margin: 0 auto;
            padding: clamp(14px, 2vw, 22px) var(--home-content-padding) 32px;
        }

        .home-main-column {
            min-width: 0;
        }

        .home-search {
            width: 100%;
            padding: 0 0 clamp(14px, 2vw, 18px);
        }

        .home-search form { width: 100%; }

        .home-search-shell {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            min-height: clamp(48px, 7vw, 58px);
            padding: 8px 10px 8px 16px;
            border-radius: 999px;
            border: 1px solid rgba(109, 10, 10, 0.14);
            background: linear-gradient(180deg, #fff, #fffaf7);
            box-shadow: 0 16px 36px rgba(109, 10, 10, 0.06);
        }

        .home-search-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            flex: 0 0 36px;
            border-radius: 50%;
            background: rgba(109, 10, 10, 0.06);
            color: #6d0a0a;
        }

        .home-search input {
            width: 100%;
            min-width: 0;
            border: 0;
            outline: 0;
            background: transparent;
            font: inherit;
            font-size: 16px;
            color: #1f1715;
        }

        .home-search-scope {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 36px;
            padding: 0 14px;
            border-radius: 999px;
            background: rgba(109, 10, 10, 0.08);
            color: #6d0a0a;
            font-family: 'Abhaya Libre', serif;
            font-size: 17px;
            font-weight: 600;
            white-space: nowrap;
        }

        .home-composer-slot {
            width: 100%;
            padding-bottom: clamp(18px, 2vw, 26px);
        }

        .home-feed {
            width: 100%;
            min-width: 0;
            padding-bottom: 24px;
        }

        .home-sidebar {
            display: flex;
            flex-direction: column;
            gap: 24px;
            min-width: 0;
            position: fixed;
            top: calc(var(--util-bar-height, 48px) + clamp(12px, 1.5vw, 18px));
            right: var(--home-content-padding);
            width: var(--home-sidebar-width);
            height: calc(100dvh - var(--util-bar-height, 48px) - 32px);
            max-height: calc(100dvh - var(--util-bar-height, 48px) - 32px);
            overflow-y: auto;
            scrollbar-width: none;
            padding-bottom: clamp(18px, 2vw, 26px);
        }

        .home-sidebar::-webkit-scrollbar { display: none; }

        .home-suggestions-stack {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .home-sidebar-ad { width: 100%; }

        .home-sidebar-ad-slot { margin-top: 24px; }

        .home-trending-slot .home-trending-inner {
            padding: 24px;
            width: 100%;
            border: 1px solid rgba(0, 0, 0, 0.15);
            border-radius: 24px;
        }

        .home-trending-slot .sidebar-section-head {
            margin-bottom: 24px;
        }

        .home-trending-slot .sidebar-section-kicker {
            margin: 0 0 7px;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #6d0a0a;
        }

        .home-trending-slot h2 {
            margin: 0;
            font-family: 'Abhaya Libre', serif;
            font-weight: 600;
            font-size: 32px;
            color: #000;
            line-height: 1;
        }

        .home-trending-slot .sidebar-section-copy {
            margin: 10px 0 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            font-size: 13px;
            line-height: 1.45;
            color: rgba(0, 0, 0, 0.62);
        }

        .home-trending-slot .sidebar-primary-cta {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            border-radius: 999px;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            font-weight: 800;
            width: 100%;
            margin-top: 24px;
            padding: 13px 16px;
            background: #6d0a0a;
            color: #fff;
            font-size: 13px;
        }

        .trending-list {
            display: flex;
            flex-direction: column;
            gap: 24px;
            width: 100%;
        }

        .trending-skeleton-row {
            display: flex;
            align-items: center;
            gap: 16px;
            width: 100%;
        }

        .skeleton {
            background: linear-gradient(90deg, rgba(109, 10, 10, 0.06) 25%, rgba(109, 10, 10, 0.12) 37%, rgba(109, 10, 10, 0.06) 63%);
            background-size: 400% 100%;
            animation: skeleton-shimmer 1.4s ease infinite;
            border-radius: 999px;
        }

        .skeleton-avatar {
            width: 55px;
            height: 55px;
            flex-shrink: 0;
            border-radius: 50%;
        }

        .skeleton-line {
            height: 14px;
            width: 100%;
            max-width: 220px;
        }

        .sidebar-ad-skeleton {
            padding: 24px;
            border: 1px solid rgba(0, 0, 0, 0.15);
            border-radius: 24px;
        }

        .skeleton-ad-block {
            height: 120px;
            width: 100%;
            border-radius: 12px;
        }

        @keyframes skeleton-shimmer {
            0% { background-position: 100% 0; }
            100% { background-position: 0 0; }
        }

        @media (max-width: 1024px) {
            .home-trending-slot,
            .home-sidebar-ad-slot {
                display: none;
            }
        }

        .home-composer-overlay, .home-composer-drawer, .home-composer-fab { display: none; }

        /* Sleek Minimalist Install Banner */
.install-banner {
    position: fixed;
    bottom: calc(80px + env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    width: min(calc(100% - 32px), 440px);
    background: rgba(109, 10, 10, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #fff;
    padding: 12px 16px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25), 0 4px 12px rgba(109, 10, 10, 0.2);
    z-index: 9999;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
}

.install-banner-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.install-banner-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.install-banner-info strong {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
    line-height: 1.2;
}

.install-banner-info p {
    margin: 2px 0 0;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.75);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.install-banner-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

.install-btn {
    background: #fff;
    color: #6d0a0a;
    border: none;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
}

.install-btn:active {
    transform: scale(0.96);
    background: rgba(255, 255, 255, 0.9);
}

.dismiss-btn {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    line-height: 1;
    transition: color 0.2s ease, background-color 0.2s ease;
}

.dismiss-btn:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
}

        @media (max-width: 1400px) {
            body { --home-nav-width: 260px; }
        }

        @media (max-width: 1100px) {
            .home-layout {
                grid-template-columns: minmax(0, 1fr);
            }

            .home-sidebar {
                display: none;
            }
        }

        @media (max-width: 1024px) {
            body {
                --home-nav-width: 0px;
                --home-content-padding: 16px;
                padding-bottom: var(--home-bottom-space);
            }

            .home-nav-column, .home-container::before { display: none; }

            .home-container {
                margin-left: 0;
                width: 100%;
                padding-top: var(--util-bar-height, 48px);
            }

            .home-layout {
                padding: 12px 16px 24px;
            }

            .home-search-scope {
                display: none;
            }

            .home-composer-slot {
                display: none;
            }

            .home-composer-overlay, .home-composer-drawer, .home-composer-fab { display: block; }

            .home-composer-fab {
                position: fixed;
                right: 20px;
                bottom: calc(110px + env(safe-area-inset-bottom));
                z-index: 10005;
                width: 56px;
                height: 56px;
                border: none;
                border-radius: 50%;
                background: #6d0a0a;
                color: #fff;
                cursor: pointer;
                align-items: center;
                justify-content: center;
                box-shadow: 0 8px 24px rgba(109, 10, 10, 0.35), 0 2px 8px rgba(109, 10, 10, 0.18);
                touch-action: manipulation;
            }

            .home-composer-fab.is-open { transform: rotate(45deg); background: #4b0808; }

            .home-composer-overlay {
                position: fixed;
                inset: 0;
                z-index: 10000;
                background: rgba(0, 0, 0, 0.4);
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.25s ease;
            }

            .home-composer-overlay.is-visible {
                opacity: 1;
                pointer-events: auto;
            }

            .home-composer-drawer {
                position: fixed;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 10010;
                background: #fff;
                border-radius: 20px 20px 0 0;
                box-shadow: 0 -8px 40px rgba(0, 0, 0, 0.12);
                transform: translateY(100%);
                transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
                max-height: 85vh;
                overflow-y: auto;
                padding: 20px 16px max(20px, env(safe-area-inset-bottom));
            }

            .home-composer-drawer.is-visible { transform: translateY(0); }

            .home-composer-drawer__handle {
                width: 36px;
                height: 4px;
                border-radius: 999px;
                background: rgba(0, 0, 0, 0.12);
                margin: 0 auto 16px;
            }

            .home-composer-drawer .home-composer > form {
                border: none;
                box-shadow: none;
                padding: 0;
                background: transparent;
            }

            .home-composer-drawer .home-composer textarea {
                font-size: 20px;
                min-height: 80px;
            }

            .home-composer-drawer .composer-avatar {
                width: 40px;
                height: 40px;
                flex-basis: 40px;
                font-size: 20px;
            }

            .home-composer-drawer .composer-count {
                display: none;
            }

            .home-sidebar {
                display: none !important;
            }
        }

        @media (max-width: 640px) {
            .home-layout {
                padding: 10px 14px 22px;
            }

            .home-search-shell {
                min-height: 44px;
                padding-left: 12px;
            }

            .home-search-icon {
                width: 32px;
                height: 32px;
                flex-basis: 32px;
            }

            .home-composer-fab {
                width: 52px;
                height: 52px;
                right: 16px;
                bottom: calc(106px + env(safe-area-inset-bottom));
            }
        }
    </style>
</head>

<body>
    <%- include('../partials/app-utility-bar', { pageTitle: 'Home', unreadCount: unreadCount, user: user }) %>
