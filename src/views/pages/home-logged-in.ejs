<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'NOOK - Home' %></title>
    <meta name="description" content="<%= description || 'Your Nook home feed.' %>">
    <meta name="theme-color" content="#6d0a0a">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=Abhaya+Libre:wght@400;500;600;700;800&family=Zen+Tokyo+Zoo&display=swap" rel="stylesheet">
    <%- include('../partials/nook-alert-css') %>
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            overflow-x: hidden;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #fff;
            color: #000;
            --home-nav-width: clamp(220px, 22vw, 300px);
            --home-content-gutter: clamp(16px, 2vw, 28px);
        }

        #mainNav,
        #mobileMenu,
        #mobileOverlay {
            display: none;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        /* Fixed side nav — outside main flow (matches explore) */
        .home-nav-column {
            position: fixed;
            top: var(--util-bar-height, 48px);
            left: 0;
            width: var(--home-nav-width);
            height: calc(100vh - var(--util-bar-height, 48px));
            overflow-y: auto;
            background: #fff;
            z-index: 100;
        }

        .home-nav-column .home-side-nav {
            position: static;
            top: auto;
            height: 100%;
            grid-area: unset;
        }

        /* Main shell offset for nav */
        .home-container {
            margin-left: var(--home-nav-width);
            width: calc(100% - var(--home-nav-width));
            min-height: calc(100vh - var(--util-bar-height, 48px));
            position: relative;
        }

        .home-container::before {
            content: "";
            position: fixed;
            top: var(--util-bar-height, 48px);
            bottom: 0;
            left: var(--home-nav-width);
            width: 1px;
            background: linear-gradient(
                180deg,
                transparent 0,
                rgba(109, 10, 10, 0.08) 48px,
                rgba(109, 10, 10, 0.2) 16%,
                rgba(109, 10, 10, 0.14) 84%,
                transparent 100%
            );
            pointer-events: none;
            z-index: 90;
        }

        .home-search {
            padding: clamp(12px, 2vw, 18px) var(--home-content-gutter) clamp(10px, 1.5vw, 14px);
            width: 100%;
        }

        .home-search form {
            display: flex;
            width: 100%;
            max-width: 100%;
        }

        .home-search-shell {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            min-height: clamp(48px, 7vw, 58px);
            padding: 8px 10px 8px 16px;
            border-radius: 999px;
            border: 1px solid rgba(109, 10, 10, 0.14);
            background: linear-gradient(180deg, #fff, #fffaf7);
            box-shadow: 0 16px 36px rgba(109, 10, 10, 0.06);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .home-search-shell:focus-within {
            border-color: rgba(109, 10, 10, 0.34);
            box-shadow: 0 18px 40px rgba(109, 10, 10, 0.1), 0 0 0 4px rgba(109, 10, 10, 0.06);
        }

        .home-search-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            flex: 0 0 36px;
            border-radius: 50%;
            background: rgba(109, 10, 10, 0.06);
            color: #6d0a0a;
        }

        .home-search input {
            width: 100%;
            min-width: 0;
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            font-size: 16px;
            color: #1f1715;
            background: transparent;
            border: none;
            outline: none;
            padding: 0;
        }

        .home-search input::placeholder {
            color: rgba(31, 23, 21, 0.45);
        }

        .home-search-scope {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 36px;
            padding: 0 14px;
            border-radius: 999px;
            background: rgba(109, 10, 10, 0.08);
            color: #6d0a0a;
            font-family: 'Abhaya Libre', serif;
            font-size: clamp(16px, 2vw, 18px);
            font-weight: 600;
            white-space: nowrap;
        }

        /* Feed + sidebar row */
        .home-main {
            display: grid;
            grid-template-columns: minmax(0, 1fr) clamp(260px, 28vw, 340px);
            gap: 0;
            align-items: start;
            width: 100%;
        }

        .home-main-column {
            min-width: 0;
            width: 100%;
            padding: 0 var(--home-content-gutter) clamp(60px, 6vw, 80px);
        }

        .home-sidebar {
            display: flex;
            flex-direction: column;
            gap: 24px;
            padding: clamp(16px, 2vw, 24px) clamp(12px, 2vw, 20px) clamp(24px, 3vw, 40px) clamp(8px, 1vw, 12px);
            position: sticky;
            top: clamp(16px, 2vw, 24px);
            max-height: calc(100vh - var(--util-bar-height, 48px) - 32px);
            overflow-y: auto;
            scrollbar-width: none;
        }

        .home-sidebar::-webkit-scrollbar {
            display: none;
        }

        /* Composer + feed spacing in main column */
        .home-main-column .home-composer {
            padding: 0 0 clamp(20px, 3vw, 28px);
            width: 100%;
        }

        .home-main-column .home-activity-feed {
            padding: 0;
            width: 100%;
            max-width: none;
        }

        @media (max-width: 1400px) {
            body {
                --home-nav-width: 260px;
            }
        }

        /* Hide right sidebar — single content column (matches explore at 1100px) */
        @media (max-width: 1100px) {
            .home-main {
                grid-template-columns: 1fr;
            }

            .home-sidebar {
                display: none !important;
            }
        }

        /* Hide left nav — full-width mobile/tablet layout */
        @media (max-width: 1024px) {
            body {
                --home-nav-width: 0px;
                --home-content-gutter: 16px;
            }

            .home-nav-column {
                display: none;
            }

            .home-container {
                margin-left: 0;
                width: 100%;
            }

            .home-container::before {
                display: none;
            }

            .home-main-column {
                padding-bottom: 80px;
            }

            .home-search-scope {
                display: none;
            }
        }

        @media (max-width: 640px) {
            .home-search {
                padding-top: 10px;
            }

            .home-search-shell {
                min-height: 44px;
                padding-left: 12px;
            }

            .home-search-icon {
                width: 32px;
                height: 32px;
                flex-basis: 32px;
            }
        }
    </style>
</head>
<body>
    <%- include('../partials/app-utility-bar', { pageTitle: 'Home', unreadCount: unreadCount, user: user }) %>

    <aside class="home-nav-column" aria-label="Main navigation">
        <%- include('../partials/home-side-nav', { unreadCount: unreadCount }) %>
    </aside>

    <div class="home-container">
        <section class="home-search" aria-label="Search">
            <form action="/search" method="GET" role="search">
                <label for="search-input" class="sr-only">Search</label>
                <div class="home-search-shell">
                    <span class="home-search-icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.35-4.35" />
                        </svg>
                    </span>
                    <input id="search-input" name="q" type="search" placeholder="Search Nook" aria-label="Search Nook" />
                    <span class="home-search-scope" aria-hidden="true">Posts</span>
                </div>
                <div id="search-results" class="hidden"></div>
            </form>
        </section>

        <div class="home-main">
            <div class="home-main-column">
                <%- include('../partials/home-post-composer') %>
                <%- include('../partials/home-activity-feed', { posts: posts, feedSuggestions: feedSuggestions, feedAds: feedAds, user: user }) %>
            </div>

            <aside class="home-sidebar" aria-label="Trending and suggestions">
                <%- include('../partials/home-trending', { trendingPosts: trendingPosts }) %>
                <% if (typeof sidebarAd !== 'undefined' && sidebarAd) { %>
                    <%- include('../partials/ad-sidebar', { ad: sidebarAd }) %>
                <% } %>
                <%- include('../partials/home-who-to-follow', { suggestedUsers: suggestedUsers }) %>
            </aside>
        </div>
    </div>

    <%- include('../partials/mobile-bottom-nav', { currentPage: 'home', unreadCount: unreadCount }) %>
    <%- include('../partials/nook-alert') %>
    <script src="/public/js/nook-alert.js"></script>
    <script src="/public/js/post-actions.js"></script>
    <script src="/public/js/search.js"></script>
</body>
</html>
