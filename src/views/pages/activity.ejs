<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Activity | NOOK' %></title>
    <meta name="description" content="<%= description || 'Stay updated with your notifications, interactions, and activity on NOOK.' %>">
    <link rel="canonical" href="<%= typeof canonical !== 'undefined' && canonical ? canonical : '' %>">
    <meta name="theme-color" content="#6d0a0a">
    <meta property="og:title" content="<%= title || 'Activity | NOOK' %>">
    <meta property="og:description" content="<%= description || 'Stay updated with your notifications, interactions, and activity on NOOK.' %>">
    <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title || 'Activity | NOOK' %>">
    <meta name="twitter:description" content="<%= description || 'Stay updated with your notifications, interactions, and activity on NOOK.' %>">
    <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Abhaya+Libre:wght@400;500;600;700;800&family=Zen+Tokyo+Zoo&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #ffffff;
            color: #000000;
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        /* ========== MAIN GRID LAYOUT ========== */
        .activity-container {
            display: grid;
            grid-template-columns: 1fr;
            grid-template-rows: auto 1fr;
            gap: 0;
            margin-left: clamp(200px, 18vw, 335px);
            position: relative;
            box-sizing: border-box;
        }

        /* ========== LEFT COLUMN - SIDE NAV ========== */
        .activity-left-column {
            position: fixed;
            top: 0;
            left: 0;
            width: clamp(240px, 20vw, 335px);
            height: 100vh;
            overflow-y: auto;
            padding: 0;
            background: #fff;
            z-index: 100;
        }

        /* ========== MIDDLE COLUMN - ACTIVITY FEED ========== */
        .activity-middle-column {
            min-width: 0;
            width: 100%;
            margin: 0 auto;
            padding: clamp(32px, 4vw, 48px) clamp(16px, 2vw, 24px) clamp(60px, 6vw, 80px) clamp(32px, 4vw, 48px);
            box-sizing: border-box;
        }

        /* ========== PAGE HEADER ========== */
        .activity-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: clamp(24px, 3vw, 40px);
        }

        .activity-header h1 {
            margin: 0;
            font-family: 'Abhaya Libre', serif;
            font-weight: 700;
            font-size: clamp(28px, 4vw, 40px);
            color: #000;
        }

        .activity-mark-read {
            font-family: 'Abhaya Libre', serif;
            font-weight: 500;
            font-size: clamp(14px, 1.8vw, 18px);
            color: #6d0a0a;
            background: none;
            border: 1px solid #6d0a0a;
            border-radius: 24px;
            padding: 8px 18px;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .activity-mark-read:hover {
            background: #6d0a0a;
            color: #fff;
        }

        /* ========== TABS ========== */
        .activity-tabs {
            display: flex;
            align-items: center;
            gap: clamp(6px, 1vw, 12px);
            margin-bottom: clamp(24px, 3vw, 40px);
            flex-wrap: wrap;
            border-bottom: 1px solid rgba(109,10,10,0.12);
            padding-bottom: 12px;
        }

        .activity-tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: clamp(6px, 1vw, 10px) clamp(12px, 2vw, 20px);
            border-radius: clamp(18px, 3vw, 58px);
            border: 1px solid transparent;
            background: transparent;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: 'Abhaya Libre', serif;
            font-weight: 400;
            font-size: clamp(14px, 1.8vw, 20px);
            color: #000;
            text-decoration: none;
            white-space: nowrap;
        }

        .activity-tab:hover {
            background: rgba(109,10,10,0.05);
        }

        .activity-tab-active {
            background: #6d0a0a;
            color: #fff;
            border-color: transparent;
        }

        .activity-tab-active:hover {
            background: #6d0a0a;
            opacity: 0.9;
        }

        .activity-tab-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 20px;
            height: 20px;
            padding: 0 6px;
            border-radius: 10px;
            background: #6d0a0a;
            color: #fff;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 600;
        }

        .activity-tab-active .activity-tab-badge {
            background: #fff;
            color: #6d0a0a;
        }

        /* ========== ACTIVITY FEED ========== */
        .activity-feed {
            display: flex;
            flex-direction: column;
            gap: 0;
            width: 100%;
        }

        .activity-date-group {
            margin-bottom: clamp(24px, 3vw, 40px);
        }

        .activity-date-label {
            font-family: 'Abhaya Libre', serif;
            font-weight: 600;
            font-size: clamp(16px, 2vw, 20px);
            color: rgba(0,0,0,0.5);
            margin: 0 0 16px 0;
            padding-left: 8px;
        }

        .activity-item {
            display: flex;
            align-items: flex-start;
            gap: clamp(12px, 2vw, 16px);
            padding: clamp(16px, 2vw, 20px);
            border-radius: clamp(16px, 2vw, 24px);
            background: #fff;
            border: 1px solid rgba(109,10,10,0.08);
            margin-bottom: 12px;
            transition: background 0.2s ease;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            position: relative;
        }

        .activity-item:hover {
            background: rgba(109,10,10,0.03);
        }

        .activity-item-unread {
            background: rgba(109,10,10,0.04);
            border-color: rgba(109,10,10,0.15);
        }

        .activity-item-unread:hover {
            background: rgba(109,10,10,0.07);
        }

        .activity-item-unread::before {
            content: '';
            position: absolute;
            left: 6px;
            top: 50%;
            transform: translateY(-50%);
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #6d0a0a;
        }

        .activity-item-avatar {
            width: clamp(40px, 5vw, 52px);
            height: clamp(40px, 5vw, 52px);
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .activity-item-body {
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex: 1;
            min-width: 0;
        }

        .activity-item-text {
            font-family: 'Abhaya Libre', serif;
            font-weight: 500;
            font-size: clamp(15px, 2vw, 18px);
            color: #000;
            line-height: 1.4;
            margin: 0;
        }

        .activity-item-text strong {
            font-weight: 700;
        }

        .activity-item-target {
            font-family: 'Abhaya Libre', serif;
            font-weight: 400;
            font-size: clamp(13px, 1.6vw, 15px);
            color: rgba(0,0,0,0.6);
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .activity-item-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: 'Inter', sans-serif;
            font-size: clamp(12px, 1.4vw, 13px);
            color: rgba(0,0,0,0.4);
        }

        .activity-item-type-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(109,10,10,0.08);
            color: #6d0a0a;
            flex-shrink: 0;
        }

        /* ========== EMPTY STATE ========== */
        .activity-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 80px 20px;
            text-align: center;
            gap: 16px;
        }

        .activity-empty-icon {
            width: 64px;
            height: 64px;
            color: rgba(0,0,0,0.2);
        }

        .activity-empty h2 {
            font-family: 'Abhaya Libre', serif;
            font-weight: 600;
            font-size: clamp(20px, 3vw, 28px);
            color: rgba(0,0,0,0.5);
            margin: 0;
        }

        .activity-empty p {
            font-family: 'Inter', sans-serif;
            font-size: clamp(14px, 1.8vw, 16px);
            color: rgba(0,0,0,0.35);
            margin: 0;
            max-width: 360px;
        }

        /* ========== RESPONSIVE BREAKPOINTS ========== */

        @media (max-width: 1100px) {
            .activity-container {
                grid-template-columns: 1fr;
                margin-left: 0;
            }
        }

        @media (max-width: 900px) {
            .activity-container {
                grid-template-columns: 1fr;
                margin-left: 0;
                min-height: 100vh;
                align-content: flex-start;
            }

            .activity-left-column {
                display: none;
            }

            .activity-middle-column {
                padding: 24px 20px 80px 20px;
                width: 100%;
                margin: 0 auto;
            }
        }

        @media (max-width: 640px) {
            .activity-middle-column {
                padding: 16px 16px 80px 16px;
            }

            .activity-header {
                margin-bottom: 20px;
            }

            .activity-tabs {
                gap: 6px;
                margin-bottom: 20px;
            }

            .activity-tab {
                padding: 5px 12px;
                font-size: 13px;
            }

            .activity-item {
                padding: 12px;
                margin-bottom: 8px;
            }

            .activity-item-avatar {
                width: 40px;
                height: 40px;
            }

            .activity-item-text {
                font-size: 14px;
            }

            .activity-item-target {
                font-size: 12px;
            }
        }

        /* Utility classes */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
    </style>
</head>
<body>

<!-- Main Grid Container -->
<div class="activity-container">

    <!-- LEFT COLUMN: Side Navigation (Desktop only) -->
    <aside class="activity-left-column">
        <%- include('../partials/app-side-nav', {
            sideNavItems: [
                { label: 'Home', href: '/', icon: 'home' },
                { label: 'Explore', href: '/browse', icon: 'explore' },
                { label: 'Activity', href: '/activity', icon: 'activity' },
                { label: 'Dashboard', href: '/dashboard', icon: 'dashboard' },
                { label: 'Profile', href: '/profile', icon: 'profile' }
            ],
            ctaText: 'Start Earning',
            ctaHref: '/register'
        }) %>
    </aside>

    <!-- MIDDLE COLUMN: Activity Feed -->
    <main class="activity-middle-column">

        <!-- Page Header -->
        <header class="activity-header">
            <h1>Activity</h1>
            <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                <button type="button" class="activity-mark-read" onclick="markAllRead()">Mark all as read</button>
            <% } %>
        </header>

        <!-- Tabs -->
        <nav class="activity-tabs" aria-label="Activity filters">
            <a href="/activity" class="activity-tab <%= activeFilter === 'all' ? 'activity-tab-active' : '' %>">
                All
                <% if (typeof totalUnread !== 'undefined' && totalUnread > 0) { %>
                    <span class="activity-tab-badge"><%= totalUnread %></span>
                <% } %>
            </a>
            <a href="/activity?filter=interactions" class="activity-tab <%= activeFilter === 'interactions' ? 'activity-tab-active' : '' %>">
                Interactions
            </a>
            <a href="/activity?filter=following" class="activity-tab <%= activeFilter === 'following' ? 'activity-tab-active' : '' %>">
                Following
            </a>
            <a href="/activity?filter=system" class="activity-tab <%= activeFilter === 'system' ? 'activity-tab-active' : '' %>">
                System
            </a>
        </nav>

        <!-- Activity Feed -->
        <div class="activity-feed">
            <% if (typeof groupedActivities !== 'undefined' && groupedActivities && Object.keys(groupedActivities).length > 0) { %>
                <% Object.keys(groupedActivities).forEach(function(dateLabel) { %>
                    <div class="activity-date-group">
                        <h2 class="activity-date-label"><%= dateLabel %></h2>
                        <% groupedActivities[dateLabel].forEach(function(activity) { %>
                            <a href="<%= activity.link || '#' %>" class="activity-item <%= activity.read ? '' : 'activity-item-unread' %>">
                                <% if (activity.actor && activity.actor.avatar) { %>
                                    <img src="<%= activity.actor.avatar %>" alt="<%= activity.actor.displayName %>" class="activity-item-avatar">
                                <% } else { %>
                                    <div class="activity-item-avatar" style="background: #e5e5e5; display: flex; align-items: center; justify-content: center; font-family: 'Abhaya Libre', serif; font-weight: 700; font-size: 18px; color: #6d0a0a;">
                                        <%= activity.actor ? activity.actor.displayName.charAt(0).toUpperCase() : '?' %>
                                    </div>
                                <% } %>
                                <div class="activity-item-body">
                                    <p class="activity-item-text"><%- activity.message %></p>
                                    <% if (activity.targetPreview) { %>
                                        <p class="activity-item-target"><%= activity.targetPreview %></p>
                                    <% } %>
                                    <div class="activity-item-meta">
                                        <span><%= activity.timeAgo %></span>
                                        <% if (!activity.read) { %>
                                            <span style="width: 4px; height: 4px; border-radius: 50%; background: #6d0a0a;"></span>
                                            <span style="color: #6d0a0a; font-weight: 500;">New</span>
                                        <% } %>
                                    </div>
                                </div>
                            </a>
                        <% }); %>
                    </div>
                <% }); %>
            <% } else { %>
                <!-- Empty State -->
                <div class="activity-empty">
                    <svg class="activity-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2z"/>
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
                    </svg>
                    <h2>No activity yet</h2>
                    <p>When people interact with your posts or you get notifications, they will appear here.</p>
                </div>
            <% } %>
        </div>

    </main>

</div>

<!-- Mobile Bottom Navigation -->
<%- include('../partials/mobile-bottom-nav', { currentPage: 'activity' }) %>

<script>
function markAllRead() {
    fetch('/api/notifications/mark-all-read', { method: 'POST' })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.success) {
                document.querySelectorAll('.activity-item-unread').forEach(function(el) {
                    el.classList.remove('activity-item-unread');
                });
                var btn = document.querySelector('.activity-mark-read');
                if (btn) btn.style.display = 'none';
            }
        })
        .catch(function(err) { console.error('Mark read failed:', err); });
}
</script>

</body>
</html>
