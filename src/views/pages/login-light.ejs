<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In | NOOK</title>
    <meta name="description" content="Sign in to NOOK to read, write, and earn rewards for engaging with tech content.">
    <link rel="canonical" href="<%= process.env.BASE_URL || '' %>/login">
    <meta name="theme-color" content="#6d0a0a">
    <meta property="og:title" content="Sign In | NOOK">
    <meta property="og:description" content="Sign in to NOOK to read, write, and earn rewards for engaging with tech content.">
    <meta property="og:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Sign In | NOOK">
    <meta name="twitter:description" content="Sign in to NOOK to read, write, and earn rewards for engaging with tech content.">
    <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { 
            font-family: 'Abhaya Libre', serif; 
            background-color: #ffffff; 
            color: #000000; 
            overflow-x: hidden; 
            min-height: 100vh;
        }
        
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }
        
        .hidden { display: none; }
        
        input[type="email"], input[type="text"], input[type="password"] {
            font-family: 'Abhaya Libre', serif;
            font-size: clamp(1rem, 2vw, 1.125rem);
            color: #000;
            padding: 12px 0;
            background: transparent;
            border: none;
            border-bottom: 1px solid #d4d4d4;
            width: 100%;
            outline: none;
            transition: border-color 0.3s ease;
        }
        
        input[type="email"]:focus, input[type="text"]:focus, input[type="password"]:focus {
            border-color: #000;
        }
        
        input[type="email"]::placeholder, input[type="text"]::placeholder, input[type="password"]::placeholder {
            color: #737373;
        }
        
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <main style="max-width: 1728px; margin: 0 auto; padding: 120px 24px 80px;">
        <div style="max-width: 448px; margin: 0 auto; padding: 0 24px;">
            <div style="text-align: center; margin-bottom: 32px;">
                <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 16px; background: rgba(109,10,10,0.1); border: 1px solid rgba(109,10,10,0.1); margin-bottom: 24px;">
                    <svg style="width: 32px; height: 32px; color: #6d0a0a;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <h1 style="font-family: 'Abhaya Libre', serif; font-weight: 700; font-size: clamp(1.875rem, 4vw, 2.25rem); color: #000; margin: 0 0 12px;">Welcome Back</h1>
                <p style="font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(1rem, 2vw, 1.125rem); color: #404040; margin: 0;">Sign in to continue</p>
            </div>
            
            <div style="background: #fff; border: 1px solid rgba(0,0,0,0.1); border-radius: 16px; padding: 32px;">
                <div id="errorAlert" class="hidden" style="margin-bottom: 24px; padding: 16px; border-radius: 12px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #991b1b; font-family: 'Abhaya Libre', serif; font-size: 14px;">
                    <span id="errorMessage"></span>
                </div>
                
                <form id="loginForm" style="display: flex; flex-direction: column; gap: 24px;">
                    <div>
                        <label for="email" style="display: block; font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: 14px; color: #404040; margin-bottom: 8px;">Email</label>
                        <input type="email" id="email" name="email" required style="width: 100%; padding: 12px 0; font-family: 'Abhaya Libre', serif; font-size: 16px; color: #000; background: transparent; border: none; border-bottom: 1px solid #d4d4d4; outline: none; transition: border-color 0.3s;" placeholder="you@example.com" onfocus="this.style.borderColor='#000'" onblur="this.style.borderColor='#d4d4d4'">
                    </div>
                    
                    <div>
                        <label for="password" style="display: block; font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: 14px; color: #404040; margin-bottom: 8px;">Password</label>
                        <input type="password" id="password" name="password" required style="width: 100%; padding: 12px 0; font-family: 'Abhaya Libre', serif; font-size: 16px; color: #000; background: transparent; border: none; border-bottom: 1px solid #d4d4d4; outline: none; transition: border-color 0.3s;" placeholder="Your password" onfocus="this.style.borderColor='#000'" onblur="this.style.borderColor='#d4d4d4'">
                    </div>
                    
                    <div style="display: flex; align-items: center; justify-content: space-between; font-size: 14px;">
                        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: #404040;">
                            <input type="checkbox" name="remember" style="width: 16px; height: 16px; border-radius: 4px; background: transparent; border: 1px solid rgba(0,0,0,0.3);">
                            <span style="font-family: 'Abhaya Libre', serif;">Remember me</span>
                        </label>
                        <a href="/forgot-password" style="font-family: 'Abhaya Libre', serif; color: rgba(109,10,10,0.8); text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#6d0a0a'" onmouseout="this.style.color='rgba(109,10,10,0.8)'">Forgot password?</a>
                    </div>
                    
                    <button type="submit" id="submitBtn" style="display: flex; width: 100%; height: 60px; align-items: center; justify-content: center; gap: 8px; padding: 10px; border-radius: 45px; font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: 20px; color: #fff; background: #6d0a0a; border: none; cursor: pointer; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                        <span id="btnText">Sign In</span>
                        <svg id="btnSpinner" class="hidden" style="width: 20px; height: 20px; animation: spin 1s linear infinite;" fill="none" viewBox="0 0 24 24">
                            <circle style="opacity: 0.25;" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path style="opacity: 0.75;" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </button>
                </form>
                
                <div style="margin-top: 24px; text-align: center;">
                    <p style="font-family: 'Abhaya Libre', serif; font-size: 14px; color: #404040; margin: 0;">
                        Don't have an account?
                        <a href="/register" style="font-family: 'Abhaya Libre', serif; font-weight: 500; color: #6d0a0a; text-decoration: none; transition: opacity 0.2s;" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">Create one</a>
                    </p>
                </div>
            </div>
            
            <div style="margin-top: 24px; text-align: center;">
                <a href="/" style="font-family: 'Abhaya Libre', serif; font-size: 14px; color: #737373; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: color 0.2s;" onmouseover="this.style.color='#404040'" onmouseout="this.style.color='#737373'">
                    <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    Back to home
                </a>
            </div>
        </div>
    </main>

    <script>
        const form = document.getElementById('loginForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnSpinner = document.getElementById('btnSpinner');
        const errorAlert = document.getElementById('errorAlert');
        const errorMessage = document.getElementById('errorMessage');
        
        function showError(message) {
            errorMessage.textContent = message;
            errorAlert.classList.remove('hidden');
        }
        
        function hideError() {
            errorAlert.classList.add('hidden');
        }
        
        function setLoading(loading) {
            submitBtn.disabled = loading;
            btnText.textContent = loading ? 'Signing in...' : 'Sign In';
            btnSpinner.classList.toggle('hidden', !loading);
        }
        
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            hideError();
            
            const formData = new FormData(form);
            const data = {
                email: formData.get('email'),
                password: formData.get('password')
            };
            
            setLoading(true);
            
            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    window.location.href = '<%= typeof redirectUrl !== "undefined" && redirectUrl ? redirectUrl : "/dashboard" %>';
                } else {
                    showError(result.error || 'Login failed. Please check your credentials.');
                }
            } catch (error) {
                showError('Network error. Please check your connection and try again.');
            } finally {
                setLoading(false);
            }
        });
    </script>
</body>
</html>
