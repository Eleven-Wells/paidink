<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In | PaidInk</title>
    <meta name="description" content="Sign in to PaidInk to read, write, and earn rewards for engaging with tech content.">
    <link rel="canonical" href="<%= process.env.BASE_URL || '' %>/login">
    <meta name="theme-color" content="#6d0a0a">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" href="/public/icons/icon-192.png">
    <link rel="apple-touch-icon" href="/public/icons/icon-192.png">
    <meta property="og:title" content="Sign In | PaidInk">
    <meta property="og:description"
        content="Sign in to PaidInk to read, write, and earn rewards for engaging with tech content.">
    <meta property="og:image"
        content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Sign In | PaidInk">
    <meta name="twitter:description"
        content="Sign in to PaidInk to read, write, and earn rewards for engaging with tech content.">
    <meta name="twitter:image"
        content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Abhaya+Libre:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <script>
        var LOGTO_ENABLED = <%= process.env.LOGTO_ENDPOINT && process.env.LOGTO_APP_ID ? 'true' : 'false' %>;
        function handleSocialLogin(btn, url) {
            btn.classList.add('loading');
            var loader = btn.querySelector('.dot-loader');
            if (loader) loader.classList.remove('hidden');
            setTimeout(function () {
                window.location.href = url;
            }, 400);
        }
    </script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Abhaya Libre', serif;
            background-color: #ffffff;
            color: #000000;
            overflow-x: hidden;
            min-height: 100vh;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .hidden {
            display: none;
        }

        input[type="email"],
        input[type="text"],
        input[type="password"] {
            font-family: 'Abhaya Libre', serif;
            font-size: clamp(1rem, 2vw, 1.125rem);
            color: #000;
            padding: 12px 0;
            background: transparent;
            border: none;
            border-bottom: 1px solid #d4d4d4;
            width: 100%;
            outline: none;
            transition: border-color 0.3s ease;
        }

        input[type="email"]:focus,
        input[type="text"]:focus,
        input[type="password"]:focus {
            border-color: #000;
        }

        input[type="email"]::placeholder,
        input[type="text"]::placeholder,
        input[type="password"]::placeholder {
            color: #737373;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .social-auth-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 44px;
            padding: 0 18px;
            border-radius: 999px;
            border: 1px solid rgba(0, 0, 0, 0.12);
            background: #fff;
            cursor: pointer;
            font-family: 'Abhaya Libre', serif;
            font-size: 16px;
            font-weight: 600;
            color: #000;
            transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
            flex: 1;
        }

        .social-auth-btn:hover {
            background: #fafafa;
            border-color: rgba(0, 0, 0, 0.2);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        .social-auth-btn svg {
            flex-shrink: 0;
        }

        .social-auth-btn {
            position: relative;
        }

        .social-auth-btn.loading {
            filter: blur(3px);
            pointer-events: none;
        }

        .x-btn,
        .discord-btn {
            display: none;
        }

        .dot-loader {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            display: flex;
            gap: 6px;
            z-index: 2;
            align-items: center;
        }

        .dot-loader span {
            width: 8px;
            height: 8px;
            background: #6d0a0a;
            border-radius: 50%;
            animation: dotPulse 1.4s ease-in-out infinite;
        }

        .dot-loader span:nth-child(1) {
            animation-delay: 0s;
        }

        .dot-loader span:nth-child(2) {
            animation-delay: 0.2s;
        }

        .dot-loader span:nth-child(3) {
            animation-delay: 0.4s;
        }

        .dot-loader.hidden {
            display: none;
        }

        @keyframes dotPulse {

            0%,
            20%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.8);
            }
        }
    </style>
</head>

<body>
    <main style="max-width: 1728px; margin: 0 auto; padding: 120px 24px 80px;">
        <div style="max-width: 448px; margin: 0 auto; padding: 0 24px;">
            <div style="text-align: center; margin-bottom: 32px;">
                <div
                    style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 16px; background: rgba(109,10,10,0.1); border: 1px solid rgba(109,10,10,0.1); margin-bottom: 24px;">
                    <svg style="width: 32px; height: 32px; color: #6d0a0a;" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h1
                    style="font-family: 'Abhaya Libre', serif; font-weight: 700; font-size: clamp(1.875rem, 4vw, 2.25rem); color: #000; margin: 0 0 12px;">
                    Welcome Back</h1>
                <p
                    style="font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(1rem, 2vw, 1.125rem); color: #404040; margin: 0;">
                    Sign in to continue</p>
            </div>

            <div style="background: #fff; border: 1px solid rgba(0,0,0,0.1); border-radius: 16px; padding: 32px;">
                <div id="errorAlert" class="hidden"
                    style="margin-bottom: 24px; padding: 16px; border-radius: 12px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #991b1b; font-family: 'Abhaya Libre', serif; font-size: 14px;">
                    <span id="errorMessage"></span>
                </div>

                <div class="social-auth-section">
                    <p style="text-align: center; margin-bottom: 16px; font-size: 18px; color: rgba(0,0,0,0.6);">
                        Continue with</p>
                    <div style="display: flex; gap: 12px; justify-content: center; margin-bottom: 24px;">
                        <button type="button" class="social-auth-btn google-btn"
                            onclick="handleSocialLogin(this, '/api/auth/logto/login?provider=google')"
                            aria-label="Sign in with Google">
                            <svg width="22" height="22" viewBox="0 0 24 24">
                                <path fill="#4285F4"
                                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
                                <path fill="#34A853"
                                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                                <path fill="#FBBC05"
                                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                                <path fill="#EA4335"
                                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                            </svg>
                            <span>Google</span>
                            <div class="dot-loader hidden"><span></span><span></span><span></span></div>
                        </button>
                        <button type="button" class="social-auth-btn x-btn"
                            onclick="handleSocialLogin(this, '/api/auth/logto/login?provider=twitter')"
                            aria-label="Sign in with X" style="display:none">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path
                                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                            </svg>
                            <span>X</span>
                            <div class="dot-loader hidden"><span></span><span></span><span></span></div>
                        </button>
                        <button type="button" class="social-auth-btn discord-btn"
                            onclick="handleSocialLogin(this, '/api/auth/logto/login?provider=discord')"
                            aria-label="Sign in with Discord" style="display:none">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="#5865F2">
                                <path
                                    d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z" />
                            </svg>
                            <span>Discord</span>
                            <div class="dot-loader hidden"><span></span><span></span><span></span></div>
                        </button>
                    </div>
                    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
                        <hr style="flex: 1; border: none; border-top: 1px solid rgba(0,0,0,0.1);">
                        <span style="color: rgba(0,0,0,0.4); font-size: 16px;">or sign in with email</span>
                        <hr style="flex: 1; border: none; border-top: 1px solid rgba(0,0,0,0.1);">
                    </div>
                </div>

                <form id="loginForm" style="display: flex; flex-direction: column; gap: 24px;">
                    <div>
                        <label for="email"
                            style="display: block; font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: 14px; color: #404040; margin-bottom: 8px;">Email</label>
                        <input type="email" id="email" name="email" required
                            style="width: 100%; padding: 12px 0; font-family: 'Abhaya Libre', serif; font-size: 16px; color: #000; background: transparent; border: none; border-bottom: 1px solid #d4d4d4; outline: none; transition: border-color 0.3s;"
                            placeholder="you@example.com" onfocus="this.style.borderColor='#000'"
                            onblur="this.style.borderColor='#d4d4d4'">
                    </div>

                    <div>
                        <label for="password"
                            style="display: block; font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: 14px; color: #404040; margin-bottom: 8px;">Password</label>
                        <input type="password" id="password" name="password" required
                            style="width: 100%; padding: 12px 0; font-family: 'Abhaya Libre', serif; font-size: 16px; color: #000; background: transparent; border: none; border-bottom: 1px solid #d4d4d4; outline: none; transition: border-color 0.3s;"
                            placeholder="Your password" onfocus="this.style.borderColor='#000'"
                            onblur="this.style.borderColor='#d4d4d4'">
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between; font-size: 14px;">
                        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: #404040;">
                            <input type="checkbox" name="remember"
                                style="width: 16px; height: 16px; border-radius: 4px; background: transparent; border: 1px solid rgba(0,0,0,0.3);">
                            <span style="font-family: 'Abhaya Libre', serif;">Remember me</span>
                        </label>
                        <a href="/forgot-password"
                            style="font-family: 'Abhaya Libre', serif; color: rgba(109,10,10,0.8); text-decoration: none; transition: color 0.2s;"
                            onmouseover="this.style.color='#6d0a0a'"
                            onmouseout="this.style.color='rgba(109,10,10,0.8)'">Forgot password?</a>
                    </div>

                    <button type="submit" id="submitBtn"
                        style="display: flex; width: 100%; height: 60px; align-items: center; justify-content: center; gap: 8px; padding: 10px; border-radius: 45px; font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: 20px; color: #fff; background: #6d0a0a; border: none; cursor: pointer; transition: opacity 0.2s;"
                        onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'">
                        <span id="btnText">Sign In</span>
                        <svg id="btnSpinner" class="hidden"
                            style="width: 20px; height: 20px; animation: spin 1s linear infinite;" fill="none"
                            viewBox="0 0 24 24">
                            <circle style="opacity: 0.25;" cx="12" cy="12" r="10" stroke="currentColor"
                                stroke-width="4"></circle>
                            <path style="opacity: 0.75;" fill="currentColor"
                                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                            </path>
                        </svg>
                    </button>
                </form>

                <div style="margin-top: 24px; text-align: center;">
                    <p style="font-family: 'Abhaya Libre', serif; font-size: 14px; color: #404040; margin: 0;">
                        Don't have an account?
                        <a href="/register"
                            style="font-family: 'Abhaya Libre', serif; font-weight: 500; color: #6d0a0a; text-decoration: none; transition: opacity 0.2s;"
                            onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">Create one</a>
                    </p>
                </div>
            </div>

            <div style="margin-top: 24px; text-align: center;">
                <a href="/"
                    style="font-family: 'Abhaya Libre', serif; font-size: 14px; color: #737373; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: color 0.2s;"
                    onmouseover="this.style.color='#404040'" onmouseout="this.style.color='#737373'">
                    <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Back to home
                </a>
            </div>
        </div>
    </main>

    <script>
        const form = document.getElementById('loginForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnSpinner = document.getElementById('btnSpinner');
        const errorAlert = document.getElementById('errorAlert');
        const errorMessage = document.getElementById('errorMessage');

        function showError(message) {
            errorMessage.textContent = message;
            errorAlert.classList.remove('hidden');
        }

        function hideError() {
            errorAlert.classList.add('hidden');
        }

        function setLoading(loading) {
            submitBtn.disabled = loading;
            btnText.textContent = loading ? 'Signing in...' : 'Sign In';
            btnSpinner.classList.toggle('hidden', !loading);
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            hideError();

            const formData = new FormData(form);
            const data = {
                email: formData.get('email'),
                password: formData.get('password')
            };

            setLoading(true);

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    window.location.href = '<%= typeof redirectUrl !== "undefined" && redirectUrl ? redirectUrl : "/dashboard" %>';
                } else {
                    showError(result.error || 'Login failed. Please check your credentials.');
                }
            } catch (error) {
                showError('Network error. Please check your connection and try again.');
            } finally {
                setLoading(false);
            }
        });
    </script>
</body>

</html>