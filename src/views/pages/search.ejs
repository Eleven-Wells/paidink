<section class="relative min-h-[50vh] flex items-center justify-center px-6 pt-28 pb-16 overflow-hidden">
    <div class="max-w-4xl mx-auto text-center relative z-10">
        <div class="fade-up mb-6">
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-4 block">Search Results</span>
            <h1 class="font-heading text-[3rem] sm:text-[4rem] md:text-[5rem] leading-[0.9] tracking-tight mb-4 break-words">
                "<%= query %>"
            </h1>
        </div>
        <p class="text-lg sm:text-xl text-muted max-w-2xl mx-auto leading-relaxed mb-4 fade-up" style="animation-delay: 0.1s">
            <%= pagination.total %> result<%= pagination.total !== 1 ? 's' : '' %> found
        </p>
        <form action="/search" method="GET" class="max-w-xl mx-auto fade-up" style="animation-delay: 0.2s">
            <div class="relative">
                <input type="search" name="q" value="<%= query %>" placeholder="Search Nook" aria-label="Search" class="w-full px-5 py-3.5 rounded-full bg-white/5 border border-white/10 text-white placeholder:text-muted focus:outline-none focus:border-white/30 transition-colors pr-12" />
                <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-muted hover:text-white transition-colors" aria-label="Submit search">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                    </svg>
                </button>
            </div>
        </form>
    </div>
</section>

<section id="results" class="relative z-10 py-16">
    <div class="max-w-7xl mx-auto px-6">
        <% if (results && results.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            <% results.forEach(function(post, index) { %>
            <a href="/post/<%= post.slug %>" class="block animate-on-scroll" style="opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease <%= index * 0.1 %>s, transform 0.6s ease <%= index * 0.1 %>s;">
                <article class="glass-card rounded-[1.5rem] overflow-hidden h-full transition-all duration-500 card-hover group">
                    <div class="relative overflow-hidden aspect-[16/10]">
                        <img src="<%= post.image || '/public/images/placeholder.jpg' %>" alt="<%= post.title %>" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="absolute top-4 left-4">
                            <span class="category-badge px-3 py-1.5 rounded-full text-white"><%= post.category || '' %></span>
                        </div>
                    </div>
                    <div class="p-6">
                        <div class="flex items-center gap-3 text-muted text-xs font-mono mb-3">
                            <span><%= formatDate ? formatDate(post.publishedAt) : new Date(post.publishedAt).toLocaleDateString() %></span>
                        </div>
                        <h3 class="font-heading text-xl mb-3 leading-snug group-hover:text-white/90 transition-colors"><%= post.title %></h3>
                        <p class="text-muted text-sm leading-relaxed line-clamp-2 mb-4"><%= post.summary || '' %></p>
                        <% if (post.tags && post.tags.length > 0) { %>
                        <div class="flex flex-wrap gap-2">
                            <% post.tags.slice(0, 3).forEach(function(tag) { %>
                            <span class="tag-chip px-2 py-1 rounded"><%= tag %></span>
                            <% }); %>
                        </div>
                        <% } %>
                    </div>
                </article>
            </a>
            <% }); %>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <div class="flex items-center justify-center gap-4 mt-12 fade-up">
            <% if (pagination.hasPrev) { %>
            <a href="/search?q=<%= encodeURIComponent(query) %>&page=<%= pagination.page - 1 %>" class="btn-primary-dark inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Previous
            </a>
            <% } %>
            <span class="text-muted text-sm font-mono">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
            <% if (pagination.hasNext) { %>
            <a href="/search?q=<%= encodeURIComponent(query) %>&page=<%= pagination.page + 1 %>" class="btn-primary-dark inline-flex items-center gap-2 px-6 py-3 rounded-full text-xs">
                Next
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </a>
            <% } %>
        </div>
        <% } %>

        <% } else { %>
        <div class="glass-card rounded-[1.5rem] p-16 text-center">
            <div class="w-16 h-16 rounded-full border border-white/10 bg-white/5 flex items-center justify-center mx-auto mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </div>
            <h3 class="font-heading text-2xl mb-3">No results found</h3>
            <p class="text-muted mb-6">We couldn't find any posts matching "<%= query %>". Try different keywords.</p>
            <a href="/browse" class="btn-primary-dark inline-block px-8 py-3 rounded-full text-xs">Browse All Posts</a>
        </div>
        <% } %>
    </div>
</section>