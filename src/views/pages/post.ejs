<% var metaTitle=post.title || (post.author ? post.author.displayName + '\' s post' : 'Untitled post' ); %>
    <script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": metaTitle,
  "description": post.metaDescription || post.summary || '',
  "image": {
    "@type": "ImageObject",
    "url": post.image || (process.env.BASE_URL || '') + '/public/images/og-default.png',
    "width": 1200,
    "height": 630
  },
  "datePublished": post.publishedAt ? new Date(post.publishedAt).toISOString() : new Date().toISOString(),
  "dateModified": post.updatedAt ? new Date(post.updatedAt).toISOString() : new Date().toISOString(),
  "author": {
    "@type": "Organization",
    "name": "NOOK",
    "url": process.env.BASE_URL || ''
  },
  "publisher": {
    "@type": "Organization",
    "name": "NOOK",
    "url": process.env.BASE_URL || ''
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": (process.env.BASE_URL || '') + '/post/' + post.slug
  },
  "keywords": (post.tags || []).join(', '),
  "articleSection": post.category || ''
}) %>
</script>
    <script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": process.env.BASE_URL || ''
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": typeof categoryNames !== 'undefined' && categoryNames[post.category] ? categoryNames[post.category] : post.category,
      "item": (process.env.BASE_URL || '') + '/category/' + post.category
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": metaTitle,
      "item": (process.env.BASE_URL || '') + '/post/' + post.slug
    }
  ]
}) %>
</script>

    <div class="post-page">
        <!-- Back Button -->
        <div class="max-w-4xl mx-auto px-6 pt-24 fade-up">
            <button type="button" id="postBackButton" class="post-back-btn pt-24" aria-label="Go back to previous page">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    aria-hidden="true">
                    <path d="m15 18-6-6 6-6" />
                    <path d="M21 12H9" />
                </svg>
                <span>Back</span>
            </button>
        </div>

        <div id="scrollProgressPost" class="post-progress-bar"></div>

        <main class="post-main" id="article-main">
            <div class="max-w-5xl mx-auto px-6 py-8 sm:py-12">

                <!-- Post Image -->
                <% if (post.image) { %>
                    <div class="post-media-wrap mb-10 relative">
                        <div class="post-media-frame">
                            <img src="<%= post.image %>" alt="<%= metaTitle %>" loading="eager" fetchpriority="high"
                                decoding="async" class="post-hero-image">
                        </div>
                    </div>
                    <% } %>

                        <% if (post.title) { %>
                            <h1
                                class="font-heading text-3xl sm:text-4xl md:text-5xl leading-tight mb-8 fade-up post-hero-title">
                                <%= post.title %>
                            </h1>
                            <% } %>

                                <!-- Post Content -->
                                <article class="post-article-shell">
                                    <div class="article-content" id="article-content">
                                        <% if (typeof adInline !=='undefined' && adInline && adInline.served &&
                                            post.contentBeforeAd) { %>
                                            <%- post.contentBeforeAd %>
                                                <%- include('../partials/ad-inline', { ad: adInline }) %>
                                                    <%- post.contentAfterAd %>
                                                        <% } else { %>
                                                            <%- post.content %>
                                                                <% } %>
                                    </div>
                                </article>

                                <!-- Date + Read Time -->
                                <div
                                    class="flex items-center justify-between mt-10 pt-6 border-t border-gray-100 text-sm font-mono text-gray-500">
                                    <div class="flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
                                            <line x1="16" x2="16" y1="2" y2="6" />
                                            <line x1="8" x2="8" y1="2" y2="6" />
                                            <line x1="3" x2="21" y1="10" y2="10" />
                                        </svg>
                                        <span>
                                            <%= formatDate ? formatDate(post.publishedAt) : new
                                                Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric' ,
                                                month: 'long' , day: 'numeric' }) %>
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10" />
                                            <polyline points="12 6 12 12 16 14" />
                                        </svg>
                                        <span>
                                            <%= post.readTime %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Post Footer (Author + Share) -->
                                <footer class="post-endcap mt-10 pt-8">
                                    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                                        <div class="post-author-card flex items-center gap-4">
                                            <div class="post-author-avatar">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                    viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                                                    <circle cx="12" cy="7" r="4" />
                                                </svg>
                                            </div>
                                            <div>
                                                <p class="font-medium post-author-name">
                                                    <%= post.author && (post.author.username || post.author.displayName)
                                                        ? (post.author.username || post.author.displayName) : 'NOOK' %>
                                                </p>
                                                <p class="text-sm post-author-copy">
                                                    <%= post.author && post.author.bio ? post.author.bio
                                                        : 'Curated tech insights for developers' %>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-4">
                                            <button type="button" class="post-share-btn share-btn"
                                                data-platform="twitter" aria-label="Share on Twitter">
                                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                    <path
                                                        d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" />
                                                </svg>
                                            </button>
                                            <button type="button" class="post-share-btn share-btn"
                                                data-platform="linkedin" aria-label="Share on LinkedIn">
                                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                    <path
                                                        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                                                </svg>
                                            </button>
                                            <button type="button" class="post-share-btn share-btn" data-platform="copy"
                                                aria-label="Copy link">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round"
                                                    stroke-linejoin="round">
                                                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                                                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                </footer>

            </div>
        </main>

        <section id="comments" class="post-comments-section">
            <div class="max-w-4xl mx-auto px-6">
                <div class="post-section-heading">
                    <span class="post-section-kicker">Conversation</span>
                    <h2 class="font-heading text-3xl sm:text-4xl post-section-title">
                        <span id="commentCount">0</span> Comments
                    </h2>
                </div>

                <% if (typeof isLoggedIn !=='undefined' && isLoggedIn) { %>
                    <div class="post-comment-composer">
                        <form id="commentForm" class="space-y-4">
                            <textarea id="commentContent" name="content" rows="3"
                                class="post-comment-input w-full resize-none" placeholder="Share your thoughts..."
                                maxlength="2000" required></textarea>
                            <div class="flex items-center justify-between gap-3 flex-wrap">
                                <span id="charCount" class="post-helper-text">0 / 2000</span>
                                <button type="submit" id="submitComment" class="post-primary-btn">
                                    Post Comment
                                </button>
                            </div>
                        </form>
                    </div>
                    <% } else { %>
                        <div class="post-signin-card">
                            <p class="post-signin-copy">Sign in to join the conversation</p>
                            <a href="/login" class="post-primary-btn post-primary-link">Sign In</a>
                        </div>
                        <% } %>

                            <div id="commentsList" class="post-comments-list space-y-4">
                                <div class="post-comments-status">Loading comments...</div>
                            </div>
            </div>
        </section>

        <% if (typeof adBanner !=='undefined' && adBanner && adBanner.served) { %>
            <div class="max-w-5xl mx-auto px-6 py-8">
                <%- include('../partials/ad-banner', { ad: adBanner }) %>
            </div>
            <% } %>

                <section class="post-related-section">
                    <div class="max-w-7xl mx-auto px-6">
                        <div class="text-center mb-12">
                            <span class="post-section-kicker">More Reading</span>
                            <h2 class="font-heading text-3xl sm:text-4xl post-section-title">RELATED ARTICLES</h2>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <% if (relatedPosts && relatedPosts.length> 0) { %>
                                <% relatedPosts.forEach(relatedPost=> { %>
                                    <% const relatedPlain=((relatedPost.content || '' ).replace(/<[^>]+>/g, ' ')
                                        .replace(/\s+/g, ' ').trim()); %>
                                        <% const relatedPreview=relatedPost.summary || (relatedPlain ?
                                            relatedPlain.substring(0, 120) + (relatedPlain.length> 120 ? '...' : '') :
                                            'Continue reading this story on Nook.'); %>
                                            <a href="/post/<%= relatedPost.slug %>"
                                                class="post-related-link block h-full">
                                                <article class="post-related-card group h-full">
                                                    <div class="post-related-media">
                                                        <img src="<%= relatedPost.image || '/public/images/placeholder.jpg' %>"
                                                            alt="<%= relatedPost.title %>" loading="lazy"
                                                            decoding="async" class="post-related-image">
                                                        <div class="post-related-overlay"></div>
                                                        <div class="absolute top-4 left-4">
                                                            <span class="post-category-pill post-category-pill--small">
                                                                <%= { 'development' : 'Development' , 'business'
                                                                    : 'Business' , 'health' : 'Health' , 'lifestyle'
                                                                    : 'Lifestyle' , 'news' : 'News' , 'sports'
                                                                    : 'Sports' , 'entertainment' : 'Entertainment'
                                                                    , 'politics' : 'Politics' }[relatedPost.category] ||
                                                                    relatedPost.category %>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="post-related-content">
                                                        <div
                                                            class="flex items-center gap-3 text-xs font-mono post-related-meta">
                                                            <span>
                                                                <%= formatDate ? formatDate(relatedPost.publishedAt) :
                                                                    new
                                                                    Date(relatedPost.publishedAt).toLocaleDateString()
                                                                    %>
                                                            </span>
                                                            <span class="post-meta-dot"></span>
                                                            <span>
                                                                <%= getReadTime(relatedPost.content).display %>
                                                            </span>
                                                        </div>
                                                        <h3
                                                            class="font-heading text-lg leading-snug line-clamp-2 post-related-title">
                                                            <%= relatedPost.title %>
                                                        </h3>
                                                        <p class="post-related-summary">
                                                            <%= relatedPreview %>
                                                        </p>
                                                        <div class="post-related-footer">
                                                            <span class="post-related-readmore">Read article</span>
                                                            <span class="post-related-arrow" aria-hidden="true">
                                                                <svg xmlns="http://www.w3.org/2000/svg" width="16"
                                                                    height="16" viewBox="0 0 24 24" fill="none"
                                                                    stroke="currentColor" stroke-width="2"
                                                                    stroke-linecap="round" stroke-linejoin="round">
                                                                    <path d="M5 12h14" />
                                                                    <path d="m12 5 7 7-7 7" />
                                                                </svg>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </article>
                                            </a>
                                            <% }); %>
                                                <% } else { %>
                                                    <div class="md:col-span-3 post-empty-card">
                                                        <p>No related articles found.</p>
                                                    </div>
                                                    <% } %>
                        </div>
                    </div>
                </section>

                <%- include('../partials/mobile-bottom-nav', { currentPage: 'post' , theme: 'light' }) %>
    </div>

    <style>
        .post-page {
            --post-accent: #6d0a0a;
            --post-accent-deep: #4c0707;
            --post-accent-soft: rgba(109, 10, 10, 0.08);
            --post-border: rgba(109, 10, 10, 0.12);
            --post-border-strong: rgba(109, 10, 10, 0.18);
            --post-copy: #2f2725;
            --post-copy-soft: #6c625f;
            --post-heading: #130f0e;
            --post-surface: #ffffff;
            --post-surface-soft: #fdf8f5;
            --post-shadow: 0 24px 80px rgba(109, 10, 10, 0.08);
            color: var(--post-heading);
            background: #ffffff;
        }

        .post-page .post-hero {
            position: relative;
            overflow: hidden;
            padding-top: 8rem;
            padding-bottom: 5rem;
            background:
                radial-gradient(circle at top center, rgba(109, 10, 10, 0.12), transparent 38%),
                linear-gradient(180deg, #fffdfb 0%, #ffffff 58%, #faf6f2 100%);
            border-bottom: 1px solid rgba(109, 10, 10, 0.08);
        }

        .post-page .post-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(109, 10, 10, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(109, 10, 10, 0.03) 1px, transparent 1px);
            background-size: 120px 120px;
            mask-image: radial-gradient(circle at top center, black 18%, transparent 74%);
            opacity: 0.55;
            pointer-events: none;
        }

        .post-page .post-hero-title {
            color: var(--post-heading);
            letter-spacing: -0.03em;
        }

        .post-page .post-back-row {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 2.25rem;
        }

        .post-page .post-back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            padding: 0.75rem 1rem;
            border-radius: 999px;
            border: 1px solid rgba(109, 10, 10, 0.12);
            background: rgba(255, 255, 255, 0.88);
            color: var(--post-accent);
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            backdrop-filter: blur(10px);
            box-shadow: 0 14px 34px rgba(109, 10, 10, 0.08);
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        }

        .post-page .post-back-btn:hover {
            transform: translateY(-1px);
            background: var(--post-accent);
            border-color: var(--post-accent);
            color: #ffffff;
            box-shadow: 0 18px 36px rgba(109, 10, 10, 0.18);
        }

        .post-page .post-hero-summary {
            color: var(--post-copy);
        }

        .post-page .post-category-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.35rem;
            padding: 0.7rem 1.1rem;
            border-radius: 999px;
            background: var(--post-accent);
            color: #ffffff;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            box-shadow: 0 12px 35px rgba(109, 10, 10, 0.18);
        }

        .post-page .post-category-pill--small {
            padding: 0.45rem 0.8rem;
            font-size: 0.65rem;
            letter-spacing: 0.12em;
            box-shadow: none;
        }

        .post-page .post-meta-row {
            color: var(--post-copy-soft);
            font-family: 'JetBrains Mono', monospace;
        }

        .post-page .post-meta-dot {
            width: 0.25rem;
            height: 0.25rem;
            border-radius: 999px;
            background: rgba(109, 10, 10, 0.22);
            flex-shrink: 0;
        }

        .post-page .post-meta-earn {
            color: #15803d;
        }

        .post-page .post-tag-chip {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 0.85rem;
            border-radius: 999px;
            background: var(--post-accent-soft);
            border: 1px solid rgba(109, 10, 10, 0.09);
            color: var(--post-accent);
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.8rem;
            font-weight: 600;
            transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease;
        }

        .post-page .post-tag-chip:hover {
            background: rgba(109, 10, 10, 0.12);
            transform: translateY(-1px);
        }

        .post-page .post-progress-bar {
            position: fixed;
            top: 0;
            left: 0;
            width: 0%;
            height: 2px;
            z-index: 60;
            background: linear-gradient(90deg, var(--post-accent), #b91c1c);
            box-shadow: 0 0 16px rgba(109, 10, 10, 0.35);
            transition: width 0.3s ease;
        }

        .post-page .post-main,
        .post-page .post-comments-section {
            position: relative;
            z-index: 10;
            background: #ffffff;
        }

        .post-page .post-comments-section {
            padding: 5rem 0;
            background:
                radial-gradient(circle at top left, rgba(109, 10, 10, 0.06), transparent 26%),
                linear-gradient(180deg, #fffaf7 0%, #fff3ec 100%);
            border-top: 1px solid rgba(109, 10, 10, 0.06);
            border-bottom: 1px solid rgba(109, 10, 10, 0.06);
        }

        .post-page .post-related-section {
            position: relative;
            z-index: 10;
            padding: 6rem 0;
            background:
                linear-gradient(180deg, #fff7f1 0%, #fdf0e7 100%);
        }

        .post-page .post-media-frame {
            overflow: hidden;
            border-radius: 1.75rem;
            border: 1px solid rgba(109, 10, 10, 0.1);
            box-shadow: var(--post-shadow);
            background: #f5eeea;
        }

        .post-page .post-hero-image {
            width: 100%;
            height: 400px;
            object-fit: cover;
            display: block;
        }

        .post-page .post-article-shell {
            max-width: 46rem;
            margin: 0 auto;
        }

        .post-page .article-content {
            font-size: 1.125rem;
            line-height: 1.85;
            color: var(--post-copy);
        }

        .post-page .article-content>*:first-child {
            margin-top: 0;
        }

        .post-page .article-content>*:last-child {
            margin-bottom: 0;
        }

        .post-page .article-content h1,
        .post-page .article-content h2,
        .post-page .article-content h3,
        .post-page .article-content h4 {
            color: var(--post-heading);
            font-weight: 700;
            margin-top: 2.75rem;
            margin-bottom: 1rem;
            line-height: 1.2;
            letter-spacing: -0.03em;
            font-family: 'Space Grotesk', sans-serif;
        }

        .post-page .article-content h1 {
            font-size: 2.25rem;
        }

        .post-page .article-content h2 {
            font-size: 1.9rem;
        }

        .post-page .article-content h3 {
            font-size: 1.55rem;
        }

        .post-page .article-content h4 {
            font-size: 1.25rem;
        }

        .post-page .article-content p,
        .post-page .article-content ul,
        .post-page .article-content ol,
        .post-page .article-content table,
        .post-page .article-content pre,
        .post-page .article-content blockquote {
            margin-bottom: 1.6rem;
        }

        .post-page .article-content strong {
            color: var(--post-heading);
            font-weight: 700;
        }

        .post-page .article-content a {
            color: var(--post-accent);
            text-decoration: underline;
            text-decoration-color: rgba(109, 10, 10, 0.22);
            text-decoration-thickness: 1.5px;
            text-underline-offset: 0.18em;
            transition: color 0.2s ease, text-decoration-color 0.2s ease;
        }

        .post-page .article-content a:hover {
            color: var(--post-accent-deep);
            text-decoration-color: rgba(109, 10, 10, 0.45);
        }

        .post-page .article-content ul,
        .post-page .article-content ol {
            padding-left: 1.4rem;
        }

        .post-page .article-content li {
            margin-bottom: 0.8rem;
            color: var(--post-copy);
        }

        .post-page .article-content li::marker {
            color: var(--post-accent);
        }

        .post-page .article-content blockquote {
            padding: 1.4rem 1.5rem;
            border-left: 4px solid var(--post-accent);
            border-radius: 1rem;
            background: var(--post-surface-soft);
            color: #564c48;
            font-style: italic;
        }

        .post-page .article-content code {
            background: #f6efeb;
            padding: 0.18rem 0.42rem;
