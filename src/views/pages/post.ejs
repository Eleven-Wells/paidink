    <script>
        console.log('[READTRACK] Script executing, isLoggedIn =', typeof isLoggedIn, isLoggedIn);
        console.log('[READTRACK] Cookie:', document.cookie);
        if (typeof isLoggedIn !== 'undefined' && isLoggedIn) {
            let readSessionId = null;
            let sessionStarted = false;
            let hasCompleted = false;
            let scrollUpdateTimer = null;
            let sessionStartTime = null;
            let isTabVisible = true;
            let minReadTimeSeconds = 0;

            const MIN_SCROLL_PERCENT = 90;

            function getAuthHeaders() {
                return {
                    'Content-Type': 'application/json'
                };
            }

            async function startReadSession() {
                console.log('Attempting to start read session for post:', '<%= post._id %>');
                try {
                    const response = await fetch('/api/reads/start', {
                        method: 'POST',
                        headers: getAuthHeaders(),
                        body: JSON.stringify({ postId: '<%= post._id %>' })
                    });
                    const result = await response.json();
                    if (result.success) {
                        readSessionId = result.data.sessionId;
                        sessionStarted = true;
                        sessionStartTime = Date.now();
                        minReadTimeSeconds = Number(result.data?.minTime) || 0;
                    } else {
                        console.error('Failed to start read session:', result.error || 'Unknown error', result);
                    }
                } catch (error) {
                    console.error('Failed to start read session:', error);
                }
            }

            async function updateProgress(progress) {
                if (!readSessionId || !sessionStarted) return;

                clearTimeout(scrollUpdateTimer);
                scrollUpdateTimer = setTimeout(async () => {
                    try {
                        await fetch('/api/reads/update-progress', {
                            method: 'POST',
                            headers: getAuthHeaders(),
                            body: JSON.stringify({ sessionId: readSessionId, progress })
                        });
                    } catch (error) {
                        console.error('Failed to update progress:', error);
                    }
                }, 500);
            }

            function canCompleteRead() {
                if (!sessionStartTime) return false;

                const timeSpent = (Date.now() - sessionStartTime) / 1000;
                const scrollPercent = getScrollPercent();

                return timeSpent >= minReadTimeSeconds && scrollPercent >= MIN_SCROLL_PERCENT;
            }

            function getScrollPercent() {
                const articleElement = document.getElementById('article-content');
                if (!articleElement) return 0;

                const articleRect = articleElement.getBoundingClientRect();
                const articleHeight = articleRect.height;
                const articleTop = articleRect.top;

                let scrolledThrough = 0;
                if (articleTop < 0) {
                    scrolledThrough = Math.abs(articleTop) + window.innerHeight;
                } else {
                    scrolledThrough = window.innerHeight - articleTop;
                }

                let articlePercent = 0;
                if (articleHeight > 0) {
                    articlePercent = (scrolledThrough / articleHeight) * 100;
                }

                return Math.min(100, Math.max(0, articlePercent));
            }

            async function completeReadSession() {
                if (!readSessionId || hasCompleted || !canCompleteRead()) return;

                hasCompleted = true;

                try {
                    const response = await fetch('/api/reads/complete', {
                        method: 'POST',
                        headers: getAuthHeaders(),
                        body: JSON.stringify({ sessionId: readSessionId })
                    });
                    const result = await response.json();
                    console.log('[COMPLETE] response:', JSON.stringify(result));
                    if (result.success && result.data.rewardAwarded) {
                        console.log('[TOAST] Calling showToast with amount:', result.data.rewardAmount);
                        if (typeof showToast === 'function') {
                            setTimeout(function () {
                                showToast('You earned \u20A6' + result.data.rewardAmount + '!', 'success');
                            }, 100);
                        } else {
                            console.warn('[TOAST] showToast not available');
                        }
                    }
                } catch (error) {
                    console.error('Failed to complete read session:', error);
                    hasCompleted = false;
                }
            }

            document.addEventListener('visibilitychange', function () {
                isTabVisible = !document.hidden;
            });

            window.addEventListener('scroll', function () {
                const scrollTop = window.pageYOffset;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
                const progressBar = document.getElementById('scrollProgressPost');
                if (progressBar) progressBar.style.width = scrollPercent + '%';

                if (sessionStarted && !hasCompleted) {
                    updateProgress(Math.round(scrollPercent));

                    if (scrollPercent >= MIN_SCROLL_PERCENT && canCompleteRead()) {
                        completeReadSession();
                    }
                }
            });

            function initReadTracking() {
                startReadSession();

                setInterval(function () {
                    if (sessionStarted && !hasCompleted) {
                        const scrollPercent = getScrollPercent();
                        if (scrollPercent >= MIN_SCROLL_PERCENT && canCompleteRead()) {
                            completeReadSession();
                        }
                    }
                }, 1000);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initReadTracking);
            } else {
                initReadTracking();
            }
        } else {
            window.addEventListener('scroll', function () {
                const scrollTop = window.pageYOffset;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
                const progressBar = document.getElementById('scrollProgressPost');
                if (progressBar) progressBar.style.width = scrollPercent + '%';
            });
        }

        document.querySelectorAll('.share-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const platform = this.dataset.platform;
                const url = window.location.href;
                const title = document.title;
                let shareUrl = '';
                switch (platform) {
                    case 'twitter':
                        shareUrl = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(title);
                        break;
                    case 'linkedin':
                        shareUrl = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url);
                        break;
                    case 'copy':
                        navigator.clipboard.writeText(url).then(() => {
                            this.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
                            setTimeout(() => {
                                this.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
                            }, 2000);
                        });
                        return;
                }
                if (shareUrl) window.open(shareUrl, '_blank', 'width=600,height=400');
            });
        });

        document.addEventListener('DOMContentLoaded', () => {

            const postBackButton = document.getElementById('postBackButton');

            if (!postBackButton) {
                console.warn('postBackButton not found');
                return;
            }

            function goBack(e) {
                e.preventDefault();

                try {
                    const fallbackUrl =
                        document.referrer &&
                            document.referrer.startsWith(window.location.origin)
                            ? document.referrer
                            : '/browse';

                    if (window.history.length > 1) {
                        window.history.back();

                        setTimeout(() => {
                            if (document.visibilityState === 'visible') {
                                window.location.href = fallbackUrl;
                            }
                        }, 400);

                        return;
                    }

                    window.location.href = fallbackUrl;

                } catch (error) {
                    console.error('Back navigation failed:', error);
                    window.location.href = '/browse';
                }
            }

            postBackButton.addEventListener('click', goBack);

        });

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            (function () {
                var postId = '<%= String(post._id) %>';
                var isLoggedIn = typeof isLoggedIn !== 'undefined' && isLoggedIn ? 'true' : 'false';
                var currentUser = null;
                try { currentUser = - typeof user !== 'undefined' && user ? JSON.stringify(typeof user.toJSON === 'function' ? user.toJSON() : user) : 'null'; } catch (e) { }

                function escapeHtml(text) {
                    var div = document.createElement('div');
                    div.appendChild(document.createTextNode(text));
                    return div.innerHTML;
                }

                function formatTime(dateStr) {
                    var now = new Date();
                    var date = new Date(dateStr);
                    var diff = Math.floor((now - date) / 1000);
                    if (diff < 60) return 'just now';
                    if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
                    if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
                    if (diff < 2592000) return Math.floor(diff / 86400) + 'd ago';
                    return date.toLocaleDateString();
                }

                function renderComment(comment) {
                    var author = comment.author || {};
                    var authorId = typeof author === 'object' ? (author._id || '') : author;
                    var authorName = typeof author === 'object' ? (author.displayName || 'Unknown') : 'User';
                    var isOwner = currentUser && authorId === currentUser._id;
                    var initials = authorName.charAt(0).toUpperCase();
                    var likesCount = comment.likes ? comment.likes.length : 0;
                    var userLiked = currentUser && comment.likes && comment.likes.some(function (uid) { return String(uid) === String(currentUser._id); });

                    return '<div class="post-comment-card" id="comment-' + comment._id + '">' +
                        '<div class="flex items-start gap-3">' +
                        '<div class="post-comment-avatar">' + initials + '</div>' +
                        '<div class="flex-1 min-w-0">' +
                        '<div class="flex items-center gap-2 flex-wrap">' +
                        '<span class="font-medium text-sm post-comment-author">' + escapeHtml(comment.author ? comment.author.displayName : 'Unknown') + '</span>' +
                        '<span class="text-xs post-comment-time">' + formatTime(comment.createdAt) + '</span>' +
                        '</div>' +
                        '<p class="text-sm leading-relaxed post-comment-text">' + escapeHtml(comment.content) + '</p>' +
                        '<div class="post-comment-actions">' +
                        '<button type="button" class="comment-like-btn post-comment-action" data-comment-id="' + comment._id + '">' +
                        (userLiked ? '<svg class="w-4 h-4 post-comment-like-icon-active" fill="currentColor" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>' : '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>') +
                        '<span class="comment-likes">' + likesCount + '</span>' +
                        '</button>' +
                        (isOwner ? '<button type="button" class="comment-delete-btn post-comment-action post-comment-action-delete" data-comment-id="' + comment._id + '">Delete</button>' : '') +
                        '</div>' +
                        '</div>' +
                        '</div>' +
                        '</div>';
                }

                async function loadComments() {
                    var listEl = document.getElementById('commentsList');
                    var countEl = document.getElementById('commentCount');
                    console.log('Loading comments for post:', postId);
                    try {
                        var res = await fetch('/api/posts/' + postId + '/comments');
                        var text = await res.text();
                        console.log('Comments response:', res.status, text);
                        var data = JSON.parse(text);

                        if (!listEl) return;

                        if (!data.success || !data.data || data.data.length === 0) {
                            listEl.innerHTML = '<div class="post-comments-status">No comments yet. Be the first!</div>';
                            if (countEl) countEl.textContent = '0';
                            return;
                        }

                        if (countEl) countEl.textContent = data.total;
                        listEl.innerHTML = data.data.map(renderComment).join('');
                        attachCommentActions(listEl);
                    } catch (e) {
                        console.error('Failed to load comments:', e);
                        var listEl = document.getElementById('commentsList');
                        if (listEl) listEl.innerHTML = '<div class="post-comments-status">Failed to load comments</div>';
                    }
                }

                function attachCommentActions(listEl) {
                    listEl.querySelectorAll('.comment-like-btn').forEach(function (btn) {
                        btn.addEventListener('click', async function () {
                            if (!isLoggedIn) return;
                            var cid = this.getAttribute('data-comment-id');
                            try {
                                var r = await fetch('/api/posts/' + postId + '/comments/' + cid + '/like', { method: 'POST' });
                                var d = await r.json();
                                if (d.success) {
                                    this.querySelector('.comment-likes').textContent = d.likesCount;
                                    if (d.liked) {
                                        this.querySelector('svg').outerHTML = '<svg class="w-4 h-4 post-comment-like-icon-active" fill="currentColor" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>';
                                    } else {
                                        this.querySelector('svg').outerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>';
                                    }
                                }
                            } catch (e) { console.error('Like failed:', e); }
                        });
                    });

                    listEl.querySelectorAll('.comment-delete-btn').forEach(function (btn) {
                        btn.addEventListener('click', async function () {
                            var cid = this.getAttribute('data-comment-id');
                            if (!confirm('Delete this comment?')) return;
                            try {
                                var r = await fetch('/api/posts/' + postId + '/comments/' + cid, { method: 'DELETE' });
                                var d = await r.json();
                                if (d.success) {
                                    var el = document.getElementById('comment-' + cid);
                                    if (el) el.remove();
                                    var cnt = document.getElementById('commentCount');
                                    if (cnt) cnt.textContent = Math.max(0, parseInt(cnt.textContent) - 1);
                                }
                            } catch (e) { console.error('Delete failed:', e); }
                        });
                    });
                }

                var form = document.getElementById('commentForm');
                var textarea = document.getElementById('commentContent');
                var charCount = document.getElementById('charCount');

                if (textarea && charCount) {
                    textarea.addEventListener('input', function () {
                        charCount.textContent = this.value.length + ' / 2000';
                    });
                }

                if (form) {
                    form.addEventListener('submit', async function (e) {
                        e.preventDefault();
                        var btn = document.getElementById('submitComment');
                        var content = textarea.value.trim();
                        if (!content || btn.disabled) return;

                        btn.disabled = true;
                        btn.textContent = 'Posting...';

                        try {
                            var res = await fetch('/api/posts/' + postId + '/comments', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ content: content })
                            });
                            var data = await res.json();
                            if (data.success) {
                                textarea.value = '';
                                if (charCount) charCount.textContent = '0 / 2000';
                                var listEl = document.getElementById('commentsList');
                                var countEl = document.getElementById('commentCount');
                                if (listEl && listEl.querySelector('.post-comments-status')) {
                                    listEl.innerHTML = renderComment(data.data);
                                } else if (listEl) {
                                    listEl.insertAdjacentHTML('afterbegin', renderComment(data.data));
                                }
                                if (countEl) countEl.textContent = parseInt(countEl.textContent) + 1;
                                attachCommentActions(listEl);
                            }
                        } catch (e) {
                            console.error('Comment failed:', e);
                        }

                        btn.disabled = false;
                        btn.textContent = 'Post Comment';
                    });
                }

                loadComments();
            })();
        });
    </script>