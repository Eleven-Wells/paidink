<section class="relative min-h-[70vh] flex items-center justify-center px-6 pt-28 pb-20 overflow-hidden">
    <div class="max-w-4xl mx-auto text-center relative z-10">
        <div class="fade-up mb-6">
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-4 block">Browse by</span>
            <h1 class="font-heading text-[3.5rem] sm:text-[5rem] md:text-[7rem] leading-[0.9] tracking-tight mb-4">
                <%= (categoryName || category || '').toUpperCase() %>
            </h1>
        </div>

        <p class="text-lg sm:text-xl text-muted max-w-2xl mx-auto leading-relaxed mb-10 fade-up" style="animation-delay: 0.1s">
            Discover the latest insights and updates in <%= categoryName || category %>. Stay ahead with curated content from industry experts.
        </p>

        <div class="flex items-center justify-center gap-3 text-muted fade-up" style="animation-delay: 0.2s">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0 3-3z"/></svg>
            <span class="font-mono text-sm"><%= (blogs || []).length %> article<%= (blogs || []).length !== 1 ? 's' : '' %> found</span>
        </div>

        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 fade-up" style="animation-delay: 0.4s">
            <div class="h-12 w-[1px] bg-gradient-to-b from-white/30 to-transparent"></div>
            <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-muted">Scroll</span>
        </div>
    </div>
</section>

<section id="articles" class="relative z-10 py-16">
    <div class="max-w-7xl mx-auto px-6">
        <% if (blogs && blogs.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            <% blogs.forEach((blog, index) => { %>
            <a href="/post/<%= blog.slug %>" class="block animate-on-scroll" style="opacity: 0; transform: translateY(30px); transition: opacity 0.6s ease <%= index * 0.1 %>s, transform 0.6s ease <%= index * 0.1 %>s;">
                <article class="glass-card rounded-[1.5rem] overflow-hidden h-full transition-all duration-500 card-hover group">
                    <div class="relative overflow-hidden aspect-[16/10]">
                        <img src="<%= blog.image || '/public/images/placeholder.jpg' %>" alt="<%= blog.title %>" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="absolute top-4 left-4">
                            <span class="category-badge px-3 py-1.5 rounded-full text-white"><%= (typeof categoryNames !== 'undefined' && categoryNames[blog.category]) ? categoryNames[blog.category] : (blog.category || '') %></span>
                        </div>
                    </div>
                    <div class="p-6">
                        <div class="flex items-center gap-3 text-muted text-xs font-mono mb-3">
                            <span><%= Math.ceil((blog.content || '').length / 1000) || 5 %> min read</span>
                            <span class="w-1 h-1 rounded-full bg-white/30"></span>
                            <span><%= formatDate ? formatDate(blog.publishedAt) : new Date(blog.publishedAt).toLocaleDateString() %></span>
                        </div>
                        <h3 class="font-heading text-xl mb-3 leading-snug group-hover:text-white/90 transition-colors"><%= blog.title %></h3>
                        <p class="text-muted text-sm leading-relaxed line-clamp-2 mb-4"><%= blog.summary || (blog.content || '').substring(0, 150) + '...' %></p>
                        <% if (blog.tags && blog.tags.length > 0) { %>
                        <div class="flex flex-wrap gap-2">
                            <% blog.tags.slice(0, 3).forEach(tag => { %>
                            <span class="tag-chip px-2 py-1 rounded"><%= tag %></span>
                            <% }); %>
                        </div>
                        <% } %>
                    </div>
                </article>
            </a>
            <% }); %>
        </div>
        <% } else { %>
        <div class="glass-card rounded-[1.5rem] p-16 text-center">
            <div class="w-16 h-16 rounded-full border border-white/10 bg-white/5 flex items-center justify-center mx-auto mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0 3-3z"/></svg>
            </div>
            <h3 class="font-heading text-2xl mb-3">No articles found</h3>
            <p class="text-muted mb-6">Check back later for new content in this category.</p>
            <a href="/" class="btn-primary-dark inline-block px-8 py-3 rounded-full text-xs">Back to Home</a>
        </div>
        <% } %>
    </div>
</section>

<section class="relative z-10 py-24">
    <div class="max-w-7xl mx-auto px-6">
        <div class="glass-card rounded-[2rem] p-8 sm:p-12 text-center">
            <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted mb-6 block">Explore More</span>
            <h2 class="font-heading text-3xl sm:text-4xl mb-8">OTHER CATEGORIES</h2>
            <div class="flex flex-wrap justify-center gap-4">
                <% const allCategories = ['development', 'business', 'health', 'lifestyle', 'news', 'sports', 'entertainment', 'politics']; %>
                <% const categoryLabels = {}; CATEGORY_ENUM.forEach(c => categoryLabels[c] = c); %>
                <% allCategories.filter(cat => cat !== category).forEach(cat => { %>
                    <a href="/?category=<%= encodeURIComponent(cat) %>" class="tag-chip px-6 py-3 rounded-full text-sm hover:bg-white/10">
                        <%= categoryLabels[cat] || cat %>
                    </a>
                <% }); %>
            </div>
        </div>
    </div>
</section>
