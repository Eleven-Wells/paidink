<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title || 'Withdraw | PaidInk' %>
    </title>
    <meta name="description"
        content="<%= description || 'Cash out your PaidInk earnings and manage your withdrawal history.' %>">
    <link rel="canonical" href="<%= canonical || '' %>">
    <meta name="theme-color" content="#6d0a0a">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" href="/public/icons/icon-192.png">
    <link rel="apple-touch-icon" href="/public/icons/icon-192.png">
    <meta property="og:title" content="<%= title || 'Withdraw | PaidInk' %>">
    <meta property="og:description"
        content="<%= description || 'Cash out your PaidInk earnings and manage your withdrawal history.' %>">
    <meta property="og:image"
        content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title || 'Withdraw | PaidInk' %>">
    <meta name="twitter:description"
        content="<%= description || 'Cash out your PaidInk earnings and manage your withdrawal history.' %>">
    <meta name="twitter:image"
        content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <%- include('../partials/dashboard-css') %>
        <style>
            .withdraw-shell {
                color: var(--dash-text);
            }

            .withdraw-hero,
            .withdraw-panel,
            .withdraw-info-panel {
                position: relative;
                overflow: hidden;
            }

            .withdraw-hero {
                background:
                    radial-gradient(circle at top right, rgba(109, 10, 10, 0.12), transparent 32%),
                    linear-gradient(135deg, rgba(255, 255, 255, 0.99), rgba(255, 244, 236, 0.98));
            }

            .withdraw-hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image:
                    linear-gradient(rgba(109, 10, 10, 0.035) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(109, 10, 10, 0.035) 1px, transparent 1px);
                background-size: 72px 72px;
                mask-image: radial-gradient(circle at top right, black 12%, transparent 70%);
                pointer-events: none;
            }

            .withdraw-panel::before,
            .withdraw-info-panel::before {
                content: "";
                position: absolute;
                inset: 0 auto auto 0;
                width: 100%;
                height: 1px;
                background: linear-gradient(90deg, rgba(109, 10, 10, 0.2), rgba(109, 10, 10, 0));
                pointer-events: none;
            }

            .withdraw-kicker {
                color: var(--dash-accent);
                letter-spacing: 0.2em;
            }

            .withdraw-title,
            .withdraw-section-title,
            .withdraw-method-title,
            .withdraw-info-title {
                color: var(--dash-text);
            }

            .withdraw-title {
                letter-spacing: -0.035em;
            }

            .withdraw-copy,
            .withdraw-method-copy,
            .withdraw-info-copy,
            .withdraw-field-note,
            .withdraw-field-hint {
                color: var(--dash-muted);
            }

            .withdraw-status-pill {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.45rem 0.75rem;
                border-radius: 999px;
                border: 1px solid rgba(109, 10, 10, 0.12);
                background: rgba(109, 10, 10, 0.05);
                color: var(--dash-accent);
                letter-spacing: 0.14em;
            }

            .withdraw-balance-strip {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding: 1.15rem;
                border-radius: 1.15rem;
                background: linear-gradient(135deg, rgba(109, 10, 10, 0.05), rgba(191, 86, 55, 0.08));
                border: 1px solid rgba(109, 10, 10, 0.12);
                box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
            }

            .withdraw-balance-label {
                color: var(--dash-muted);
            }

            .withdraw-balance-value {
                color: var(--dash-success);
                letter-spacing: -0.04em;
            }

            .withdraw-balance-icon {
                width: 3.5rem;
                height: 3.5rem;
                border-radius: 1rem;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(21, 128, 61, 0.12);
                color: var(--dash-success);
                border: 1px solid rgba(21, 128, 61, 0.16);
                box-shadow: 0 16px 32px rgba(21, 128, 61, 0.12);
                flex-shrink: 0;
            }

            .withdraw-section-label {
                color: var(--dash-text);
                font-weight: 600;
            }

            .withdraw-amount-input {
                font-size: 2rem;
                font-weight: 700;
                letter-spacing: -0.04em;
            }

            .withdraw-method-card {
                position: relative;
                overflow: hidden;
                background: rgba(109, 10, 10, 0.028);
                border-radius: 1rem;
                transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
            }

            .withdraw-method-card:hover {
                transform: translateY(-1px);
                box-shadow: 0 18px 36px rgba(109, 10, 10, 0.07);
            }

            .withdraw-method-card.selected {
                background: rgba(109, 10, 10, 0.07);
                box-shadow: 0 22px 42px rgba(109, 10, 10, 0.1);
            }

            .withdraw-method-icon {
                width: 3rem;
                height: 3rem;
                margin: 0 auto 0.75rem;
                border-radius: 1rem;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(109, 10, 10, 0.05);
                border: 1px solid rgba(109, 10, 10, 0.1);
                color: #6f6560;
                transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
            }

            .withdraw-method-card.selected .withdraw-method-icon {
                background: rgba(109, 10, 10, 0.12);
                border-color: rgba(109, 10, 10, 0.18);
                color: var(--dash-accent);
            }

            .withdraw-detail-panel {
                border: 1px solid rgba(109, 10, 10, 0.09);
                background: rgba(109, 10, 10, 0.03);
                border-radius: 1rem;
                padding: 1rem;
            }

            .withdraw-detail-heading {
                color: var(--dash-accent);
                letter-spacing: 0.14em;
            }

            .withdraw-button {
                box-shadow: var(--dash-primary-shadow);
            }

            .withdraw-button:disabled {
                background: #dbc8c0;
                color: #fffaf6;
                box-shadow: none;
                cursor: not-allowed;
                transform: none;
            }

            .withdraw-button:disabled:hover {
                background: #dbc8c0;
                box-shadow: none;
                transform: none;
            }

            .withdraw-info-list {
                display: grid;
                gap: 0.9rem;
            }

            .withdraw-info-item {
                display: flex;
                align-items: flex-start;
                gap: 0.85rem;
                padding: 0.95rem 0;
                border-top: 1px solid rgba(109, 10, 10, 0.08);
            }

            .withdraw-info-item:first-child {
                padding-top: 0;
                border-top: none;
            }

            .withdraw-info-item:last-child {
                padding-bottom: 0;
            }

            .withdraw-info-badge {
                width: 2rem;
                height: 2rem;
                border-radius: 999px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: rgba(109, 10, 10, 0.08);
                color: var(--dash-accent);
                font-size: 0.75rem;
                font-weight: 700;
                flex-shrink: 0;
            }

            .withdraw-focus-ring:focus-visible {
                outline: none;
                box-shadow: 0 0 0 4px rgba(109, 10, 10, 0.12);
            }

            .withdraw-back-link {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                padding: 0.6rem 0.85rem;
                border-radius: 999px;
                border: 1px solid rgba(109, 10, 10, 0.12);
                background: rgba(255, 255, 255, 0.88);
                backdrop-filter: blur(10px);
                color: var(--dash-accent);
                font-family: 'Space Grotesk', sans-serif;
                font-size: 0.82rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
            }

            .withdraw-back-link:hover {
                transform: translateY(-1px);
                background: var(--dash-accent);
                border-color: var(--dash-accent);
                color: #ffffff;
                box-shadow: 0 14px 30px rgba(109, 10, 10, 0.12);
            }

            @media (max-width: 640px) {

                .withdraw-hero,
                .withdraw-panel,
                .withdraw-info-panel {
                    padding: 1.2rem;
                }

                .withdraw-balance-strip {
                    align-items: flex-start;
                    flex-direction: column;
                }

                .withdraw-balance-icon {
                    width: 3.1rem;
                    height: 3.1rem;
                }

                .withdraw-amount-input {
                    font-size: 1.8rem;
                }
            }
        </style>
</head>

<body class="min-h-screen dashboard-page">
    <div class="bg-noise"></div>
    <div class="bg-grid"></div>

    <div class="mobile-overlay" id="mobileOverlay"></div>

    <%- include('../partials/app-utility-bar', { pageTitle: 'Withdraw' , unreadCount: unreadCount, user: user }) %>

        <main class="withdraw-shell relative z-10 pt-16 pb-16">
            <div class="max-w-3xl mx-auto px-6">
                <section class="glass-card withdraw-hero rounded-2xl p-6 md:p-8 mb-6">
                    <div class="relative z-10">
                        <div class="mb-5">
                            <button type="button" id="withdrawBackBtn" class="withdraw-back-link withdraw-focus-ring"
                                aria-label="Go back to previous page">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15 19l-7-7 7-7" />
                                </svg>
                                Back
                            </button>
                        </div>
                        <p class="withdraw-kicker font-mono text-xs uppercase mb-2">Payout Center</p>
                        <h1 class="withdraw-title font-heading text-3xl md:text-4xl font-bold mb-3">Withdraw Earnings
                        </h1>
                        <p class="withdraw-copy max-w-2xl">
                            Move your reading rewards to your bank account, mobile wallet, or airtime balance once you
                            meet the minimum payout.
                        </p>
                    </div>
                </section>

                <section class="glass-card withdraw-panel rounded-2xl p-6 md:p-7 mb-6">
                    <div class="withdraw-balance-strip mb-6">
                        <div>
                            <p class="withdraw-balance-label text-sm mb-2">Available Balance</p>
                            <p class="withdraw-balance-value font-heading text-3xl md:text-4xl font-bold">₦<%=
                                    ((user?.wallet?.balance || 0) / 100).toFixed(2) %>
                            </p>
                            <p class="withdraw-field-note text-xs mt-2">Choose a payout method and enter an amount up to
                                your available balance.</p>
                        </div>
                        <div class="withdraw-balance-icon">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                    </div>

                    <div class="mb-6">
                        <label class="withdraw-section-label block text-sm mb-2" for="amount">Withdrawal Amount
                            (₦)</label>
                        <input type="number" id="amount" class="input-dark withdraw-amount-input withdraw-focus-ring"
                            placeholder="0.00" min="100" max="<%= (user?.wallet?.balance || 0) / 100 %>">
                        <p class="withdraw-field-hint text-xs mt-2">Minimum withdrawal: ₦100</p>
                    </div>

                    <div class="mb-6">
                        <label class="withdraw-section-label block text-sm mb-3">Withdrawal Method</label>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="method-card withdraw-method-card withdraw-focus-ring rounded-xl p-4 text-center"
                                data-method="bank" tabindex="0" role="button" aria-label="Choose bank transfer">
                                <div class="withdraw-method-icon">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                                    </svg>
                                </div>
                                <p class="withdraw-method-title font-semibold">Bank Transfer</p>
                                <p class="withdraw-method-copy text-xs mt-1">Nigeria only</p>
                            </div>
                            <div class="method-card withdraw-method-card withdraw-focus-ring rounded-xl p-4 text-center"
                                data-method="mpesa" tabindex="0" role="button" aria-label="Choose M-Pesa">
                                <div class="withdraw-method-icon">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <p class="withdraw-method-title font-semibold">M-Pesa</p>
                                <p class="withdraw-method-copy text-xs mt-1">Kenya only</p>
                            </div>
                            <div class="method-card withdraw-method-card withdraw-focus-ring rounded-xl p-4 text-center"
                                data-method="airtime" tabindex="0" role="button" aria-label="Choose airtime">
                                <div class="withdraw-method-icon">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                    </svg>
                                </div>
                                <p class="withdraw-method-title font-semibold">Airtime</p>
                                <p class="withdraw-method-copy text-xs mt-1">All networks</p>
                            </div>
                        </div>
                    </div>

                    <div id="bankDetails" class="withdraw-detail-panel space-y-4 mb-6 hidden">
                        <div>
                            <p class="withdraw-detail-heading font-mono text-xs uppercase mb-4">Bank Details</p>
                            <p class="withdraw-field-note text-sm mb-4">Send your payout directly to a Nigerian bank
                                account.</p>
                        </div>
                        <div>
                            <label class="withdraw-section-label block text-sm mb-2">Bank Name</label>
                            <div class="custom-select">
                                <select data-custom-select>
                                    <option value="">Select bank</option>
                                    <option value="gtb">Guaranty Trust Bank</option>
                                    <option value="access">Access Bank</option>
                                    <option value="firstbank">First Bank of Nigeria</option>
                                    <option value="uba">United Bank for Africa</option>
                                    <option value="fidelity">Fidelity Bank</option>
                                    <option value="zenith">Zenith Bank</option>
                                </select>
                            </div>
                        </div>
                        <div>
                            <label class="withdraw-section-label block text-sm mb-2">Account Number</label>
                            <input type="text" class="input-dark withdraw-focus-ring" placeholder="0123456789">
                        </div>
                        <div>
                            <label class="withdraw-section-label block text-sm mb-2">Account Name</label>
                            <input type="text" class="input-dark withdraw-focus-ring" placeholder="Your full name">
                        </div>
                    </div>

                    <div id="mpesaDetails" class="withdraw-detail-panel space-y-4 mb-6 hidden">
                        <div>
                            <p class="withdraw-detail-heading font-mono text-xs uppercase mb-4">M-Pesa Details</p>
                            <p class="withdraw-field-note text-sm mb-4">Payouts will be sent to the Safaricom number you
                                provide.</p>
                        </div>
                        <div>
                            <label class="withdraw-section-label block text-sm mb-2">M-Pesa Phone Number</label>
                            <input type="tel" class="input-dark withdraw-focus-ring" placeholder="+254700000000">
                        </div>
                    </div>

                    <div id="airtimeDetails" class="withdraw-detail-panel space-y-4 mb-6 hidden">
                        <div>
                            <p class="withdraw-detail-heading font-mono text-xs uppercase mb-4">Airtime Details</p>
                            <p class="withdraw-field-note text-sm mb-4">Convert part of your balance into mobile credit
                                on the number below.</p>
                        </div>
                        <div>
                            <label class="withdraw-section-label block text-sm mb-2">Phone Number</label>
                            <input type="tel" class="input-dark withdraw-focus-ring" placeholder="+2348000000000">
                        </div>
                    </div>

                    <button id="withdrawBtn" type="button"
                        class="btn-primary-dark withdraw-button w-full py-3 px-6 rounded-full text-xs" disabled>
                        Request Withdrawal
                    </button>
                </section>

                <section class="glass-card withdraw-info-panel rounded-2xl p-6">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
                        <h2 class="withdraw-info-title font-heading text-xl font-semibold">Withdrawal Info</h2>
                        <p class="withdraw-copy text-sm">Processing usually completes within 24 to 48 hours.</p>
                    </div>

                    <div class="withdraw-info-list">
                        <div class="withdraw-info-item">
                            <span class="withdraw-info-badge">01</span>
                            <div>
                                <p class="withdraw-section-title font-semibold">Minimum payout threshold</p>
                                <p class="withdraw-info-copy text-sm mt-1">You need at least ₦100 in your balance before
                                    a request can be submitted.</p>
                            </div>
                        </div>
                        <div class="withdraw-info-item">
                            <span class="withdraw-info-badge">02</span>
                            <div>
                                <p class="withdraw-section-title font-semibold">Bank transfer availability</p>
                                <p class="withdraw-info-copy text-sm mt-1">Bank withdrawals are currently limited to
                                    Nigerian accounts.</p>
                            </div>
                        </div>
                        <div class="withdraw-info-item">
                            <span class="withdraw-info-badge">03</span>
                            <div>
                                <p class="withdraw-section-title font-semibold">Regional payout methods</p>
                                <p class="withdraw-info-copy text-sm mt-1">M-Pesa is available for Kenya users, while
                                    airtime redemption works across supported networks.</p>
                            </div>
                        </div>
                        <div class="withdraw-info-item">
                            <span class="withdraw-info-badge">04</span>
                            <div>
                                <p class="withdraw-section-title font-semibold">Review and processing</p>
                                <p class="withdraw-info-copy text-sm mt-1">Each withdrawal request is reviewed before
                                    payout to help prevent failed transfers.</p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </main>

        <%- include('../partials/nook-alert') %>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const methodCards = document.querySelectorAll('.method-card');
                    const bankDetails = document.getElementById('bankDetails');
                    const mpesaDetails = document.getElementById('mpesaDetails');
                    const airtimeDetails = document.getElementById('airtimeDetails');
                    const withdrawBtn = document.getElementById('withdrawBtn');
                    const amountInput = document.getElementById('amount');

                    let selectedMethod = null;

                    function selectMethod(card) {
                        methodCards.forEach(c => {
                            c.classList.remove('selected');
                            c.setAttribute('aria-pressed', 'false');
                        });

                        card.classList.add('selected');
                        card.setAttribute('aria-pressed', 'true');
                        selectedMethod = card.dataset.method;

                        bankDetails.classList.add('hidden');
                        mpesaDetails.classList.add('hidden');
                        airtimeDetails.classList.add('hidden');

                        if (selectedMethod === 'bank') bankDetails.classList.remove('hidden');
                        if (selectedMethod === 'mpesa') mpesaDetails.classList.remove('hidden');
                        if (selectedMethod === 'airtime') airtimeDetails.classList.remove('hidden');

                        checkWithdrawButton();
                    }

                    methodCards.forEach(card => {
                        card.setAttribute('aria-pressed', 'false');

                        card.addEventListener('click', function () {
                            selectMethod(this);
                        });

                        card.addEventListener('keydown', function (event) {
                            if (event.key === 'Enter' || event.key === ' ') {
                                event.preventDefault();
                                selectMethod(this);
                            }
                        });
                    });

                    amountInput.addEventListener('input', checkWithdrawButton);

                    function checkWithdrawButton() {
                        const amount = parseFloat(amountInput.value) || 0;
                        const maxAmount = <%= (user?.wallet?.balance || 0) / 100 %>;
                        withdrawBtn.disabled = !selectedMethod || amount < 100 || amount > maxAmount;
                    }

                    if (withdrawBtn) {
                        withdrawBtn.addEventListener('click', () => {
                            showToast('Withdrawal feature coming soon!', 'success');
                        });
                    }
                });
            </script>

            <%- include('../partials/dashboard-scripts') %>

                <script>
                    const withdrawBackBtn = document.getElementById('withdrawBackBtn');
                    if (withdrawBackBtn) {
                        withdrawBackBtn.addEventListener('click', function () {
                            const fallbackUrl = document.referrer && document.referrer.startsWith(window.location.origin)
                                ? document.referrer
                                : '/dashboard';

                            if (window.history.length > 1) {
                                window.history.back();

                                window.setTimeout(function () {
                                    if (document.visibilityState === 'visible') {
                                        window.location.href = fallbackUrl;
                                    }
                                }, 400);

                                return;
                            }

                            window.location.href = fallbackUrl;
                        });
                    }
                </script>

                <%- include('../partials/mobile-bottom-nav', { currentPage: 'withdraw' , theme: 'light' }) %>
</body>

</html>