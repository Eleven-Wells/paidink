<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join NOOK</title>
    <meta name="description"
        content="Create your NOOK account and start earning rewards by reading and writing blog content. Get a ₦100 welcome bonus.">
    <link rel="canonical" href="<%= process.env.BASE_URL || '' %>/register">
    <meta name="theme-color" content="#6d0a0a">
    <meta property="og:title" content="Join NOOK">
    <meta property="og:description"
        content="Create your NOOK account and and writing blog content. Get a ₦100 welcome bonus.">
    <meta property="og:image"
        content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Join NOOK">
    <meta name="twitter:description"
        content="Create your NOOK account and start earning rewards by reading and writing blog content.">
    <meta name="twitter:image"
        content="<%= typeof ogImage !== 'undefined' && ogImage ? ogImage : '/public/images/og-default.png' %>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Zen+Tokyo+Zoo&family=Abhaya+Libre:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Abhaya Libre', serif;
            background-color: #ffffff;
            color: #000000;
            overflow-x: hidden;
            min-height: 100vh;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        input[type="email"],
        input[type="text"],
        input[type="password"] {
            font-family: 'Abhaya Libre', serif;
            font-size: clamp(1rem, 2vw, 1.125rem);
            color: #000;
            padding: 12px 0;
            background: transparent;
            border: none;
            border-bottom: 1px solid #d4d4d4;
            width: 100%;
            outline: none;
            transition: border-color 0.3s ease;
        }

        input[type="email"]:focus,
        input[type="text"]:focus,
        input[type="password"]:focus {
            border-color: #000;
        }

        input[type="email"]::placeholder,
        input[type="text"]::placeholder,
        input[type="password"]::placeholder {
            color: #737373;
        }

        .btn-primary {
            display: flex;
            width: 100%;
            height: 60px;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px;
            border-radius: 45px;
            font-family: 'Abhaya Libre', serif;
            font-weight: 500;
            font-size: clamp(1.125rem, 2.5vw, 1.25rem);
            color: #fff;
            background-color: #6d0a0a;
            border: none;
            cursor: pointer;
            transition: opacity 0.2s ease;
        }

        .btn-primary:hover {
            opacity: 0.9;
        }

        .btn-primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .animate-spin {
            animation: spin 1s linear infinite;
        }
    </style>
</head>

<body>
    <%- include('../partials/header', { isLoggedIn: (typeof isLoggedIn !=='undefined' && isLoggedIn), user: (typeof user
        !=='undefined' ) ? user : null }) %>

        <main style="max-width: 1728px; margin: 0 auto; padding: 120px 24px 80px;">
            <div style="max-width: 448px; margin: 0 auto;">
                <div style="text-align: center; margin-bottom: 32px;">
                    <div
                        style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 16px; background: rgba(109,10,10,0.1); border: 1px solid rgba(109,10,10,0.1); margin-bottom: 24px;">
                        <svg style="width: 32px; height: 32px; color: #6d0a0a;" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h1
                        style="font-family: 'Abhaya Libre', serif; font-weight: 700; font-size: clamp(1.875rem, 4vw, 2.25rem); color: #000; margin: 0 0 12px;">
                        Create Your Account</h1>
                    <p
                        style="font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(1rem, 2vw, 1.125rem); color: #404040; margin: 0;">
                        Start earning rewards by reading blog content</p>
                </div>

                <div style="background: #fff; border: 1px solid rgba(0,0,0,0.1); border-radius: 16px; padding: 32px;">
                    <div id="errorAlert" class="hidden"
                        style="margin-bottom: 24px; padding: 16px; border-radius: 12px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #991b1b; font-family: 'Abhaya Libre', serif; font-size: 14px;">
                        <span id="errorMessage"></span>
                    </div>

                    <form id="registerForm" style="display: flex; flex-direction: column; gap: 24px;">
                        <div>
                            <label for="email"
                                style="display: block; font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: 14px; color: #404040; margin-bottom: 8px;">Email</label>
                            <input type="email" id="email" name="email" required placeholder="you@example.com">
                        </div>

                        <div>
                            <label for="username"
                                style="display: block; font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: 14px; color: #404040; margin-bottom: 8px;">Username
                                (Optional)</label>
                            <input type="text" id="username" name="username" placeholder="your_username">
                            <p style="font-size: 12px; color: #737373; margin: 8px 0 0;">Leave blank for auto-generated
                                username.</p>
                        </div>

                        <div>
                            <label for="password"
                                style="display: block; font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: 14px; color: #404040; margin-bottom: 8px;">Password</label>
                            <input type="password" id="password" name="password" required minlength="6"
                                placeholder="Minimum 6 characters">
                        </div>

                        <div>
                            <label for="referralCode"
                                style="display: block; font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: 14px; color: #404040; margin-bottom: 8px;">Referral
                                Code (Optional)</label>
                            <input type="text" id="referralCode" name="referralCode" value="<%= referralCode || '' %>"
                                placeholder="ABC123">
                        </div>

                        <button type="submit" id="submitBtn" class="btn-primary">
                            <span id="btnText">Create Account</span>
                            <svg id="btnSpinner" class="hidden animate-spin" style="width: 20px; height: 20px;"
                                fill="none" viewBox="0 0 24 24">
                                <circle style="opacity: 0.25;" cx="12" cy="12" r="10" stroke="currentColor"
                                    stroke-width="4"></circle>
                                <path style="opacity: 0.75;" fill="currentColor"
                                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                                </path>
                            </svg>
                        </button>
                    </form>

                    <div style="margin-top: 24px; text-align: center;">
                        <p style="font-family: 'Abhaya Libre', serif; font-size: 14px; color: #404040; margin: 0;">
                            Already have an account?
                            <a href="/login"
                                style="font-family: 'Abhaya Libre', serif; font-weight: 500; color: #6d0a0a; text-decoration: none; transition: opacity 0.2s;"
                                onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">Sign In</a>
                        </p>
                    </div>
                </div>

                <div style="margin-top: 24px; text-align: center;">
                    <div
                        style="display: inline-flex; align-items: center; gap: 8px; padding: 16px; background: rgba(109,10,10,0.05); border: 1px solid rgba(109,10,10,0.1); border-radius: 12px; font-family: 'Abhaya Libre', serif; font-size: 14px; color: #404040;">
                        <svg style="width: 16px; height: 16px; color: #22c55e;" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Get <span style="font-weight: 600; color: #6d0a0a;">₦100</span> welcome bonus just for signing
                        up!
                    </div>
                </div>

                <div style="margin-top: 24px; text-align: center;">
                    <a href="/"
                        style="font-family: 'Abhaya Libre', serif; font-size: 14px; color: #737373; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; transition: color 0.2s;"
                        onmouseover="this.style.color='#404040'" onmouseout="this.style.color='#737373'">
                        <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                        </svg>
                        Back to home
                    </a>
                </div>
            </div>
        </main>

        <script>
            function toggleMobileMenu() {
                const menu = document.getElementById('mobileMenu');
                const overlay = document.getElementById('mobileOverlay');
                if (menu && overlay) {
                    menu.classList.toggle('active');
                    overlay.classList.toggle('active');
                    document.body.style.overflow = menu.classList.contains('active') ? 'hidden' : '';
                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                const hamburgerBtn = document.getElementById('hamburgerBtn');
                const closeMenuBtn = document.getElementById('closeMenuBtn');
                const overlay = document.getElementById('mobileOverlay');

                if (hamburgerBtn) {
                    hamburgerBtn.addEventListener('click', toggleMobileMenu);
                }
                if (closeMenuBtn) {
                    closeMenuBtn.addEventListener('click', toggleMobileMenu);
                }
                if (overlay) {
                    overlay.addEventListener('click', toggleMobileMenu);
                }
            });

            const form = document.getElementById('registerForm');
            const submitBtn = document.getElementById('submitBtn');
            const btnText = document.getElementById('btnText');
            const btnSpinner = document.getElementById('btnSpinner');
            const errorAlert = document.getElementById('errorAlert');
            const errorMessage = document.getElementById('errorMessage');

            function showError(message) {
                errorMessage.textContent = message;
                errorAlert.classList.remove('hidden');
            }

            function hideError() {
                errorAlert.classList.add('hidden');
            }

            function setLoading(loading) {
                submitBtn.disabled = loading;
                btnText.textContent = loading ? 'Creating account...' : 'Create Account';
                btnSpinner.classList.toggle('hidden', !loading);
            }

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                hideError();

                const formData = new FormData(form);
                const data = {
                    email: formData.get('email'),
                    password: formData.get('password'),
                    username: formData.get('username') || undefined,
                    referralCode: formData.get('referralCode') || undefined
                };

                setLoading(true);

                try {
                    const response = await fetch('/api/auth/register', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(data)
                    });

                    const result = await response.json();

                    if (result.success) {
                        window.location.href = '/dashboard';
                    } else {
                        showError(result.error || 'Registration failed. Please try again.');
                    }
                } catch (error) {
                    showError('Network error. Please check your connection and try again.');
                } finally {
                    setLoading(false);
                }
            });
        </script>
</body>

</html>