<div class="mb-8">
    <div class="glass-card p-8 flex items-center justify-between">
        <div class="flex items-center gap-6">
            <div class="w-20 h-20 rounded-2xl <%= health.status === 'healthy' ? 'bg-green-500/20' : health.status === 'degraded' ? 'bg-yellow-500/20' : 'bg-red-500/20' %> flex items-center justify-center">
                <% if (health.status === 'healthy') { %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <% } else if (health.status === 'degraded') { %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
                <% } else { %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></svg>
                <% } %>
            </div>
            <div>
                <h2 class="font-heading text-3xl font-bold capitalize"><%= health.status %></h2>
                <p class="text-muted mt-1">Last checked: <%= new Date(health.lastChecked).toLocaleString() %></p>
            </div>
        </div>
        <button onclick="checkHealth()" class="btn-secondary flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
            Check Now
        </button>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="table-container">
        <div class="p-6 border-b border-white/10">
            <h3 class="font-heading text-lg font-semibold">Services</h3>
        </div>
        <div class="divide-y divide-white/5">
            <% health.services.forEach(service => { %>
                <div class="p-6 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-xl <%= service.status === 'up' ? 'bg-green-500/20' : 'bg-red-500/20' %> flex items-center justify-center">
                            <% if (service.status === 'up') { %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                            <% } else { %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
                            <% } %>
                        </div>
                        <div>
                            <p class="font-medium"><%= service.name %></p>
                            <p class="text-xs text-muted mt-1"><%= service.description %></p>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="badge <%= service.status === 'up' ? 'badge-success' : 'badge-error' %>">
                            <%= service.status.toUpperCase() %>
                        </span>
                        <p class="text-xs text-muted mt-1"><%= service.latency %>ms</p>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
    
    <div class="table-container">
        <div class="p-6 border-b border-white/10">
            <h3 class="font-heading text-lg font-semibold">Database Connections</h3>
        </div>
        <div class="p-6 space-y-6">
            <div>
                <div class="flex justify-between mb-2">
                    <span class="text-sm">MongoDB</span>
                    <span class="text-sm text-muted"><%= health.mongodb.connections %> / <%= health.mongodb.maxConnections %></span>
                </div>
                <div class="progress-bar h-3">
                    <div class="progress-fill bg-green-500" style="width: <%= health.mongodb.connections / health.mongodb.maxConnections * 100 %>%"></div>
                </div>
                <p class="text-xs text-muted mt-2">Pool: <%= health.mongodb.poolSize %></p>
            </div>
            
            <div>
                <div class="flex justify-between mb-2">
                    <span class="text-sm">Redis</span>
                    <span class="text-sm text-muted"><%= health.redis.connected ? 'Connected' : 'Disconnected' %></span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full <%= health.redis.connected ? 'bg-green-500' : 'bg-red-500' %>"></div>
                    <span class="text-sm <%= health.redis.connected ? 'text-green-500' : 'text-red-500' %>">
                        <%= health.redis.status %>
                    </span>
                </div>
                <p class="text-xs text-muted mt-2">Clients: <%= health.redis.clients %></p>
            </div>
            
            <div class="pt-4 border-t border-white/10">
                <h4 class="font-medium mb-4">Queue Status</h4>
                <div class="grid grid-cols-2 gap-4">
                    <div class="p-4 rounded-xl bg-white/5">
                        <p class="text-xs text-muted">Waiting</p>
                        <p class="font-heading text-xl font-bold"><%= health.queue.waiting %></p>
                    </div>
                    <div class="p-4 rounded-xl bg-white/5">
                        <p class="text-xs text-muted">Active</p>
                        <p class="font-heading text-xl font-bold"><%= health.queue.active %></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="chart-container text-center">
        <h4 class="font-heading text-sm font-semibold mb-4">Environment</h4>
        <div class="space-y-3 text-left">
            <div class="flex justify-between p-3 rounded-lg bg-white/5">
                <span class="text-muted">Node.js</span>
                <span class="font-mono text-sm"><%= health.environment.nodeVersion %></span>
            </div>
            <div class="flex justify-between p-3 rounded-lg bg-white/5">
                <span class="text-muted">Platform</span>
                <span class="font-mono text-sm"><%= health.environment.platform %></span>
            </div>
            <div class="flex justify-between p-3 rounded-lg bg-white/5">
                <span class="text-muted">Environment</span>
                <span class="font-mono text-sm capitalize"><%= health.environment.env %></span>
            </div>
            <div class="flex justify-between p-3 rounded-lg bg-white/5">
                <span class="text-muted">Uptime</span>
                <span class="font-mono text-sm"><%= health.environment.uptime %></span>
            </div>
        </div>
    </div>
    
    <div class="chart-container text-center">
        <h4 class="font-heading text-sm font-semibold mb-4">API Keys</h4>
        <div class="space-y-3 text-left">
            <div class="flex justify-between items-center p-3 rounded-lg bg-white/5">
                <span class="text-muted">OpenAI</span>
                <span class="badge <%= health.apiKeys.openai ? 'badge-success' : 'badge-error' %>">
                    <%= health.apiKeys.openai ? 'Configured' : 'Missing' %>
                </span>
            </div>
            <div class="flex justify-between items-center p-3 rounded-lg bg-white/5">
                <span class="text-muted">Unsplash</span>
                <span class="badge <%= health.apiKeys.unsplash ? 'badge-success' : 'badge-warning' %>">
                    <%= health.apiKeys.unsplash ? 'Configured' : 'Missing' %>
                </span>
            </div>
            <div class="flex justify-between items-center p-3 rounded-lg bg-white/5">
                <span class="text-muted">News API</span>
                <span class="badge <%= health.apiKeys.newsApi ? 'badge-success' : 'badge-warning' %>">
                    <%= health.apiKeys.newsApi ? 'Configured' : 'Missing' %>
                </span>
            </div>
            <div class="flex justify-between items-center p-3 rounded-lg bg-white/5">
                <span class="text-muted">Sentry</span>
                <span class="badge <%= health.apiKeys.sentry ? 'badge-success' : 'badge-warning' %>">
                    <%= health.apiKeys.sentry ? 'Configured' : 'Missing' %>
                </span>
            </div>
        </div>
    </div>
    
    <div class="chart-container text-center">
        <h4 class="font-heading text-sm font-semibold mb-4">Cron Jobs</h4>
        <div class="space-y-3 text-left">
            <% health.cronJobs.forEach(job => { %>
                <div class="flex justify-between items-center p-3 rounded-lg bg-white/5">
                    <div>
                        <p class="text-sm"><%= job.name %></p>
                        <p class="text-xs text-muted"><%= job.schedule %></p>
                    </div>
                    <span class="badge <%= job.status === 'active' ? 'badge-success' : 'badge-warning' %>">
                        <%= job.status %>
                    </span>
                </div>
            <% }); %>
        </div>
    </div>
</div>

<div class="table-container">
    <div class="p-6 border-b border-white/10 flex items-center justify-between">
        <h3 class="font-heading text-lg font-semibold">Recent Logs</h3>
        <button onclick="clearLogs()" class="btn-secondary text-sm">Clear Logs</button>
    </div>
    <div class="max-h-96 overflow-y-auto">
        <% health.logs.forEach(log => { %>
            <div class="p-4 border-b border-white/5 flex items-start gap-4 hover:bg-white/5 transition-colors">
                <span class="font-mono text-xs text-muted whitespace-nowrap"><%= new Date(log.timestamp).toLocaleTimeString() %></span>
                <span class="badge <%= log.level === 'error' ? 'badge-error' : log.level === 'warn' ? 'badge-warning' : 'badge-info' %> text-xs">
                    <%= log.level %>
                </span>
                <span class="text-sm flex-1"><%= log.message %></span>
            </div>
        <% }); %>
    </div>
</div>

<script>
    function checkHealth() {
        fetch('/admin/api/health')
            .then(res => res.json())
            .then(data => window.location.reload())
            .catch(err => alert('Health check failed'));
    }
    
    function clearLogs() {
        if (confirm('Clear all logs?')) {
            fetch('/admin/api/logs/clear', { method: 'POST' })
                .then(() => window.location.reload());
        }
    }
</script>
