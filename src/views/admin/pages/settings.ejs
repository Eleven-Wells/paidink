<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="glass-card p-6">
        <h3 class="font-heading text-lg font-semibold mb-6">General Settings</h3>
        <div class="space-y-6">
            <div>
                <label class="block text-sm font-medium mb-2">Site Name</label>
                <input type="text" class="input-dark w-full" value="NOOK">
            </div>
            <div>
                <label class="block text-sm font-medium mb-2">Site URL</label>
                <input type="url" class="input-dark w-full" value="http://localhost:5050">
            </div>
            <div>
                <label class="block text-sm font-medium mb-2">Default Language</label>
                <select class="input-dark w-full" data-custom-select>
                    <option value="en" selected>English</option>
                    <option value="es">Spanish</option>
                </select>
            </div>
        </div>
    </div>
    
    <div class="glass-card p-6">
        <h3 class="font-heading text-lg font-semibold mb-6">Content Settings</h3>
        <div class="space-y-6">
            <div>
                <label class="block text-sm font-medium mb-2">Posts per Page</label>
                <select class="input-dark w-full" data-custom-select>
                    <option value="6">6</option>
                    <option value="12" selected>12</option>
                    <option value="24">24</option>
                    <option value="48">48</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium mb-2">Auto-generate Summaries</label>
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" class="w-5 h-5 rounded bg-white/10 border-white/20" checked>
                    <span class="text-sm">Enable AI-powered summary generation</span>
                </label>
            </div>
            <div>
                <label class="block text-sm font-medium mb-2">Featured Images</label>
                <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" class="w-5 h-5 rounded bg-white/10 border-white/20" checked>
                    <span class="text-sm">Auto-fetch from Unsplash</span>
                </label>
            </div>
        </div>
    </div>
</div>

<div class="glass-card p-6 mt-6">
    <h3 class="font-heading text-lg font-semibold mb-6">API Configuration</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            <label class="block text-sm font-medium mb-2">OpenAI API Key</label>
            <div class="relative">
                <input type="password" class="input-dark w-full pr-12" value="sk-...">
                <button class="absolute right-3 top-1/2 -translate-y-1/2 text-muted hover:text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            </div>
            <p class="text-xs text-muted mt-2">Used for content generation</p>
        </div>
        <div>
            <label class="block text-sm font-medium mb-2">Unsplash Access Key</label>
            <div class="relative">
                <input type="password" class="input-dark w-full pr-12" value="...">
                <button class="absolute right-3 top-1/2 -translate-y-1/2 text-muted hover:text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
            </div>
            <p class="text-xs text-muted mt-2">Used for featured images</p>
        </div>
    </div>
</div>

<div class="glass-card p-6 mt-6">
    <h3 class="font-heading text-lg font-semibold mb-6">Danger Zone</h3>
    <div class="flex items-center justify-between p-4 rounded-xl border border-red-500/20 bg-red-500/5">
        <div>
            <p class="font-medium text-red-400">Delete All Content</p>
            <p class="text-sm text-muted mt-1">This will permanently delete all posts and related data.</p>
        </div>
        <button class="px-6 py-3 rounded-xl bg-red-500 text-white font-semibold hover:bg-red-600 transition-colors">
            Delete All
        </button>
    </div>
</div>

<div class="mt-6 flex justify-end">
    <button class="btn-primary">Save Changes</button>
</div>
