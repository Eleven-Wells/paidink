<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-muted">Total Page Views</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-blue-400"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= analytics.totalViews.toLocaleString() %></h3>
        <p class="text-xs text-muted">
            <span class="text-green-500">↑ <%= analytics.viewsGrowth %>%</span> from last month
        </p>
    </div>
    
    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-muted">Unique Visitors</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-purple-400"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= analytics.uniqueVisitors.toLocaleString() %></h3>
        <p class="text-xs text-muted">
            <span class="text-green-500">↑ <%= analytics.visitorsGrowth %>%</span> from last month
        </p>
    </div>
    
    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-muted">Avg. Session</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-green-400"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= analytics.avgSession %></h3>
        <p class="text-xs text-muted">minutes per session</p>
    </div>
    
    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-muted">Bounce Rate</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-orange-400"><path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="m21 8-4-4-4 4"/><path d="M17 4v16"/></svg>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= analytics.bounceRate %>%</h3>
        <p class="text-xs text-muted">
            <span class="text-red-500">↑ <%= analytics.bounceChange %>%</span> from last month
        </p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="lg:col-span-2 chart-container">
        <div class="flex items-center justify-between mb-6">
            <h3 class="font-heading text-lg font-semibold">Traffic Over Time</h3>
            <div class="flex gap-2">
                <select id="timeRange" class="input-dark text-sm py-2" data-custom-select>
                    <option value="7">Last 7 days</option>
                    <option value="30">Last 30 days</option>
                    <option value="90">Last 90 days</option>
                </select>
            </div>
        </div>
        <div class="h-72 relative">
            <canvas id="trafficChart"></canvas>
        </div>
    </div>
    
    <div class="chart-container">
        <h3 class="font-heading text-lg font-semibold mb-6">Traffic Sources</h3>
        <div class="space-y-4">
            <div class="flex items-center justify-between p-3 rounded-lg bg-white/5">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-blue-500/20 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                    </div>
                    <div>
                        <p class="font-medium">Direct</p>
                        <p class="text-xs text-muted">Direct traffic</p>
                    </div>
                </div>
                <span class="font-heading text-lg font-bold"><%= analytics.sources.direct %>%</span>
            </div>
            
            <div class="flex items-center justify-between p-3 rounded-lg bg-white/5">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-green-500/20 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                    </div>
                    <div>
                        <p class="font-medium">Organic Search</p>
                        <p class="text-xs text-muted">Google, Bing</p>
                    </div>
                </div>
                <span class="font-heading text-lg font-bold"><%= analytics.sources.organic %>%</span>
            </div>
            
            <div class="flex items-center justify-between p-3 rounded-lg bg-white/5">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-purple-500/20 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </div>
                    <div>
                        <p class="font-medium">Social</p>
                        <p class="text-xs text-muted">Twitter, LinkedIn</p>
                    </div>
                </div>
                <span class="font-heading text-lg font-bold"><%= analytics.sources.social %>%</span>
            </div>
            
            <div class="flex items-center justify-between p-3 rounded-lg bg-white/5">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-orange-500/20 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    </div>
                    <div>
                        <p class="font-medium">Referral</p>
                        <p class="text-xs text-muted">Other websites</p>
                    </div>
                </div>
                <span class="font-heading text-lg font-bold"><%= analytics.sources.referral %>%</span>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="chart-container">
        <h3 class="font-heading text-lg font-semibold mb-6">Top Pages</h3>
        <div class="space-y-3">
            <% analytics.topPages.forEach((page, i) => { %>
                <div class="flex items-center gap-4 p-3 rounded-lg bg-white/5 hover:bg-white/10 transition-colors">
                    <span class="font-heading text-2xl font-bold text-muted w-8"><%= i + 1 %></span>
                    <div class="flex-1 min-w-0">
                        <a href="<%= page.path %>" class="font-medium hover:text-white transition-colors line-clamp-1"><%= page.title %></a>
                        <p class="text-xs text-muted mt-1"><%= page.views.toLocaleString() %> views</p>
                    </div>
                    <div class="text-right">
                        <span class="font-mono text-sm"><%= page.avgTime %></span>
                        <p class="text-xs text-muted">avg time</p>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
    
    <div class="chart-container">
        <h3 class="font-heading text-lg font-semibold mb-6">Top Referrers</h3>
        <div class="space-y-3">
            <% analytics.topReferrers.forEach((ref, i) => { %>
                <div class="flex items-center gap-4 p-3 rounded-lg bg-white/5 hover:bg-white/10 transition-colors">
                    <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="font-medium line-clamp-1"><%= ref.source %></p>
                        <p class="text-xs text-muted mt-1"><%= ref.sessions.toLocaleString() %> sessions</p>
                    </div>
                    <span class="font-mono text-sm text-muted"><%= ref.bounceRate %>% bounce</span>
                </div>
            <% }); %>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const trafficData = {
        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
        datasets: [{
            label: 'Page Views',
            data: [1200, 1900, 3000, 5000, 4000, 3000, 4500],
            borderColor: '#3b82f6',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            fill: true,
            tension: 0.4
        }, {
            label: 'Unique Visitors',
            data: [800, 1200, 2000, 3500, 2800, 2200, 3200],
            borderColor: '#a855f7',
            backgroundColor: 'rgba(168, 85, 247, 0.1)',
            fill: true,
            tension: 0.4
        }]
    };
    
    new Chart(document.getElementById('trafficChart'), {
        type: 'line',
        data: trafficData,
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'top',
                    labels: { color: 'rgba(255,255,255,0.6)', usePointStyle: true }
                }
            },
            scales: {
                x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: 'rgba(255,255,255,0.4)' } },
                y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: 'rgba(255,255,255,0.4)' } }
            }
        }
    });
</script>
