<form action="<%= typeof post !== 'undefined' && post._id ? '/admin/posts/' + post._id : '/admin/create-post' %>" method="POST" class="max-w-4xl">
    <% if (typeof post !== 'undefined' && post._id) { %>
    <input type="hidden" name="_method" value="PUT">
    <% } %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-6">
            <div class="glass-card p-6">
                <h3 class="font-heading text-lg font-semibold mb-6">Post Content</h3>

                <div class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium mb-2">Title</label>
                        <input type="text" name="title" class="input-dark w-full" placeholder="Enter post title" required value="<%= typeof post !== 'undefined' ? post.title : '' %>">
                    </div>

                    <div>
                        <label class="block text-sm font-medium mb-2">Summary</label>
                        <textarea name="summary" class="input-dark w-full" placeholder="Brief summary of the post" required><%= typeof post !== 'undefined' ? post.summary : '' %></textarea>
                        <p class="text-xs text-muted mt-2">Max 500 characters</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium mb-2">Content (HTML)</label>
                        <textarea name="content" id="contentEditor" class="input-dark w-full font-mono text-sm" placeholder="<h2>Introduction</h2>&#10;<p>Your content here...</p>" required style="min-height: 400px;"><%= typeof post !== 'undefined' ? post.content : '' %></textarea>
                        <p class="text-xs text-muted mt-2">HTML supported</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <div class="glass-card p-6">
                <h3 class="font-heading text-lg font-semibold mb-6">Publish</h3>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-2">Status</label>
                        <select name="status" class="input-dark w-full" data-custom-select>
                            <option value="draft">Draft</option>
                            <option value="published" <%= typeof post !== 'undefined' && post.publishedAt ? 'selected' : '' %>>Published</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium mb-2">Publish Date</label>
                        <input type="datetime-local" name="publishedAt" class="input-dark w-full" value="<%= typeof post !== 'undefined' && post.publishedAt ? new Date(post.publishedAt).toISOString().slice(0, 16) : new Date().toISOString().slice(0, 16) %>">
                    </div>

                    <div class="pt-4 flex gap-3">
                        <button type="submit" class="btn-primary flex-1"><%= typeof post !== 'undefined' && post._id ? 'Update Post' : 'Save Post' %></button>
                    </div>
                </div>
            </div>
            
            <div class="glass-card p-6">
                <h3 class="font-heading text-lg font-semibold mb-6">Category & Tags</h3>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-2">Category</label>
                        <select name="category" class="input-dark w-full" required data-custom-select>
                            <option value="">Select category</option>
                            <option value="javascript" <%= typeof post !== 'undefined' && post.category === 'javascript' ? 'selected' : '' %>>JavaScript</option>
                            <option value="backend" <%= typeof post !== 'undefined' && post.category === 'backend' ? 'selected' : '' %>>Backend</option>
                            <option value="ai-tools" <%= typeof post !== 'undefined' && post.category === 'ai-tools' ? 'selected' : '' %>>AI Tools</option>
                            <option value="devops" <%= typeof post !== 'undefined' && post.category === 'devops' ? 'selected' : '' %>>DevOps</option>
                            <option value="performance" <%= typeof post !== 'undefined' && post.category === 'performance' ? 'selected' : '' %>>Performance</option>
                            <option value="career" <%= typeof post !== 'undefined' && post.category === 'career' ? 'selected' : '' %>>Career</option>
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium mb-2">Tags</label>
                        <input type="text" name="tags" class="input-dark w-full" placeholder="javascript, react, nodejs" value="<%= typeof post !== 'undefined' && post.tags ? post.tags.join(', ') : '' %>">
                        <p class="text-xs text-muted mt-2">Comma separated</p>
                    </div>
                </div>
            </div>
            
            <div class="glass-card p-6">
                <h3 class="font-heading text-lg font-semibold mb-6">Featured Image</h3>
                
                <div class="space-y-4">
                    <div class="border-2 border-dashed border-white/20 rounded-xl p-6 text-center hover:border-white/40 transition-colors cursor-pointer" id="imageDropzone">
                        <input type="hidden" name="image" id="imageInput" value="<%= typeof post !== 'undefined' ? post.image : '' %>">
                        <div id="imagePreviewContainer">
                            <% if (typeof post !== 'undefined' && post.image) { %>
                                <img src="<%= post.image %>" alt="" class="w-full h-40 object-cover rounded-lg mb-3">
                            <% } else { %>
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-muted mb-3"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                                <p class="text-sm text-muted">Drop image here or click to upload</p>
                            <% } %>
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium mb-2">Or enter image URL</label>
                        <input type="url" id="imageUrlInput" class="input-dark w-full" placeholder="https://..." value="<%= typeof post !== 'undefined' ? post.image : '' %>">
                    </div>
                </div>
            </div>
            
            <div class="glass-card p-6">
                <h3 class="font-heading text-lg font-semibold mb-6">SEO</h3>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-2">Meta Description</label>
                        <textarea name="metaDescription" class="input-dark w-full" placeholder="SEO meta description" style="min-height: 100px;"><%= typeof post !== 'undefined' ? post.metaDescription : '' %></textarea>
                        <p class="text-xs text-muted mt-2">Max 200 characters</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
