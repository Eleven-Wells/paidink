<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0 3-3z"/></svg>
            </div>
            <span class="badge badge-success">+<%= stats.postsThisWeek %></span>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= stats.totalPosts %></h3>
        <p class="text-muted text-sm">Total Posts</p>
        <div class="mt-4">
            <div class="flex justify-between text-xs text-muted mb-1">
                <span>Published</span>
                <span><%= stats.publishedPosts %></span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill bg-green-500" style="width: <%= Math.round((stats.publishedPosts / stats.totalPosts) * 100) %>%"></div>
            </div>
        </div>
    </div>
    
    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            </div>
            <span class="badge badge-info">This Month</span>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= stats.viewsThisMonth.toLocaleString() %></h3>
        <p class="text-muted text-sm">Page Views</p>
        <p class="text-xs text-muted mt-2">
            <span class="text-green-500">↑ <%= stats.viewsGrowth %>%</span> vs last month
        </p>
    </div>
    
    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a855f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <span class="badge badge-info">Active</span>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= stats.activeUsers %></h3>
        <p class="text-muted text-sm">Active Users</p>
        <p class="text-xs text-muted mt-2">Real-time visitors</p>
    </div>
    
    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-orange-500/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4"/><path d="m16.2 7.8 2.9-2.9"/><path d="M18 12h4"/><path d="m16.2 16.2 2.9 2.9"/><path d="M12 18v4"/><path d="m4.9 19.1 2.9-2.9"/><path d="M2 12h4"/><path d="m4.9 4.9 2.9 2.9"/></svg>
            </div>
            <span class="badge <%= stats.queueWaiting > 50 ? 'badge-warning' : 'badge-success' %>"><%= stats.queueWaiting %></span>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= stats.queueActive %></h3>
        <p class="text-muted text-sm">Jobs Running</p>
        <p class="text-xs text-muted mt-2">
            <%= stats.queueCompleted %> completed today
        </p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="lg:col-span-2 chart-container">
        <div class="flex items-center justify-between mb-6">
            <h3 class="font-heading text-lg font-semibold">Traffic Overview</h3>
            <select class="input-dark text-sm py-2" data-custom-select>
                <option>Last 7 days</option>
                <option>Last 30 days</option>
                <option>Last 90 days</option>
            </select>
        </div>
        <div class="h-64 flex items-end justify-between gap-2">
            <% const dailyData = stats.dailyViews || []; %>
            <% dailyData.forEach((d) => { %>
                <div class="flex-1 flex flex-col items-center gap-2">
                    <div class="w-full bg-white/10 rounded-t-lg relative group" style="height: <%= d.percentage %>%">
                        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-black rounded text-xs opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
                            <%= d.views %> views
                        </div>
                    </div>
                    <span class="text-xs text-muted"><%= d.day %></span>
                </div>
            <% }); %>
        </div>
    </div>
    
    <div class="chart-container">
        <h3 class="font-heading text-lg font-semibold mb-6">Posts by Category</h3>
        <div class="space-y-4">
            <% const catData = [
                { name: 'JavaScript', count: stats.categoryStats.javascript, color: 'bg-yellow-500' },
                { name: 'Backend', count: stats.categoryStats.backend, color: 'bg-blue-500' },
                { name: 'AI Tools', count: stats.categoryStats.aiTools, color: 'bg-purple-500' },
                { name: 'DevOps', count: stats.categoryStats.devops, color: 'bg-orange-500' },
                { name: 'Performance', count: stats.categoryStats.performance, color: 'bg-green-500' }
            ]; %>
            <% const maxCount = Math.max(...catData.map(c => c.count), 1); %>
            <% catData.forEach(cat => { %>
                <div>
                    <div class="flex justify-between text-sm mb-2">
                        <span><%= cat.name %></span>
                        <span class="text-muted"><%= cat.count %></span>
                    </div>
                    <div class="progress-bar">
                        <div class="progress-fill <%= cat.color %>" style="width: <%= Math.round((cat.count / maxCount) * 100) %>%"></div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="table-container">
        <div class="p-6 border-b border-white/10 flex items-center justify-between">
            <h3 class="font-heading text-lg font-semibold">Recent Posts</h3>
            <a href="/admin/posts" class="text-sm text-muted hover:text-white transition-colors">View All →</a>
        </div>
        <div class="divide-y divide-white/5">
            <% recentPosts.forEach(post => { %>
                <div class="table-row p-4 flex items-center gap-4">
                    <div class="w-16 h-12 rounded-lg bg-white/5 overflow-hidden flex-shrink-0">
                        <img src="<%= post.image || '/public/images/placeholder.jpg' %>" alt="" class="w-full h-full object-cover">
                    </div>
                    <div class="flex-1 min-w-0">
                        <a href="/admin/posts/<%= post._id %>" class="font-medium hover:text-white transition-colors line-clamp-1"><%= post.title %></a>
                        <p class="text-xs text-muted mt-1">
                            <span class="badge badge-info"><%= post.category %></span>
                            <span class="ml-2"><%= new Date(post.publishedAt).toLocaleDateString() %></span>
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="/post/<%= post.slug %>" target="_blank" class="action-btn text-muted hover:text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                        </a>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
    
    <div class="table-container">
        <div class="p-6 border-b border-white/10 flex items-center justify-between">
            <h3 class="font-heading text-lg font-semibold">Queue Activity</h3>
            <a href="/admin/jobs" class="text-sm text-muted hover:text-white transition-colors">View All →</a>
        </div>
        <div class="p-6 space-y-4">
            <div class="flex items-center justify-between p-4 rounded-xl bg-white/5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-green-500/20 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                    <div>
                        <p class="font-medium">Completed</p>
                        <p class="text-xs text-muted">Today</p>
                    </div>
                </div>
                <span class="font-heading text-2xl font-bold text-green-500"><%= stats.queueCompleted %></span>
            </div>
            
            <div class="flex items-center justify-between p-4 rounded-xl bg-white/5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-blue-500/20 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </div>
                    <div>
                        <p class="font-medium">In Progress</p>
                        <p class="text-xs text-muted">Active jobs</p>
                    </div>
                </div>
                <span class="font-heading text-2xl font-bold text-blue-500"><%= stats.queueActive %></span>
            </div>
            
            <div class="flex items-center justify-between p-4 rounded-xl bg-white/5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-yellow-500/20 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                    </div>
                    <div>
                        <p class="font-medium">Waiting</p>
                        <p class="text-xs text-muted">In queue</p>
                    </div>
                </div>
                <span class="font-heading text-2xl font-bold text-yellow-500"><%= stats.queueWaiting %></span>
            </div>
            
            <div class="flex items-center justify-between p-4 rounded-xl bg-white/5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-red-500/20 flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></svg>
                    </div>
                    <div>
                        <p class="font-medium">Failed</p>
                        <p class="text-xs text-muted">Today</p>
                    </div>
                </div>
                <span class="font-heading text-2xl font-bold text-red-500"><%= stats.queueFailed %></span>
            </div>
        </div>
    </div>
</div>
