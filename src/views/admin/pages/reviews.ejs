<%
    const safeRating = filters && filters.rating ? String(filters.rating) : '';
    const safeStatus = filters && filters.status ? String(filters.status) : '';
    function reviewerName(review) {
        if (!review.user) return 'Unknown tester';
        return review.user.displayName || review.user.username || review.user.email || 'Unknown tester';
    }
    function reviewerHandle(review) {
        if (!review.user) return '';
        if (review.user.username) return '@' + review.user.username;
        return review.user.email || '';
    }
    function ratingLabel(value) {
        return (Number(value) || 0).toFixed(1).replace('.0', '');
    }
    function deliveryClass(status) {
        if (status === 'sent') return 'badge-success';
        if (status === 'failed') return 'badge-error';
        if (status === 'skipped') return 'badge-warning';
        return 'badge-info';
    }
    function queryFor(nextPage) {
        const params = [];
        if (safeRating) params.push('rating=' + encodeURIComponent(safeRating));
        if (safeStatus) params.push('status=' + encodeURIComponent(safeStatus));
        params.push('page=' + encodeURIComponent(nextPage));
        return '/admin/reviews?' + params.join('&');
    }
%>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
            </div>
            <span class="badge badge-info">All time</span>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= stats.totalReviews %></h3>
        <p class="text-muted text-sm">Total Reviews</p>
    </div>

    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-yellow-500/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="1.5"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z"/></svg>
            </div>
            <span class="badge badge-warning">Average</span>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= ratingLabel(stats.averageRating) %>/5</h3>
        <p class="text-muted text-sm">Tester Rating</p>
    </div>

    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-green-500/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M22 2 11 13"/><path d="m22 2-7 20-4-9-9-4Z"/></svg>
            </div>
            <span class="badge badge-success">Discord</span>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= stats.sentToDiscord %></h3>
        <p class="text-muted text-sm">Sent to Channel</p>
    </div>

    <div class="stat-card">
        <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-red-500/10 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
            </div>
            <span class="badge <%= stats.failedDiscord > 0 ? 'badge-error' : 'badge-success' %>">Webhook</span>
        </div>
        <h3 class="font-heading text-3xl font-bold mb-1"><%= stats.failedDiscord %></h3>
        <p class="text-muted text-sm">Discord Failures</p>
    </div>
</div>

<div class="glass-card p-6 mb-6">
    <form action="/admin/reviews" method="GET" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
        <div>
            <label class="block text-sm font-medium mb-2">Rating</label>
            <select name="rating" class="input-dark w-full">
                <option value="" <%= !safeRating ? 'selected' : '' %>>All ratings</option>
                <% [5, 4, 3, 2, 1].forEach(function(value) { %>
                    <option value="<%= value %>" <%= safeRating === String(value) ? 'selected' : '' %>><%= value %>/5</option>
                <% }); %>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium mb-2">Discord Status</label>
            <select name="status" class="input-dark w-full">
                <option value="" <%= !safeStatus ? 'selected' : '' %>>All statuses</option>
                <% ['sent', 'failed', 'skipped', 'pending'].forEach(function(value) { %>
                    <option value="<%= value %>" <%= safeStatus === value ? 'selected' : '' %>><%= value.charAt(0).toUpperCase() + value.slice(1) %></option>
                <% }); %>
            </select>
        </div>
        <div class="flex gap-3">
            <button type="submit" class="btn-primary flex-1">Apply Filters</button>
            <a href="/admin/reviews" class="px-5 py-3 rounded-xl bg-white/5 text-sm font-semibold text-muted hover:text-white hover:bg-white/10 transition-colors">Reset</a>
        </div>
    </form>
</div>

<div class="table-container overflow-hidden">
    <div class="p-6 border-b border-white/10 flex items-center justify-between gap-4">
        <div>
            <h3 class="font-heading text-lg font-semibold">Tester Reviews</h3>
            <p class="text-sm text-muted mt-1"><%= pagination.total %> matching review<%= pagination.total === 1 ? '' : 's' %></p>
        </div>
        <% if (!discordWebhookConfigured) { %>
            <span class="badge badge-warning">Discord webhook not configured</span>
        <% } %>
    </div>

    <% if (reviews && reviews.length > 0) { %>
        <div class="divide-y divide-white/5">
            <% reviews.forEach(function(review) { %>
                <% const deliveryStatus = review.discordDelivery?.status || 'pending'; %>
                <article class="p-5 hover:bg-white/5 transition-colors">
                    <div class="flex flex-col xl:flex-row xl:items-start gap-4">
                        <div class="xl:w-64 flex-shrink-0">
                            <div class="flex items-center gap-3">
                                <div class="w-11 h-11 rounded-full bg-white/10 flex items-center justify-center border border-white/10">
                                    <span class="text-sm font-semibold"><%= reviewerName(review).charAt(0).toUpperCase() %></span>
                                </div>
                                <div class="min-w-0">
                                    <p class="font-medium truncate"><%= reviewerName(review) %></p>
                                    <p class="text-xs text-muted truncate"><%= reviewerHandle(review) || 'No handle' %></p>
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-2 mt-4">
                                <span class="badge badge-warning"><%= review.rating %>/5</span>
                                <span class="badge <%= deliveryClass(deliveryStatus) %>">Discord: <%= deliveryStatus %></span>
                            </div>
                        </div>

                        <div class="flex-1 min-w-0">
                            <p class="text-white/90 leading-relaxed whitespace-pre-wrap"><%= review.feedback %></p>
                            <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-3 text-xs text-muted">
                                <div>
                                    <span class="block uppercase tracking-widest text-muted-dark mb-1">Submitted</span>
                                    <span><%= new Date(review.createdAt).toLocaleString() %></span>
                                </div>
                                <div>
                                    <span class="block uppercase tracking-widest text-muted-dark mb-1">Page</span>
                                    <span><%= review.context?.path || 'Unknown page' %></span>
                                </div>
                                <div>
                                    <span class="block uppercase tracking-widest text-muted-dark mb-1">Discord</span>
                                    <% if (deliveryStatus === 'sent' && review.discordDelivery?.sentAt) { %>
                                        <span>Sent <%= new Date(review.discordDelivery.sentAt).toLocaleString() %></span>
                                    <% } else if (deliveryStatus === 'failed') { %>
                                        <span class="text-red-300"><%= review.discordDelivery?.error || 'Webhook failed' %></span>
                                    <% } else if (deliveryStatus === 'skipped') { %>
                                        <span>Webhook not configured</span>
                                    <% } else { %>
                                        <span>Pending</span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            <% }); %>
        </div>
    <% } else { %>
        <div class="p-12 text-center">
            <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center mx-auto mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
            </div>
            <h3 class="font-heading text-xl font-semibold">No reviews yet</h3>
            <p class="text-muted mt-2">When testers leave feedback from the app, it will appear here.</p>
        </div>
    <% } %>
</div>

<% if (pagination.totalPages > 1) { %>
    <div class="mt-6 flex items-center justify-between">
        <p class="text-sm text-muted">Page <%= pagination.page %> of <%= pagination.totalPages %></p>
        <div class="flex gap-3">
            <% if (pagination.hasPrev) { %>
                <a href="<%= queryFor(pagination.page - 1) %>" class="px-5 py-3 rounded-xl bg-white/5 text-sm font-semibold text-muted hover:text-white hover:bg-white/10 transition-colors">Previous</a>
            <% } %>
            <% if (pagination.hasNext) { %>
                <a href="<%= queryFor(pagination.page + 1) %>" class="px-5 py-3 rounded-xl bg-white/5 text-sm font-semibold text-muted hover:text-white hover:bg-white/10 transition-colors">Next</a>
            <% } %>
        </div>
    </div>
<% } %>
