<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="stat-card flex items-center gap-4">
        <div class="w-14 h-14 rounded-xl bg-green-500/10 flex items-center justify-center">
            <span class="font-heading text-2xl font-bold text-green-500"><%= performance.responseTime %><span class="text-sm">ms</span></span>
        </div>
        <div>
            <p class="text-sm text-muted">Avg Response</p>
            <p class="text-xs text-muted">Last 24h</p>
        </div>
    </div>
    
    <div class="stat-card flex items-center gap-4">
        <div class="w-14 h-14 rounded-xl bg-blue-500/10 flex items-center justify-center">
            <span class="font-heading text-2xl font-bold text-blue-500"><%= performance.uptime %>%</span>
        </div>
        <div>
            <p class="text-sm text-muted">Uptime</p>
            <p class="text-xs text-muted">Last 30 days</p>
        </div>
    </div>
    
    <div class="stat-card flex items-center gap-4">
        <div class="w-14 h-14 rounded-xl bg-purple-500/10 flex items-center justify-center">
            <span class="font-heading text-2xl font-bold text-purple-500"><%= performance.requests %><span class="text-sm">/s</span></span>
        </div>
        <div>
            <p class="text-sm text-muted">Requests/sec</p>
            <p class="text-xs text-muted">Current</p>
        </div>
    </div>
    
    <div class="stat-card flex items-center gap-4">
        <div class="w-14 h-14 rounded-xl bg-orange-500/10 flex items-center justify-center">
            <span class="font-heading text-2xl font-bold text-orange-500"><%= performance.memoryUsage %>%</span>
        </div>
        <div>
            <p class="text-sm text-muted">Memory</p>
            <p class="text-xs text-muted">Used</p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="chart-container">
        <h3 class="font-heading text-lg font-semibold mb-6">Response Time</h3>
        <div class="h-64">
            <canvas id="responseTimeChart"></canvas>
        </div>
    </div>
    
    <div class="chart-container">
        <h3 class="font-heading text-lg font-semibold mb-6">Memory Usage</h3>
        <div class="h-64 flex items-center justify-center">
            <div class="relative w-48 h-48">
                <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="12"/>
                    <circle cx="50" cy="50" r="40" fill="none" stroke="#8b5cf6" stroke-width="12" 
                            stroke-dasharray="<%= performance.memoryUsage * 2.51 %> 251" stroke-linecap="round"/>
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="font-heading text-4xl font-bold"><%= performance.memoryUsage %>%</span>
                    <span class="text-sm text-muted">Used</span>
                </div>
            </div>
            <div class="ml-8 space-y-4">
                <div>
                    <div class="flex justify-between text-sm mb-1">
                        <span>Heap Used</span>
                        <span class="text-muted"><%= performance.heapUsed %> MB</span>
                    </div>
                    <div class="progress-bar w-32">
                        <div class="progress-fill bg-purple-500" style="width: <%= performance.heapUsed / performance.heapTotal * 100 %>%"></div>
                    </div>
                </div>
                <div>
                    <div class="flex justify-between text-sm mb-1">
                        <span>RSS</span>
                        <span class="text-muted"><%= performance.rss %> MB</span>
                    </div>
                    <div class="progress-bar w-32">
                        <div class="progress-fill bg-blue-500" style="width: <%= performance.rss / performance.memoryTotal * 100 %>%"></div>
                    </div>
                </div>
                <div>
                    <div class="flex justify-between text-sm mb-1">
                        <span>External</span>
                        <span class="text-muted"><%= performance.external %> MB</span>
                    </div>
                    <div class="progress-bar w-32">
                        <div class="progress-fill bg-green-500" style="width: <%= performance.external / performance.memoryTotal * 100 %>%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="chart-container">
        <h3 class="font-heading text-lg font-semibold mb-6">CPU Usage</h3>
        <div class="flex items-center justify-center py-8">
            <div class="relative w-32 h-32">
                <svg class="w-full h-full transform -rotate-90" viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="40" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="12"/>
                    <circle cx="50" cy="50" r="40" fill="none" stroke="#22c55e" stroke-width="12" 
                            stroke-dasharray="<%= performance.cpuUsage * 2.51 %> 251" stroke-linecap="round"/>
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="font-heading text-3xl font-bold"><%= performance.cpuUsage %>%</span>
                </div>
            </div>
        </div>
        <div class="grid grid-cols-3 gap-4 text-center mt-4">
            <div>
                <p class="font-heading text-lg font-bold"><%= performance.cpuCores %></p>
                <p class="text-xs text-muted">Cores</p>
            </div>
            <div>
                <p class="font-heading text-lg font-bold"><%= performance.nodeVersion %></p>
                <p class="text-xs text-muted">Node</p>
            </div>
            <div>
                <p class="font-heading text-lg font-bold">v8</p>
                <p class="text-xs text-muted">Engine</p>
            </div>
        </div>
    </div>
    
    <div class="chart-container">
        <h3 class="font-heading text-lg font-semibold mb-6">Error Rate</h3>
        <div class="space-y-6 py-4">
            <div class="text-center">
                <span class="font-heading text-5xl font-bold <%= performance.errorRate > 1 ? 'text-red-500' : 'text-green-500' %>"><%= performance.errorRate %></span>
                <p class="text-sm text-muted mt-2">errors per 1000 requests</p>
            </div>
            
            <div class="grid grid-cols-2 gap-4 pt-4 border-t border-white/10">
                <div class="text-center">
                    <p class="font-heading text-xl font-bold text-yellow-500"><%= performance.warnings %></p>
                    <p class="text-xs text-muted">Warnings</p>
                </div>
                <div class="text-center">
                    <p class="font-heading text-xl font-bold text-red-500"><%= performance.errors %></p>
                    <p class="text-xs text-muted">Errors</p>
                </div>
            </div>
        </div>
    </div>
    
    <div class="chart-container">
        <h3 class="font-heading text-lg font-semibold mb-6">API Endpoints</h3>
        <div class="space-y-3">
            <% performance.endpoints.forEach(endpoint => { %>
                <div class="flex items-center justify-between p-3 rounded-lg bg-white/5">
                    <div>
                        <p class="font-mono text-sm"><%= endpoint.path %></p>
                        <p class="text-xs text-muted mt-1"><%= endpoint.method %> - <%= endpoint.avgTime %>ms avg</p>
                    </div>
                    <span class="badge <%= endpoint.status === 'healthy' ? 'badge-success' : 'badge-warning' %>">
                        <%= endpoint.status %>
                    </span>
                </div>
            <% }); %>
        </div>
    </div>
</div>

<div class="table-container">
    <div class="p-6 border-b border-white/10">
        <h3 class="font-heading text-lg font-semibold">Recent Events</h3>
    </div>
    <div class="divide-y divide-white/5">
        <% performance.events.forEach(event => { %>
            <div class="p-4 flex items-center gap-4">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center <%= event.type === 'error' ? 'bg-red-500/20' : event.type === 'warning' ? 'bg-yellow-500/20' : 'bg-blue-500/20' %>">
                    <% if (event.type === 'error') { %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" x2="9" y1="9" y2="15"/><line x1="9" x2="15" y1="9" y2="15"/></svg>
                    <% } else if (event.type === 'warning') { %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
                    <% } else { %>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                    <% } %>
                </div>
                <div class="flex-1">
                    <p class="font-medium"><%= event.message %></p>
                    <p class="text-xs text-muted mt-1"><%= event.source %></p>
                </div>
                <span class="text-xs text-muted"><%= new Date(event.timestamp).toLocaleString() %></span>
            </div>
        <% }); %>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    new Chart(document.getElementById('responseTimeChart'), {
        type: 'line',
        data: {
            labels: ['00:00', '04:00', '08:00', '12:00', '16:00', '20:00', '24:00'],
            datasets: [{
                label: 'Response Time (ms)',
                data: [45, 52, 78, 95, 68, 55, 48],
                borderColor: '#3b82f6',
                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: 'rgba(255,255,255,0.4)' } },
                y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: 'rgba(255,255,255,0.4)' } }
            }
        }
    });
</script>
