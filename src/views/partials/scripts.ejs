<%- include('nook-alert') %>
<script defer src="/public/js/nook-alert.js"></script>
<script defer src="/public/js/theme.js"></script>
<script defer src="/public/js/search.js"></script>
<script defer src="/public/js/post-actions.js"></script>
<script defer src="/public/js/translation.js"></script>
<script defer src="/public/js/subscribe.js"></script>
<script defer src="/public/js/loadMore.js"></script>

<script>
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            const menu = document.getElementById('mobileMenu');
            const overlay = document.getElementById('mobileOverlay');
            menu?.classList.remove('active');
            overlay?.classList.remove('active');
            document.body.style.overflow = '';
            const pubSide = document.getElementById('publisherSidebar');
            const pubOver = document.getElementById('publisherSidebarOverlay');
            pubSide?.classList.remove('is-open');
            pubOver?.classList.remove('is-open');
            const pubBtn = document.getElementById('publisherMenuBtn');
            pubBtn?.setAttribute('aria-expanded', 'false');
        }
    });

    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            const href = this.getAttribute('href');
            if (href && href !== '#') {
                e.preventDefault();
                const target = document.querySelector(href);
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        });
    });

    if (typeof isLoggedIn !== 'undefined' && isLoggedIn) {
        (function() {
            var es = new EventSource('/api/notifications/stream');
            var retryCount = 0;

            es.addEventListener('notification', function(e) {
                try {
                    var data = JSON.parse(e.data);
                    if (data.title && data.message && typeof showToast === 'function') {
                        showToast(data.message, 'info');
                    }
                    if (typeof hapticEnabled !== 'undefined' && hapticEnabled && navigator.vibrate) {
                        navigator.vibrate(40);
                    }
                } catch (err) {
                    console.error('SSE notification parse error:', err);
                }
            });

            es.addEventListener('connected', function() {
                retryCount = 0;
            });

            es.onerror = function() {
                retryCount++;
                if (retryCount > 5) {
                    es.close();
                }
            };
        })();
    }
</script>
