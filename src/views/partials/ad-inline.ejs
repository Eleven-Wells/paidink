<% if (typeof ad !== 'undefined' && ad && ad.served) { %>
<div class="inline-ad-container">
    <div class="inline-ad-label">Advertisement</div>
    <div class="inline-ad-content">
        <% if (ad.imageUrl) { %>
            <img src="<%= ad.imageUrl %>" alt="Sponsored content" loading="lazy" decoding="async" />
        <% } else { %>
            <svg width="100%" height="90" viewBox="0 0 728 90" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="728" height="90" fill="#2563eb" fill-opacity="0.03"/>
                <text x="364" y="45" text-anchor="middle" dominant-baseline="middle" fill="#2563eb" font-size="13" font-family="system-ui">Sponsored Content</text>
                <text x="364" y="62" text-anchor="middle" dominant-baseline="middle" fill="#6b7280" font-size="10" font-family="system-ui">728 x 90</text>
            </svg>
        <% } %>
    </div>
    <a href="<%= ad.clickUrl %>" class="inline-ad-cta" target="_blank" rel="sponsored noopener">Learn More</a>
</div>
<% } %>
