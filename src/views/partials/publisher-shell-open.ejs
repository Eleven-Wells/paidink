<% var pubPage = typeof currentPage !== 'undefined' ? currentPage : ''; %>
<%- include('./publisher-css') %>
<div class="publisher-workspace">
    <%# Overlay must stay inside workspace so z-index stacks above .publisher-main but below .publisher-sidebar %>
    <div class="publisher-sidebar-overlay" id="publisherSidebarOverlay" aria-hidden="true"></div>
    <aside class="publisher-sidebar" id="publisherSidebar" aria-label="Publisher navigation">
        <div class="publisher-brand">
            <a href="/publisher" aria-label="Publisher home" class="publisher-logo">
                PaidInk
            </a>
        </div>
        <nav class="publisher-nav" role="navigation">
            <div class="publisher-nav-label">Workspace</div>
            <a href="/publisher" class="<%= pubPage === 'dashboard' ? 'is-active' : '' %>">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h7v7H4V6zm9 0h7v7h-7V6zM4 15h7v5H4v-5zm9 0h7v5h-7v-5z"/></svg>
                Overview
            </a>
            <a href="/publisher/posts" class="<%= pubPage === 'posts' ? 'is-active' : '' %>">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                Posts
            </a>
            <a href="/publisher/create-post" class="<%= pubPage === 'create' ? 'is-active' : '' %>">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                Editor
            </a>
            <a href="/publisher/earnings" class="<%= pubPage === 'earnings' ? 'is-active' : '' %>">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Earnings
            </a>
            <div class="publisher-nav-label">Account</div>
            <a href="/">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                Site
            </a>
            <a href="/dashboard">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                Reader hub
            </a>
            <a href="/profile">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Profile
            </a>
        </nav>
    </aside>
    <div class="publisher-main">
        <header class="publisher-topbar">
            <div style="display:flex;align-items:center;gap:0.75rem;flex:1;min-width:0;">
                <button type="button" class="publisher-menu-btn" id="publisherMenuBtn" aria-controls="publisherSidebar" aria-expanded="false" aria-label="Open menu">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>
                <div style="min-width:0;">
                    <div class="publisher-page-eyebrow">PaidInk</div>
                    <h1 class="publisher-page-title" style="margin:0;"><%= typeof pageHeading !== 'undefined' ? pageHeading : 'Publisher' %></h1>
                    <% if (typeof pageSubtitle !== 'undefined' && pageSubtitle) { %>
                        <p class="publisher-page-sub"><%= pageSubtitle %></p>
                    <% } %>
                </div>
            </div>
            <% if (typeof showNewPostCta !== 'undefined' && showNewPostCta) { %>
                <div style="flex-shrink:0;">
                    <a href="/publisher/create-post" class="publisher-btn-primary">New post</a>
                </div>
            <% } %>
        </header>
