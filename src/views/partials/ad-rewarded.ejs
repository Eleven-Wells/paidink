<% if (typeof ad !== 'undefined' && ad && ad.served) { %>
<div class="rewarded-ad-section">
    <div class="rewarded-ad-header">
        <div class="rewarded-ad-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="6"/>
                <path d="M12 14v8M8 18h8"/>
            </svg>
        </div>
        <div>
            <h3 class="rewarded-ad-title">Earn Rewards</h3>
            <p class="rewarded-ad-subtitle">Watch a sponsored video and earn tokens</p>
        </div>
    </div>
    <div class="rewarded-ad-preview">
        <svg width="100%" height="180" viewBox="0 0 400 180" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="400" height="180" fill="#f59e0b" fill-opacity="0.05"/>
            <rect x="20" y="20" width="360" height="140" rx="8" stroke="#f59e0b" stroke-width="1" stroke-dasharray="4 4" fill="none"/>
            <text x="200" y="80" text-anchor="middle" dominant-baseline="middle" fill="#f59e0b" font-size="16" font-family="system-ui" font-weight="600">Watch & Earn</text>
            <text x="200" y="105" text-anchor="middle" dominant-baseline="middle" fill="#6b7280" font-size="12" font-family="system-ui">Complete a short ad to earn rewards</text>
        </svg>
    </div>
    <button class="rewarded-ad-btn" onclick="window.open('<%= ad.clickUrl %>', '_blank')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
        Watch Now
    </button>
</div>
<% } %>
