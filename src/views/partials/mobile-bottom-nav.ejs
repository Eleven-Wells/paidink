<% var navTheme = (typeof theme !== 'undefined' ? theme : 'light'); %>
<nav class="mobile-bottom-nav <%= navTheme === 'dark' ? 'mobile-bottom-nav-dark' : '' %>" aria-label="Mobile navigation">
    <a href="/" class="bottom-nav-item <%= currentPage === 'home' ? 'bottom-nav-item-active' : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Home</span>
    </a>
    <a href="/browse" class="bottom-nav-item <%= currentPage === 'explore' ? 'bottom-nav-item-active' : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
        </svg>
        <span>Explore</span>
    </a>
    <a href="/activity" class="bottom-nav-item <%= currentPage === 'activity' ? 'bottom-nav-item-active' : '' %>" style="position: relative;">
        <span style="position: relative; display: inline-flex;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/>
            </svg>
            <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                <span class="mobile-nav-badge" style="position: absolute; top: -4px; right: -6px; display: inline-flex; align-items: center; justify-content: center; min-width: 14px; height: 14px; padding: 0 3px; border-radius: 7px; background: #6d0a0a; color: #fff; font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 700;"><%= unreadCount > 99 ? '99+' : unreadCount %></span>
            <% } %>
        </span>
        <span>Activity</span>
    </a>
    <a href="/dashboard" class="bottom-nav-item <%= currentPage === 'dashboard' ? 'bottom-nav-item-active' : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
        </svg>
        <span>Dashboard</span>
    </a>
    <a href="/profile" class="bottom-nav-item <%= currentPage === 'profile' ? 'bottom-nav-item-active' : '' %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
        </svg>
        <span>Profile</span>
    </a>
</nav>

<style>
    .mobile-bottom-nav {
        display: none;
    }

    @media (max-width: 1024px) {
        .mobile-bottom-nav {
            display: flex;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 64px;
            background: #fff;
            border-top: 1px solid rgba(109,10,10,0.1);
            align-items: center;
            justify-content: space-around;
            z-index: 100;
            padding: 0 8px;
            padding-bottom: env(safe-area-inset-bottom);
        }

        .bottom-nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            text-decoration: none;
            color: #000;
            font-family: 'Abhaya Libre', serif;
            font-size: 12px;
            padding: 8px 12px;
            border-radius: 12px;
            transition: color 0.2s, background 0.2s;
        }

        .bottom-nav-item:hover,
        .bottom-nav-item:focus {
            color: #6d0a0a;
            background: rgba(109,10,10,0.05);
        }

        .bottom-nav-item-active {
            color: #6d0a0a;
            font-weight: 600;
        }

        .bottom-nav-item svg {
            width: 24px;
            height: 24px;
        }

        .mobile-bottom-nav-dark {
            background: rgba(16, 16, 16, 0.95);
            border-top-color: rgba(255,255,255,0.1);
        }

        .mobile-bottom-nav-dark .bottom-nav-item {
            color: rgba(255,255,255,0.7);
        }

        .mobile-bottom-nav-dark .bottom-nav-item:hover,
        .mobile-bottom-nav-dark .bottom-nav-item:focus {
            color: #fff;
            background: rgba(255,255,255,0.08);
        }

        .mobile-bottom-nav-dark .bottom-nav-item-active {
            color: #fff;
            font-weight: 600;
        }
    }
</style>
