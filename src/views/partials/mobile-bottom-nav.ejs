<% var navTheme = (typeof theme !== 'undefined' ? theme : 'light'); %>
<nav class="mobile-bottom-nav <%= navTheme === 'dark' ? 'mobile-bottom-nav-dark' : '' %>" aria-label="Mobile navigation">
    <a href="/" class="bottom-nav-item <%= currentPage === 'home' ? 'bottom-nav-item-active' : '' %>">
        <%- include('./animated-nav-icon', { icon: 'home', size: 24 }) %>
        <span>Home</span>
    </a>
    <a href="/browse" class="bottom-nav-item <%= currentPage === 'explore' ? 'bottom-nav-item-active' : '' %>">
        <%- include('./animated-nav-icon', { icon: 'explore', size: 24 }) %>
        <span>Explore</span>
    </a>
    <a href="/activity" class="bottom-nav-item <%= currentPage === 'activity' ? 'bottom-nav-item-active' : '' %>" style="position: relative;">
        <span style="position: relative; display: inline-flex;">
            <%- include('./animated-nav-icon', { icon: 'activity', size: 24 }) %>
            <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                <span class="mobile-nav-badge" style="position: absolute; top: -4px; right: -6px; display: inline-flex; align-items: center; justify-content: center; min-width: 14px; height: 14px; padding: 0 3px; border-radius: 7px; background: #6d0a0a; color: #fff; font-family: 'Inter', sans-serif; font-size: 9px; font-weight: 700;"><%= unreadCount > 99 ? '99+' : unreadCount %></span>
            <% } %>
        </span>
        <span>Activity</span>
    </a>
    <a href="/dashboard" class="bottom-nav-item <%= currentPage === 'dashboard' ? 'bottom-nav-item-active' : '' %>">
        <%- include('./animated-nav-icon', { icon: 'dashboard', size: 24 }) %>
        <span>Dashboard</span>
    </a>
    <a href="/profile" class="bottom-nav-item <%= currentPage === 'profile' ? 'bottom-nav-item-active' : '' %>">
        <%- include('./animated-nav-icon', { icon: 'profile', size: 24 }) %>
        <span>Profile</span>
    </a>
</nav>

<style>
    .mobile-bottom-nav {
        display: none;
    }

    @media (max-width: 1024px) {
        body {
            padding-bottom: calc(104px + env(safe-area-inset-bottom));
        }

        .mobile-bottom-nav {
            display: flex;
            position: fixed;
            left: 10px;
            right: 10px;
            left: max(10px, env(safe-area-inset-left));
            right: max(10px, env(safe-area-inset-right));
            bottom: calc(14px + env(safe-area-inset-bottom));
            width: auto;
            max-width: 430px;
            margin: 0 auto;
            min-height: 66px;
            background: rgba(255, 253, 251, 0.92);
            border: 1px solid rgba(109, 10, 10, 0.12);
            border-radius: 999px;
            align-items: center;
            justify-content: space-between;
            z-index: 9999;
            padding: 7px;
            box-sizing: border-box;
            overflow: hidden;
            box-shadow: 0 20px 55px rgba(31, 23, 21, 0.18), 0 6px 18px rgba(109, 10, 10, 0.12);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            transform: translate3d(0, 0, 0);
            animation: mobileDockIn 0.42s cubic-bezier(0.2, 0.85, 0.2, 1) both;
        }

        .bottom-nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            min-width: 0;
            flex: 1 1 0;
            min-height: 52px;
            text-decoration: none;
            color: rgba(31, 23, 21, 0.68);
            font-family: 'Abhaya Libre', serif;
            font-size: 11px;
            line-height: 1;
            padding: 6px 4px;
            border-radius: 999px;
            overflow: hidden;
            transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
        }

        .bottom-nav-item > span:last-child {
            display: block;
            max-width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .bottom-nav-item:hover,
        .bottom-nav-item:focus {
            color: #6d0a0a;
            background: rgba(109, 10, 10, 0.06);
            transform: translateY(-1px);
        }

        .bottom-nav-item-active {
            color: #6d0a0a;
            font-weight: 600;
            background: rgba(109, 10, 10, 0.1);
        }

        .bottom-nav-item svg {
            width: 22px;
            height: 22px;
            overflow: visible;
        }

        .animated-nav-icon {
            --nav-icon-draw: 64;
        }

        .animated-nav-icon .nav-icon-path,
        .animated-nav-icon .nav-icon-tile {
            vector-effect: non-scaling-stroke;
        }

        .animated-nav-icon-home .nav-icon-home-roof,
        .animated-nav-icon-home .nav-icon-home-frame,
        .animated-nav-icon-home .nav-icon-home-door,
        .animated-nav-icon-explore .nav-icon-compass-ring,
        .animated-nav-icon-explore .nav-icon-compass-needle,
        .animated-nav-icon-activity .nav-icon-bell-body,
        .animated-nav-icon-activity .nav-icon-bell-cap,
        .animated-nav-icon-activity .nav-icon-bell-clapper,
        .animated-nav-icon-profile .nav-icon-profile-head,
        .animated-nav-icon-profile .nav-icon-profile-shoulders {
            stroke-dasharray: var(--nav-icon-draw);
            stroke-dashoffset: 0;
        }

        .nav-icon-compass-needle,
        .nav-icon-bell-body,
        .nav-icon-bell-clapper,
        .nav-icon-profile-head,
        .nav-icon-tile {
            transform-box: fill-box;
            transform-origin: center;
        }

        .nav-icon-bell-ring,
        .nav-icon-profile-spark {
            opacity: 0;
            vector-effect: non-scaling-stroke;
        }

        .bottom-nav-item:hover .nav-icon-home-roof,
        .bottom-nav-item:focus .nav-icon-home-roof,
        .bottom-nav-item.is-pressing .nav-icon-home-roof {
            animation: navIconDraw 0.58s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        }

        .bottom-nav-item:hover .nav-icon-home-door,
        .bottom-nav-item:focus .nav-icon-home-door,
        .bottom-nav-item.is-pressing .nav-icon-home-door {
            animation: navIconDoor 0.58s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        }

        .bottom-nav-item:hover .nav-icon-compass-ring,
        .bottom-nav-item:focus .nav-icon-compass-ring,
        .bottom-nav-item.is-pressing .nav-icon-compass-ring {
            animation: navIconDraw 0.62s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        }

        .bottom-nav-item:hover .nav-icon-compass-needle,
        .bottom-nav-item:focus .nav-icon-compass-needle,
        .bottom-nav-item.is-pressing .nav-icon-compass-needle {
            animation: navIconNeedle 0.68s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        }

        .bottom-nav-item:hover .nav-icon-compass-dot,
        .bottom-nav-item:focus .nav-icon-compass-dot,
        .bottom-nav-item.is-pressing .nav-icon-compass-dot {
            animation: navIconPulse 0.5s ease both;
        }

        .bottom-nav-item:hover .nav-icon-bell-body,
        .bottom-nav-item:focus .nav-icon-bell-body,
        .bottom-nav-item.is-pressing .nav-icon-bell-body {
            animation: navIconBell 0.72s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        }

        .bottom-nav-item:hover .nav-icon-bell-clapper,
        .bottom-nav-item:focus .nav-icon-bell-clapper,
        .bottom-nav-item.is-pressing .nav-icon-bell-clapper {
            animation: navIconClapper 0.72s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        }

        .bottom-nav-item:hover .nav-icon-bell-ring,
        .bottom-nav-item:focus .nav-icon-bell-ring,
        .bottom-nav-item.is-pressing .nav-icon-bell-ring {
            animation: navIconRing 0.72s ease both;
        }

        .bottom-nav-item:hover .nav-icon-tile,
        .bottom-nav-item:focus .nav-icon-tile,
        .bottom-nav-item.is-pressing .nav-icon-tile {
            animation: navIconTile 0.58s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        }

        .bottom-nav-item:hover .nav-icon-tile-2,
        .bottom-nav-item:focus .nav-icon-tile-2,
        .bottom-nav-item.is-pressing .nav-icon-tile-2 { animation-delay: 0.04s; }

        .bottom-nav-item:hover .nav-icon-tile-3,
        .bottom-nav-item:focus .nav-icon-tile-3,
        .bottom-nav-item.is-pressing .nav-icon-tile-3 { animation-delay: 0.08s; }

        .bottom-nav-item:hover .nav-icon-tile-4,
        .bottom-nav-item:focus .nav-icon-tile-4,
        .bottom-nav-item.is-pressing .nav-icon-tile-4 { animation-delay: 0.12s; }

        .bottom-nav-item:hover .nav-icon-profile-head,
        .bottom-nav-item:focus .nav-icon-profile-head,
        .bottom-nav-item.is-pressing .nav-icon-profile-head {
            animation: navIconHead 0.62s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        }

        .bottom-nav-item:hover .nav-icon-profile-shoulders,
        .bottom-nav-item:focus .nav-icon-profile-shoulders,
        .bottom-nav-item.is-pressing .nav-icon-profile-shoulders {
            animation: navIconDraw 0.58s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        }

        .bottom-nav-item:hover .nav-icon-profile-spark,
        .bottom-nav-item:focus .nav-icon-profile-spark,
        .bottom-nav-item.is-pressing .nav-icon-profile-spark {
            animation: navIconSpark 0.6s ease both;
        }

        .bottom-nav-item.is-pressing {
            background: rgba(109, 10, 10, 0.12);
        }

        .mobile-bottom-nav-dark {
            background: rgba(16, 16, 16, 0.82);
            border-color: rgba(255,255,255,0.12);
            box-shadow: 0 20px 55px rgba(0, 0, 0, 0.42);
        }

        .mobile-bottom-nav-dark .bottom-nav-item {
            color: rgba(255,255,255,0.7);
        }

        .mobile-bottom-nav-dark .bottom-nav-item:hover,
        .mobile-bottom-nav-dark .bottom-nav-item:focus {
            color: #fff;
            background: rgba(255,255,255,0.08);
        }

        .mobile-bottom-nav-dark .bottom-nav-item-active {
            color: #fff;
            font-weight: 600;
            background: rgba(255,255,255,0.12);
        }

        @keyframes mobileDockIn {
            from {
                opacity: 0;
                transform: translate3d(0, 18px, 0) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translate3d(0, 0, 0) scale(1);
            }
        }

        @keyframes navIconDraw {
            0% { stroke-dashoffset: var(--nav-icon-draw); opacity: 0.35; }
            100% { stroke-dashoffset: 0; opacity: 1; }
        }

        @keyframes navIconDoor {
            0% { stroke-dashoffset: var(--nav-icon-draw); transform: translateY(2px); opacity: 0.2; }
            100% { stroke-dashoffset: 0; transform: translateY(0); opacity: 1; }
        }

        @keyframes navIconNeedle {
            0% { transform: rotate(-36deg) scale(0.82); opacity: 0.45; }
            58% { transform: rotate(12deg) scale(1.08); opacity: 1; }
            100% { transform: rotate(0) scale(1); opacity: 1; }
        }

        @keyframes navIconPulse {
            0% { transform: scale(0.35); opacity: 0.2; }
            55% { transform: scale(1.45); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }

        @keyframes navIconBell {
            0% { transform: rotate(0); }
            22% { transform: rotate(-11deg); }
            48% { transform: rotate(9deg); }
            72% { transform: rotate(-4deg); }
            100% { transform: rotate(0); }
        }

        @keyframes navIconClapper {
            0% { transform: translateX(0); }
            22% { transform: translateX(1.5px); }
            48% { transform: translateX(-1.3px); }
            72% { transform: translateX(0.6px); }
            100% { transform: translateX(0); }
        }

        @keyframes navIconRing {
            0%, 100% { opacity: 0; transform: translateY(0); }
            30% { opacity: 1; transform: translateY(-1px); }
            70% { opacity: 0.55; transform: translateY(-2px); }
        }

        @keyframes navIconTile {
            0% { transform: translateY(2px) scale(0.82); opacity: 0.35; }
            58% { transform: translateY(-1px) scale(1.08); opacity: 1; }
            100% { transform: translateY(0) scale(1); opacity: 1; }
        }

        @keyframes navIconHead {
            0% { transform: translateY(2px) scale(0.86); opacity: 0.45; }
            60% { transform: translateY(-1px) scale(1.08); opacity: 1; }
            100% { transform: translateY(0) scale(1); opacity: 1; }
        }

        @keyframes navIconSpark {
            0%, 100% { opacity: 0; transform: scale(0.5) rotate(0); }
            42% { opacity: 1; transform: scale(1.18) rotate(90deg); }
            72% { opacity: 0.7; transform: scale(1) rotate(135deg); }
        }

        @media (prefers-reduced-motion: reduce) {
            .mobile-bottom-nav {
                animation: none;
            }

            .bottom-nav-item,
            .bottom-nav-item svg,
            .bottom-nav-item svg * {
                transition: none;
                animation: none !important;
            }

        }

        @media (max-width: 360px) {
            .mobile-bottom-nav {
                left: 8px;
                right: 8px;
                padding: 6px;
                min-height: 62px;
            }

            .bottom-nav-item {
                font-size: 10px;
                min-height: 48px;
                padding-inline: 2px;
            }

            .bottom-nav-item svg {
                width: 20px;
                height: 20px;
            }
        }
    }
</style>

<script>
(function() {
    var dockItems = document.querySelectorAll('.mobile-bottom-nav .bottom-nav-item');
    dockItems.forEach(function(item) {
        item.addEventListener('click', function() {
            item.classList.remove('is-pressing');
            void item.offsetWidth;
            item.classList.add('is-pressing');
            window.setTimeout(function() {
                item.classList.remove('is-pressing');
            }, 420);
        });
    });
})();
</script>
