<section class="home-composer" aria-label="Post composer">
    <form id="postComposerForm">
        <div class="composer-avatar" aria-hidden="true">
            <%= user?.displayName?.charAt(0).toUpperCase() || 'N' %>
        </div>
        <div class="composer-body">
            <label for="post-composer" class="sr-only">What's on your mind?</label>
            <textarea id="post-composer" name="content" rows="1" maxlength="280" placeholder="Share a thought, link, or quick update..."></textarea>
            <div id="composerAttachmentPreview" class="composer-attachment-preview" hidden></div>
            <div class="composer-footer">
                <div class="composer-meta">
                    <input id="composerImageInput" type="file" accept="image/*" hidden>
                    <button type="button" class="composer-icon-btn" id="composerImageBtn" aria-label="Add image" title="Add image">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <circle cx="8.5" cy="8.5" r="1.5"></circle>
                            <path d="M21 15l-5-5L5 21"></path>
                        </svg>
                    </button>
                    <button type="button" class="composer-icon-btn" id="composerLinkBtn" aria-label="Add link" title="Add link">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                        </svg>
                    </button>
                    <span id="composerCount" class="composer-count">0/280</span>
                </div>
                <button type="submit" id="postComposerBtn" disabled>
                    <span>Post</span>
                </button>
            </div>
        </div>
    </form>
</section>

<style>
    .home-composer {
        padding: 0 0 clamp(20px, 3vw, 28px);
        width: 100%;
        min-width: 0;
    }

    .home-composer > form {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        border-radius: 20px;
        border: 1px solid rgba(109, 10, 10, 0.16);
        padding: 16px;
        background: linear-gradient(180deg, #fff, #fffaf7);
        box-shadow: 0 18px 40px rgba(109, 10, 10, 0.07);
        width: 100%;
        max-width: 100%;
        min-width: 0;
    }

    .composer-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        border-radius: 50%;
        background: #6d0a0a;
        color: #fff;
        font-family: 'Abhaya Libre', serif;
        font-size: 22px;
        font-weight: 700;
        box-shadow: 0 10px 22px rgba(109, 10, 10, 0.18);
    }

    .composer-body {
        display: flex;
        flex: 1;
        min-width: 0;
        flex-direction: column;
        gap: 12px;
    }

    .home-composer textarea {
        width: 100%;
        min-width: 0;
        resize: none;
        border: 0;
        background: transparent;
        padding: 5px 0 0;
        font-family: 'Abhaya Libre', serif;
        font-weight: 400;
        font-size: 24px;
        line-height: 1.25;
        color: #1f1715;
        outline: none;
        min-height: 36px;
        max-height: 132px;
        overflow-y: auto;
    }

    .home-composer textarea::placeholder {
        color: rgba(31, 23, 21, 0.48);
    }

    .composer-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        border-top: 1px solid rgba(109, 10, 10, 0.1);
        padding-top: 12px;
    }

    .composer-meta {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .composer-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid rgba(109, 10, 10, 0.12);
        background: rgba(109, 10, 10, 0.04);
        color: #6d0a0a;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
    }

    .composer-icon-btn:hover {
        background: rgba(109, 10, 10, 0.08);
        border-color: rgba(109, 10, 10, 0.2);
        transform: translateY(-1px);
    }

    .composer-attachment-preview {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        min-height: 0;
    }

    .composer-image-chip,
    .composer-link-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        max-width: 100%;
        border-radius: 999px;
        border: 1px solid rgba(109, 10, 10, 0.14);
        background: rgba(109, 10, 10, 0.05);
        color: #4b1714;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        padding: 6px 10px 6px 8px;
    }

    .composer-image-chip img {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        object-fit: cover;
    }

    .composer-link-chip span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .composer-remove-attachment {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 0;
        background: rgba(109, 10, 10, 0.12);
        color: #6d0a0a;
        cursor: pointer;
        font-size: 14px;
        line-height: 1;
    }

    .composer-count {
        color: rgba(31, 23, 21, 0.45);
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
    }

    #postComposerBtn {
        display: flex;
        height: 42px;
        min-width: 92px;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: #6d0a0a;
        padding: 0 22px;
        border: none;
        cursor: pointer;
        box-shadow: 0 12px 24px rgba(109, 10, 10, 0.18);
        transition: opacity 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    #postComposerBtn:not(:disabled):hover {
        transform: translateY(-1px);
        box-shadow: 0 16px 30px rgba(109, 10, 10, 0.22);
    }

    #postComposerBtn > span {
        font-family: 'Abhaya Libre', serif;
        font-weight: 500;
        font-size: 22px;
        color: #fff;
        white-space: nowrap;
    }

    #postComposerBtn:disabled {
        opacity: 0.42;
        cursor: not-allowed;
        box-shadow: none;
    }

    @media (max-width: 1400px) {
        .home-composer textarea {
            font-size: 22px;
        }
        #postComposerBtn {
            height: 40px;
        }
        #postComposerBtn > span {
            font-size: 20px;
        }
    }

    @media (max-width: 768px) {
        .home-composer > form {
            padding: 14px;
            border-radius: 18px;
            gap: 12px;
        }

        .composer-avatar {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
            font-size: 19px;
        }

        .home-composer textarea {
            font-size: 18px;
            min-height: 64px;
        }

        .composer-footer {
            align-items: flex-end;
        }

        .composer-count {
            display: none;
        }

        .composer-icon-btn {
            width: 32px;
            height: 32px;
        }

        #postComposerBtn {
            height: 40px;
            min-width: 82px;
            padding: 0 18px;
        }
        #postComposerBtn > span {
            font-size: 20px;
        }
    }
</style>

<script>
(function() {
    var form = document.getElementById('postComposerForm');
    if (!form) return;
    var textarea = document.getElementById('post-composer');
    var btn = document.getElementById('postComposerBtn');
    var count = document.getElementById('composerCount');
    var imageInput = document.getElementById('composerImageInput');
    var imageBtn = document.getElementById('composerImageBtn');
    var linkBtn = document.getElementById('composerLinkBtn');
    var preview = document.getElementById('composerAttachmentPreview');
    var selectedImage = '';
    var selectedLink = '';

    function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, function(char) {
            return {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            }[char];
        });
    }

    function updateComposer() {
        if (!textarea || !btn) return;
        var length = textarea.value.length;
        textarea.style.height = 'auto';
        textarea.style.height = Math.min(textarea.scrollHeight, 132) + 'px';
        btn.disabled = textarea.value.trim().length === 0 && !selectedImage && !selectedLink;
        if (count) count.textContent = length + '/280';
    }

    function renderAttachments() {
        if (!preview) return;
        var html = '';
        if (selectedImage) {
            html += '<div class="composer-image-chip"><img src="' + selectedImage + '" alt=""><span>Image attached</span><button type="button" class="composer-remove-attachment" data-remove="image" aria-label="Remove image">&times;</button></div>';
        }
        if (selectedLink) {
            html += '<div class="composer-link-chip"><span>' + escapeHtml(selectedLink) + '</span><button type="button" class="composer-remove-attachment" data-remove="link" aria-label="Remove link">&times;</button></div>';
        }
        preview.innerHTML = html;
        preview.hidden = !html;
        preview.querySelectorAll('[data-remove]').forEach(function(removeBtn) {
            removeBtn.addEventListener('click', function() {
                if (this.getAttribute('data-remove') === 'image') {
                    selectedImage = '';
                    if (imageInput) imageInput.value = '';
                } else {
                    selectedLink = '';
                }
                renderAttachments();
                updateComposer();
            });
        });
    }

    if (textarea) {
        textarea.addEventListener('input', updateComposer);
        updateComposer();
    }

    if (imageBtn && imageInput) {
        imageBtn.addEventListener('click', function() {
            imageInput.click();
        });

        imageInput.addEventListener('change', function() {
            var file = imageInput.files && imageInput.files[0];
            if (!file) return;
            if (!file.type || file.type.indexOf('image/') !== 0) {
                alert('Please choose an image file.');
                imageInput.value = '';
                return;
            }
            if (file.size > 750 * 1024) {
                alert('Please choose an image under 750KB.');
                imageInput.value = '';
                return;
            }
            var reader = new FileReader();
            reader.onload = function(event) {
                selectedImage = event.target.result;
                renderAttachments();
                updateComposer();
            };
            reader.readAsDataURL(file);
        });
    }

    if (linkBtn) {
        linkBtn.addEventListener('click', function() {
            var value = window.prompt('Paste a link to include');
            if (!value) return;
            try {
                var url = new URL(value);
                if (url.protocol !== 'http:' && url.protocol !== 'https:') {
                    throw new Error('Unsupported protocol');
                }
                selectedLink = url.toString();
                renderAttachments();
                updateComposer();
            } catch (err) {
                alert('Please enter a valid http or https link.');
            }
        });
    }
    
    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        var content = textarea.value.trim() || (selectedLink ? selectedLink : (selectedImage ? 'Shared an image' : ''));
        
        if (!content) return;
        
        btn.disabled = true;
        btn.style.opacity = '0.5';
        
        try {
            var response = await fetch('/api/posts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ content: content, image: selectedImage, link: selectedLink })
            });
            
            var result = await response.json();
            
            if (result.success) {
                textarea.value = '';
                selectedImage = '';
                selectedLink = '';
                if (imageInput) imageInput.value = '';
                renderAttachments();
                updateComposer();
                window.location.reload();
            }
        } catch (err) {
            console.error('Post creation failed:', err);
        }
        
        btn.disabled = false;
        btn.style.opacity = '1';
    });
})();
</script>
