<header class="app-utility-bar">
  <div class="util-bar-inner">
    <div class="util-bar-left">
      <a href="/" class="util-bar-logo" aria-label="Nook home">n</a>
      <span class="util-bar-separator" aria-hidden="true">|</span>
      <span class="util-bar-title"><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Home' %></span>
    </div>
    <div class="util-bar-right">
      <a href="/activity" class="util-bar-bell" aria-label="Activity">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
          <span class="util-bar-bell-dot" aria-label="<%= unreadCount %> unread notifications"></span>
        <% } %>
      </a>
      <button type="button" class="util-bar-avatar" id="utilBarAvatar" aria-label="User menu" aria-haspopup="true" aria-expanded="false">
        <%= (user && user.displayName) ? user.displayName.charAt(0).toUpperCase() : 'U' %>
      </button>
    </div>
  </div>
</header>

<style>
:root {
  --util-bar-height: 48px;
}

.app-utility-bar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #fff;
  border-bottom: 1px solid rgba(109, 10, 10, 0.08);
}

.util-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1601px;
  margin: 0 auto;
  padding: 8px 24px;
  min-height: 48px;
}

.util-bar-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.util-bar-logo {
  font-family: 'Zen Tokyo Zoo', cursive;
  font-size: 22px;
  letter-spacing: -4px;
  color: #6d0a0a;
  text-decoration: none;
  line-height: 1;
}

.util-bar-separator {
  color: rgba(109, 10, 10, 0.25);
  font-size: 18px;
  font-weight: 200;
  line-height: 1;
}

.util-bar-title {
  font-family: 'Abhaya Libre', serif;
  font-size: 20px;
  font-weight: 600;
  color: #000;
  line-height: 1;
}

.util-bar-right {
  display: flex;
  align-items: center;
  gap: 14px;
}

.util-bar-bell {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  color: rgba(0, 0, 0, 0.6);
  text-decoration: none;
  transition: color 0.2s ease, background 0.2s ease;
}

.util-bar-bell:hover {
  color: #6d0a0a;
  background: rgba(109, 10, 10, 0.06);
}

.util-bar-bell-dot {
  position: absolute;
  top: 4px;
  right: 3px;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #dc2626;
  border: 2px solid #fff;
}

.util-bar-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #6d0a0a;
  color: #fff;
  font-family: 'Inter', sans-serif;
  font-size: 13px;
  font-weight: 700;
  border: none;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.util-bar-avatar:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(109, 10, 10, 0.2);
}

.util-bar-avatar:focus-visible {
  outline: 2px solid #6d0a0a;
  outline-offset: 2px;
}

@media (max-width: 640px) {
  .util-bar-inner {
    padding: 8px 16px;
  }

  .util-bar-title {
    font-size: 17px;
  }
}
</style>
