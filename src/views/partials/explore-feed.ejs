<section class="explore-feed" aria-label="Live news feed">
    <% if (typeof posts !== 'undefined' && posts && posts.length > 0) { %>
        <% posts.forEach(function(post, index) { %>
            <article class="explore-feed-card" style="display: flex; flex-direction: column; width: 100%; max-width: min(897px, 100%); align-items: flex-end; gap: clamp(28px, 4vw, 45px);">
                <div style="display: flex; align-items: flex-start; gap: clamp(16px, 3vw, 31px); width: 100%;">
                    <%- include('../partials/avatar', { user: post.author, size: 'clamp(48px, 8vw, 80px)' }) %>
                    
                    <div style="display: flex; flex-direction: column; width: 100%; max-width: min(786px, 100%); align-items: flex-start; gap: clamp(10px, 2vw, 18px);">
                        <div style="display: flex; width: 100%; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                            <h3 style="margin: 0; font-family: 'Abhaya Libre', serif; font-weight: 800; font-size: clamp(20px, 3.5vw, 32px); color: #000;">
                                <%= post.author ? post.author.displayName : 'Anonymous' %>
                            </h3>
                            <button type="button" class="feed-follow-btn" data-user-id="<%= post.author ? post.author._id : '' %>" style="font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: clamp(18px, 2.5vw, 30px); color: #000; background: none; border: none; cursor: pointer; white-space: nowrap;">
                                Follow
                            </button>
                        </div>
                        
                        <a href="/post/<%= post.slug %>" style="text-decoration: none; color: inherit; display: block; width: 100%;">
                            <h4 style="margin: 0; font-family: 'Abhaya Libre', serif; font-weight: 600; font-size: clamp(18px, 3vw, 28px); color: #000; line-height: 1.3;">
                                <%= post.title %>
                            </h4>
                            <p style="margin: 8px 0 0; font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: clamp(16px, 2.5vw, 22px); color: #000; line-height: 1.4;">
                                <%= post.summary %>
                            </p>
                        </a>
                        
                        <% if (post.image) { %>
                            <div style="width: 100%; max-width: min(481px, 100%); aspect-ratio: 16/9; background-size: cover; background-position: center; border-radius: clamp(8px, 1.5vw, 12px); background-image: url('<%= post.image %>');" role="img" aria-label="Post attachment"></div>
                        <% } %>
                    </div>
                </div>
                
                <div style="display: flex; width: 100%; max-width: min(766px, 100%); align-items: center; justify-content: space-between; flex-wrap: wrap; gap: clamp(12px, 2vw, 16px);">
                    <div style="display: flex; align-items: center; gap: clamp(16px, 3vw, 30px); flex-wrap: wrap;">
                        <button type="button" aria-label="Like" class="like-btn" data-post-id="<%= post._id %>" style="display: flex; align-items: center; justify-content: space-between; background: none; border: none; cursor: pointer; color: #000; gap: 8px;">
                            <svg width="clamp(24px, 4vw, 35px)" height="clamp(24px, 4vw, 35px)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                            </svg>
                            <span style="font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(16px, 2.5vw, 24px); color: #000; white-space: nowrap;">
                                <%= post.likes ? post.likes.length : 0 %>
                            </span>
                        </button>
                        <button type="button" aria-label="Comments" onclick="location.href='/post/<%= post.slug %>#comments'" style="display: flex; align-items: center; justify-content: space-between; background: none; border: none; cursor: pointer; color: #000; gap: 8px;">
                            <svg width="clamp(24px, 4vw, 35px)" height="clamp(24px, 4vw, 35px)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                            </svg>
                            <span style="font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(16px, 2.5vw, 24px); color: #000; white-space: nowrap;">
                                <%= post.comments ? post.comments.length : 0 %>
                            </span>
                        </button>
                        <button type="button" aria-label="Reposts" class="share-btn" data-post-id="<%= post._id %>" style="display: flex; align-items: center; justify-content: space-between; background: none; border: none; cursor: pointer; color: #000; gap: 8px;">
                            <svg width="clamp(24px, 4vw, 35px)" height="clamp(24px, 4vw, 35px)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="17 1 21 5 17 9"/>
                                <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
                                <polyline points="7 23 3 19 7 15"/>
                                <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                            </svg>
                            <span style="font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(16px, 2.5vw, 24px); color: #000; white-space: nowrap;">
                                <%= post.shares || 0 %>
                            </span>
                        </button>
                    </div>
                    
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <button type="button" aria-label="More options" style="background: none; border: none; cursor: pointer; color: #000;">
                            <svg width="clamp(32px, 5vw, 52px)" height="clamp(32px, 5vw, 52px)" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="5" r="2"/>
                                <circle cx="12" cy="12" r="2"/>
                                <circle cx="12" cy="19" r="2"/>
                            </svg>
                        </button>
                        <button type="button" aria-label="Save post" class="save-btn" data-post-id="<%= post._id %>" style="background: none; border: none; cursor: pointer; color: #000;">
                            <svg width="clamp(24px, 4vw, 33px)" height="clamp(24px, 4vw, 33px)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </article>
            
            <% if (index === 1 && typeof feedAds !== 'undefined' && feedAds && feedAds[0]) { %>
                <%- include('../partials/ad-feed', { ad: feedAds[0] }) %>
            <% } else if (index === 4 && typeof feedAds !== 'undefined' && feedAds && feedAds[1]) { %>
                <%- include('../partials/ad-feed', { ad: feedAds[1] }) %>
            <% } else if (index < posts.length - 1 && index !== 1) { %>
                <img alt="Divider" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1101 1' preserveAspectRatio='none'%3E%3Cline x1='0' y1='0.5' x2='1101' y2='0.5' stroke='rgba(109,10,10,0.15)' stroke-width='1'/%3E%3C/svg%3E" style="width: 100%; max-width: min(897px, 100%); height: 1px; object-fit: contain; display: block;" />
            <% } %>
        <% }); %>
    <% } else { %>
        <div style="padding: 24px 0; width: 100%; max-width: min(897px, 100%);">
            <%- include('../partials/empty-state-card', {
                title: 'Explore is quiet right now',
                copy: 'New stories, conversations, and reader updates will land here as soon as they are published.',
                ctaText: 'Go home',
                ctaHref: '/'
            }) %>
        </div>
    <% } %>

    <% if (typeof feedSuggestions !== 'undefined' && feedSuggestions && feedSuggestions.length > 0) { %>
        <div class="explore-suggestions" style="display: flex; flex-direction: column; align-items: flex-start; gap: clamp(24px, 4vw, 47px); width: 100%;">
            <h2 style="margin: 0; font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(24px, 3vw, 36px); color: #000;">
                Suggestion
            </h2>
            <div class="explore-suggestion-cards" style="display: flex; align-items: center; gap: clamp(20px, 4vw, 53px); width: 100%; flex-wrap: wrap;">
                <% feedSuggestions.forEach(function(user) { %>
                    <article class="explore-suggestion-card" style="display: flex; flex-direction: column; width: 100%; max-width: min(335px, 100%); align-items: center; gap: clamp(40px, 6vw, 100px); padding: clamp(16px, 3vw, 30px) clamp(12px, 2vw, 20px); border-radius: clamp(24px, 4vw, 52px); border: 1px solid #6d0a0a;">
                        <div style="display: flex; flex-direction: column; width: 149px; align-items: center; gap: clamp(16px, 3vw, 32px);">
                        <%- include('../partials/avatar', { user: user, size: 'clamp(64px, 8vw, 100px)' }) %>
                            <div style="display: flex; flex-direction: column; align-items: center; gap: 5px; width: 100%;">
                                <h3 style="margin: 0; font-family: 'Abhaya Libre', serif; font-weight: 800; font-size: clamp(20px, 3vw, 32px); color: #000; text-align: center;"><%= user.displayName %></h3>
                                <p style="margin: 0; font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(18px, 2.5vw, 24px); color: rgba(0,0,0,0.62); text-align: center;"><%= user.role || 'Reader' %></p>
                            </div>
                        </div>
                        <button type="button" aria-label="Follow <%= user.displayName %>" class="suggestion-follow-btn" data-user-id="<%= user._id %>" style="display: flex; height: clamp(48px, 7vw, 80px); align-items: center; justify-content: center; gap: 10px; padding: 10px; width: 100%; background: #6d0a0a; border-radius: clamp(24px, 4vw, 45px); border: none; cursor: pointer;">
                            <span style="font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: clamp(20px, 3vw, 32px); color: #fff; white-space: nowrap;">Follow</span>
                        </button>
                    </article>
                <% }); %>
            </div>
        </div>
        <img alt="Divider" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1101 1' preserveAspectRatio='none'%3E%3Cline x1='0' y1='0.5' x2='1101' y2='0.5' stroke='rgba(109,10,10,0.15)' stroke-width='1'/%3E%3C/svg%3E" style="width: 100%; max-width: min(897px, 100%); height: 1px; object-fit: contain; display: block;" />
    <% } %>
</section>

<script>
(function() {
    function attachFollowButtons(selector) {
        var btns = document.querySelectorAll(selector);
        btns.forEach(function(btn) {
            btn.addEventListener('click', async function() {
                var userId = this.getAttribute('data-user-id');
                if (!userId) return;
                
                try {
                    var response = await fetch('/api/users/' + userId + '/follow', {
                        method: 'POST',
                        headers: { 
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: '{}',
                        credentials: 'same-origin'
                    });
                    
                    if (response.status === 401) {
                        showToast('Please log in to follow users');
                        return;
                    }
                    
                    var result = await response.json();
                    if (result.success) {
                        this.textContent = 'Following';
                        this.style.opacity = '0.5';
                        this.style.pointerEvents = 'none';
                    }
                } catch (err) {
                    console.error('Follow failed:', err);
                }
            });
        });
    }

    attachFollowButtons('.feed-follow-btn');
    attachFollowButtons('.suggestion-follow-btn');

     var likeBtns = document.querySelectorAll('.like-btn');
    likeBtns.forEach(function(btn) {
        btn.addEventListener('click', async function() {
            var postId = this.getAttribute('data-post-id');
            if (!postId) return;
            
            try {
                var response = await fetch('/api/posts/' + postId + '/like', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: '{}',
                    credentials: 'same-origin'
                });
                
                if (response.status === 401) {
                    showToast('Please log in to like this post');
                    return;
                }
                
                var result = await response.json();
                if (result.success) {
                    var countSpan = this.querySelector('span');
                    countSpan.textContent = result.likesCount;
                }
            } catch (err) {
                console.error('Like failed:', err);
            }
        });
    });

    var saveBtns = document.querySelectorAll('.save-btn');
    saveBtns.forEach(function(btn) {
        btn.addEventListener('click', async function() {
            var postId = this.getAttribute('data-post-id');
            if (!postId) return;
            var svg = this.querySelector('svg');
            
            try {
                var response = await fetch('/api/posts/' + postId + '/save', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: '{}',
                    credentials: 'same-origin'
                });
                
                if (response.status === 401) {
                    showToast('Please log in to save this post');
                    return;
                }
                
                var result = await response.json();
                if (result.success) {
                    if (result.saved) {
                        svg.setAttribute('fill', '#6d0a0a');
                        svg.setAttribute('stroke', '#6d0a0a');
                    } else {
                        svg.setAttribute('fill', 'none');
                        svg.setAttribute('stroke', 'currentColor');
                    }
                }
            } catch (err) {
                console.error('Save failed:', err);
            }
        });
    });

    var shareBtns = document.querySelectorAll('[aria-label="Reposts"]');
    shareBtns.forEach(function(btn) {
        btn.addEventListener('click', async function() {
            var postUrl = window.location.origin + '/' + this.closest('article').querySelector('a[href*="/"]').getAttribute('href');
            
            if (navigator.share) {
                try {
                    await navigator.share({ title: document.title, url: postUrl });
                } catch (err) {
                    if (err.name !== 'AbortError') console.error('Share failed:', err);
                }
            } else {
                navigator.clipboard.writeText(postUrl).then(function() {
                    var span = btn.querySelector('span');
                    var originalText = span.textContent;
                    span.textContent = 'Copied!';
                    setTimeout(function() { span.textContent = originalText; }, 2000);
                }).catch(function(err) {
                    console.error('Copy failed:', err);
                });
            }
            
            try {
                var shareResponse = await fetch('/api/posts/' + this.getAttribute('data-post-id') + '/share', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: '{}',
                    credentials: 'same-origin'
                });
                
                if (shareResponse.status === 401) {
                    showToast('Please log in to share this post');
                    return;
                }
            } catch (err) {
                console.error('Share count update failed:', err);
            }
        });
    });
})();
</script>

<style>
    .explore-feed {
        display: flex;
        flex-direction: column;
        gap: clamp(32px, 4vw, 48px);
        padding: 0;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    .explore-feed-card {
        margin: 0 auto;
        max-width: 100%;
        box-sizing: border-box;
    }
    .explore-suggestions {
        margin: 0 auto;
    }
    .explore-suggestion-cards {
        justify-content: flex-start;
    }

    @media (max-width: 900px) {
        .explore-feed {
            padding: 0;
            gap: 32px;
        }
        .explore-feed-card {
            align-items: center !important;
        }
        .explore-feed-card > div:first-child {
            gap: 16px !important;
            min-width: 0;
        }
        .explore-feed-card > div:first-child > div {
            max-width: 100% !important;
            min-width: 0;
        }
        .explore-feed-card img[alt*="profile"] {
            width: 60px !important;
            height: 60px !important;
        }
        .explore-feed-card h3 {
            font-size: 24px !important;
        }
        .explore-feed-card h4 {
            font-size: 22px !important;
        }
        .explore-feed-card p {
            font-size: 24px !important;
        }
        .explore-feed-card .feed-follow-btn {
            font-size: 22px !important;
        }
        .explore-feed-card .like-btn span,
        .explore-feed-card [aria-label="Comments"] span,
        .explore-feed-card [aria-label="Reposts"] span {
            font-size: 20px !important;
        }
        .explore-feed-card .like-btn svg,
        .explore-feed-card [aria-label="Comments"] svg,
        .explore-feed-card [aria-label="Reposts"] svg {
            width: 28px !important;
            height: 28px !important;
        }
        .explore-feed-card [aria-label="More options"] svg {
            width: 40px !important;
            height: 40px !important;
        }
        .explore-suggestion-cards {
            flex-direction: column;
            gap: 24px !important;
            align-items: center !important;
        }
        .explore-suggestion-card {
            width: 100% !important;
            max-width: min(335px, 100%) !important;
        }
    }

    @media (max-width: 480px) {
        .explore-feed {
            padding: 0;
            gap: 32px;
        }
        .explore-feed-card {
            max-width: 100% !important;
            gap: 32px !important;
            padding: 0;
        }
        .explore-feed-card > div:first-child {
            gap: 16px !important;
            width: 100% !important;
            min-width: 0;
        }
        .explore-feed-card > div:first-child > div {
            max-width: 100% !important;
            width: 100% !important;
            min-width: 0;
        }
        .explore-feed-card > div:first-child > div > div:first-child {
            flex-wrap: wrap;
        }
        .explore-feed-card a {
            width: 100% !important;
        }
        .explore-feed-card a > div {
            max-width: 100% !important;
            width: 100% !important;
            min-width: 0;
        }
        .explore-feed-card > div:last-child {
            max-width: 100% !important;
            width: 100% !important;
        }
        .explore-feed-card > div:last-child > div:first-child {
            gap: 16px !important;
        }
        .explore-feed-card img[alt*="profile"] {
            width: 48px !important;
            height: 48px !important;
            flex-shrink: 0;
        }
        .explore-feed-card h3 {
            font-size: 20px !important;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .explore-feed-card h4 {
            font-size: 18px !important;
        }
        .explore-feed-card p {
            font-size: 16px !important;
        }
        .explore-feed-card .feed-follow-btn {
            font-size: 16px !important;
        }
        .explore-feed-card [aria-label="More options"] svg {
            width: 32px !important;
            height: 32px !important;
        }
        .explore-feed-card .like-btn svg,
        .explore-feed-card [aria-label="Comments"] svg,
        .explore-feed-card [aria-label="Reposts"] svg {
            width: 24px !important;
            height: 24px !important;
        }
        .explore-feed-card .like-btn span,
        .explore-feed-card [aria-label="Comments"] span,
        .explore-feed-card [aria-label="Reposts"] span {
            font-size: 16px !important;
        }
        .explore-feed-card .save-btn svg {
            width: 24px !important;
            height: 24px !important;
        }
        .explore-feed-card [role="img"] {
            max-width: 100% !important;
            width: 100% !important;
        }
        .explore-feed img[alt="Divider"] {
            max-width: 100% !important;
        }
    }
</style>
