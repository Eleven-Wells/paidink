<div class="review-modal-overlay" id="appReviewOverlay" aria-hidden="true">
    <section class="review-modal" role="dialog" aria-modal="true" aria-labelledby="appReviewTitle">
        <button type="button" class="review-modal-close" id="appReviewClose" aria-label="Close review form">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6 6 18" />
                <path d="m6 6 12 12" />
            </svg>
        </button>
        <p class="review-modal-kicker">Testing feedback</p>
        <h2 class="review-modal-title" id="appReviewTitle">How is PaidInk feeling?</h2>
        <form id="appReviewForm" class="review-form">
            <fieldset class="review-rating" aria-label="Rating">
                <% [1, 2, 3, 4, 5].forEach(function(value) { %>
                    <label class="review-rating-option">
                        <input type="radio" name="rating" value="<%= value %>" <%= value === 5 ? 'checked' : '' %>>
                        <span><%= value %></span>
                    </label>
                <% }); %>
            </fieldset>
            <label class="review-field">
                <span>What should we improve before release?</span>
                <textarea name="feedback" rows="5" maxlength="2000"
                    placeholder="Tell us what worked, what felt confusing, or what you expected to happen." required></textarea>
            </label>
            <p class="review-message" id="appReviewMessage" role="status" aria-live="polite"></p>
            <button type="submit" class="review-submit">Send review</button>
        </form>
    </section>
</div>

<style>
    .review-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 10050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(20, 14, 12, 0.42);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    .review-modal-overlay.is-visible {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    .review-modal {
        position: relative;
        width: min(100%, 460px);
        border: 1px solid rgba(109, 10, 10, 0.14);
        border-radius: 8px;
        background: #fffdfb;
        color: #1f1715;
        padding: 24px;
        box-shadow: 0 28px 80px rgba(31, 23, 21, 0.24);
        transform: translateY(10px) scale(0.98);
        transition: transform 0.2s ease;
    }

    .review-modal-overlay.is-visible .review-modal {
        transform: translateY(0) scale(1);
    }

    .review-modal-close {
        position: absolute;
        top: 14px;
        right: 14px;
        width: 34px;
        height: 34px;
        border: 1px solid rgba(109, 10, 10, 0.1);
        border-radius: 999px;
        background: #fff;
        color: rgba(31, 23, 21, 0.7);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .review-modal-kicker {
        margin: 0 0 6px;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #6d0a0a;
    }

    .review-modal-title {
        margin: 0 42px 18px 0;
        font-family: 'Abhaya Libre', serif;
        font-size: 32px;
        line-height: 1;
        color: #000;
    }

    .review-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .review-rating {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 8px;
        margin: 0;
        padding: 0;
        border: 0;
    }

    .review-rating-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .review-rating-option span {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        border: 1px solid rgba(109, 10, 10, 0.12);
        border-radius: 999px;
        background: rgba(109, 10, 10, 0.04);
        color: #6d0a0a;
        font-weight: 800;
        cursor: pointer;
    }

    .review-rating-option input:checked + span {
        background: #6d0a0a;
        color: #fff;
        border-color: #6d0a0a;
    }

    .review-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 700;
        color: #342522;
    }

    .review-field textarea {
        width: 100%;
        resize: vertical;
        min-height: 128px;
        border: 1px solid rgba(109, 10, 10, 0.14);
        border-radius: 8px;
        padding: 12px;
        font: 500 14px/1.5 'Inter', sans-serif;
        color: #1f1715;
        background: #fff;
        outline: none;
    }

    .review-field textarea:focus {
        border-color: rgba(109, 10, 10, 0.4);
        box-shadow: 0 0 0 4px rgba(109, 10, 10, 0.08);
    }

    .review-message {
        min-height: 18px;
        margin: -4px 0 0;
        font-size: 13px;
        color: #6d0a0a;
    }

    .review-submit {
        min-height: 46px;
        border: 0;
        border-radius: 999px;
        background: #6d0a0a;
        color: #fff;
        font-weight: 800;
        cursor: pointer;
        transition: transform 0.2s ease, background 0.2s ease;
    }

    .review-submit:hover {
        background: #4b0808;
        transform: translateY(-1px);
    }

    .review-submit:disabled {
        opacity: 0.7;
        cursor: wait;
        transform: none;
    }

    @media (max-width: 520px) {
        .review-modal {
            padding: 20px;
        }

        .review-modal-title {
            font-size: 27px;
        }
    }
</style>

<script>
    (function () {
        var overlay = document.getElementById('appReviewOverlay');
        var closeBtn = document.getElementById('appReviewClose');
        var form = document.getElementById('appReviewForm');
        var message = document.getElementById('appReviewMessage');
        if (!overlay || !closeBtn || !form) return;

        function openReview() {
            overlay.classList.add('is-visible');
            overlay.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            setTimeout(function () {
                var textarea = form.querySelector('textarea[name="feedback"]');
                if (textarea) textarea.focus();
            }, 60);
        }

        function closeReview() {
            overlay.classList.remove('is-visible');
            overlay.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        document.addEventListener('click', function (event) {
            var trigger = event.target.closest('[data-open-review]');
            if (trigger) {
                event.preventDefault();
                openReview();
            }
        });

        overlay.addEventListener('click', function (event) {
            if (event.target === overlay) closeReview();
        });

        closeBtn.addEventListener('click', closeReview);

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && overlay.classList.contains('is-visible')) closeReview();
        });

        form.addEventListener('submit', async function (event) {
            event.preventDefault();
            var submit = form.querySelector('button[type="submit"]');
            var rating = form.querySelector('input[name="rating"]:checked');
            var textarea = form.querySelector('textarea[name="feedback"]');
            var feedback = textarea ? textarea.value.trim() : '';

            if (!rating || feedback.length < 10) {
                if (message) message.textContent = 'Add a rating and at least 10 characters of feedback.';
                return;
            }

            if (submit) {
                submit.disabled = true;
                submit.textContent = 'Sending...';
            }
            if (message) message.textContent = '';

            try {
                var response = await fetch('/api/reviews', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        rating: Number(rating.value),
                        feedback: feedback,
                        path: window.location.pathname
                    })
                });
                var data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.error || 'Review could not be sent');
                if (message) message.textContent = 'Thanks. Your review was sent.';
                form.reset();
                var five = form.querySelector('input[name="rating"][value="5"]');
                if (five) five.checked = true;
                setTimeout(closeReview, 900);
            } catch (error) {
                if (message) message.textContent = error.message || 'Review could not be sent.';
            } finally {
                if (submit) {
                    submit.disabled = false;
                    submit.textContent = 'Send review';
                }
            }
        });
    })();
</script>
