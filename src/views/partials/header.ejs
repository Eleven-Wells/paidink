<% var isArticleNav = typeof navVariant !== 'undefined' && navVariant === 'article'; %>
<% if (isArticleNav) { %>
<nav id="mainNav" class="site-nav article-nav fixed top-0 w-full z-50 transition-all duration-300">
    <div class="site-nav__inner article-nav__inner">
        <div class="article-nav__bar">
            <button type="button" class="article-nav__back" id="articleNavBackButton" aria-label="Go back">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    aria-hidden="true">
                    <path d="m15 18-6-6 6-6"></path>
                    <path d="M21 12H9"></path>
                </svg>
                <span>Back</span>
            </button>

            <a href="/" aria-label="PaidInk home" class="article-nav__logo">PaidInk</a>

            <div class="article-nav__meta" aria-label="Current article">
                <span class="article-nav__eyebrow">Reading</span>
                <span class="article-nav__title"><%= articleNavTitle || 'Article' %></span>
            </div>

            <div class="article-nav__actions">
                <% if (articleNavMeta) { %>
                    <span class="article-nav__time"><%= articleNavMeta %></span>
                <% } %>
                <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
                    <a href="/dashboard" class="article-nav__link">Dashboard</a>
                <% } else { %>
                    <a href="/login" class="article-nav__link">Sign In</a>
                <% } %>
            </div>
        </div>
    </div>
</nav>
<% } else { %>
<nav id="mainNav" class="site-nav fixed top-0 w-full z-50 transition-all duration-300">
    <div class="site-nav__inner">
        <div class="site-nav__bar">
            <a href="/" aria-label="PaidInk home" class="site-nav__logo">
                PaidInk
            </a>

            <div class="desktop-nav site-nav__desktop">
                <nav aria-label="Primary" class="site-nav__links">
                    <a href="/browse" class="nav-link">Explore</a>
                    <a href="/apply-publisher" class="nav-link">Write</a>
                    <a href="/dashboard" class="nav-link">Reward</a>
                </nav>

                <div class="site-nav__actions">
                    <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
                        <a href="/dashboard" class="nav-link site-nav__user">
                            <%= user?.displayName?.split(' ')[0] || 'Dashboard' %>
                        </a>
                        <a href="/dashboard" class="nav-cta">
                            Dashboard
                        </a>
                    <% } else { %>
                        <a href="/login" class="nav-link site-nav__user">
                            Sign In
                        </a>
                        <a href="/register" class="nav-cta">
                            Get Started
                        </a>
                    <% } %>
                </div>
            </div>

            <button id="hamburgerBtn" class="mobile-menu-btn" aria-label="Open menu" aria-controls="mobileMenu" aria-expanded="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    aria-hidden="true">
                    <path d="M4 5h16"></path>
                    <path d="M4 12h16"></path>
                    <path d="M4 19h16"></path>
                </svg>
            </button>
        </div>
    </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu__header">
        <span class="mobile-menu__brand">PaidInk</span>
        <button id="closeMenuBtn" class="mobile-menu__close" aria-label="Close menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
            </svg>
        </button>
    </div>
    <div class="mobile-menu__body">
        <a href="/browse" class="mobile-menu__link">Explore</a>
        <a href="/apply-publisher" class="mobile-menu__link">Write</a>
        <a href="/dashboard" class="mobile-menu__link">Reward</a>

        <div class="mobile-menu__actions">
            <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
                <a href="/dashboard" class="mobile-menu__cta">
                    Dashboard
                </a>
            <% } else { %>
                <a href="/register" class="mobile-menu__cta">
                    Get Started
                </a>
                <a href="/login" class="mobile-menu__secondary">
                    Sign In
                </a>
            <% } %>
        </div>
    </div>
</div>

<div class="mobile-overlay" id="mobileOverlay"></div>
<% } %>

<style>
    .site-nav {
        border-bottom: 1px solid rgba(109, 10, 10, 0.08);
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(18px);
        box-shadow: 0 18px 48px rgba(72, 42, 28, 0.06);
    }

    .article-nav {
        background: rgba(255, 253, 251, 0.88);
        box-shadow: 0 16px 42px rgba(72, 42, 28, 0.05);
    }

    .site-nav__inner {
        width: min(100% - 2rem, 1240px);
        margin: 0 auto;
    }

    .site-nav__bar {
        display: flex;
        min-height: 72px;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .article-nav__bar {
        display: grid;
        min-height: 66px;
        grid-template-columns: auto auto minmax(0, 1fr) auto;
        gap: 18px;
        align-items: center;
    }

    .article-nav__back,
    .article-nav__link {
        display: inline-flex;
        min-height: 38px;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid rgba(109, 10, 10, 0.1);
        border-radius: 999px;
        background: rgba(255, 251, 248, 0.86);
        color: #5f1b17;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.86rem;
        font-weight: 800;
        letter-spacing: 0;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .article-nav__back {
        padding: 0 14px;
    }

    .article-nav__link {
        padding: 0 16px;
    }

    .article-nav__back:hover,
    .article-nav__link:hover {
        background: #6d0a0a;
        color: #ffffff;
        box-shadow: 0 14px 30px rgba(109, 10, 10, 0.16);
        transform: translateY(-1px);
    }

    .article-nav__logo {
        color: #6d0a0a;
        font-family: 'Zen Tokyo Zoo', cursive;
        font-size: 42px;
        line-height: 1;
        letter-spacing: 0;
        text-decoration: none;
        white-space: nowrap;
    }

    .article-nav__meta {
        min-width: 0;
        padding-left: 2px;
    }

    .article-nav__eyebrow {
        display: block;
        color: #8a7871;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.64rem;
        font-weight: 700;
        letter-spacing: 0;
        line-height: 1.1;
        text-transform: uppercase;
    }

    .article-nav__title {
        display: block;
        overflow: hidden;
        color: #231815;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.94rem;
        font-weight: 800;
        line-height: 1.25;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .article-nav__actions {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .article-nav__time {
        display: inline-flex;
        min-height: 34px;
        align-items: center;
        padding: 0 12px;
        border-radius: 999px;
        background: rgba(109, 10, 10, 0.06);
        color: #6d0a0a;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0;
        white-space: nowrap;
    }

    .site-nav__logo,
    .mobile-menu__brand {
        color: #6d0a0a;
        font-family: 'Zen Tokyo Zoo', cursive;
        font-size: 56px;
        line-height: 1;
        letter-spacing: 0;
        text-decoration: none;
        white-space: nowrap;
    }

    .site-nav__desktop {
        display: flex;
        align-items: center;
        gap: 28px;
        min-width: 0;
    }

    .site-nav__links {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px;
        border: 1px solid rgba(109, 10, 10, 0.08);
        border-radius: 999px;
        background: rgba(255, 251, 248, 0.82);
    }

    .nav-link {
        display: inline-flex;
        min-height: 38px;
        align-items: center;
        justify-content: center;
        padding: 0 16px;
        border-radius: 999px;
        color: #5f1b17;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.92rem;
        font-weight: 700;
        letter-spacing: 0;
        text-decoration: none;
        transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
        white-space: nowrap;
    }

    .nav-link:hover {
        background: rgba(109, 10, 10, 0.07);
        color: #3c0707;
        transform: translateY(-1px);
    }

    .site-nav__actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .site-nav__user {
        max-width: 140px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .nav-cta {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        justify-content: center;
        padding: 0 20px;
        border-radius: 999px;
        border: 1px solid rgba(76, 7, 7, 0.16);
        background: #6d0a0a;
        color: #ffffff;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.92rem;
        font-weight: 800;
        letter-spacing: 0;
        text-decoration: none;
        box-shadow: 0 16px 34px rgba(109, 10, 10, 0.18);
        transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        white-space: nowrap;
    }

    .nav-cta:hover {
        background: #4c0707;
        box-shadow: 0 20px 42px rgba(109, 10, 10, 0.24);
        transform: translateY(-1px);
    }

    .mobile-menu-btn,
    .mobile-menu__close {
        display: none;
        width: 44px;
        height: 44px;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(109, 10, 10, 0.1);
        border-radius: 50%;
        background: rgba(255, 251, 248, 0.9);
        color: #6d0a0a;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .mobile-menu-btn:hover,
    .mobile-menu__close:hover {
        background: rgba(109, 10, 10, 0.07);
        transform: translateY(-1px);
    }

    .mobile-menu {
        position: fixed;
        top: 0;
        right: 0;
        z-index: 70;
        width: 340px;
        max-width: 88vw;
        height: 100vh;
        overflow-y: auto;
        border-left: 1px solid rgba(109, 10, 10, 0.1);
        background: #fffdfb;
        box-shadow: -28px 0 70px rgba(72, 42, 28, 0.14);
        transform: translateX(100%);
        transition: transform 0.3s ease;
        -webkit-overflow-scrolling: touch;
    }

    .mobile-menu.active {
        transform: translateX(0);
    }

    .mobile-menu__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 20px;
        border-bottom: 1px solid rgba(109, 10, 10, 0.1);
    }

    .mobile-menu__brand {
        font-size: 42px;
    }

    .mobile-menu__close {
        display: inline-flex;
        flex: 0 0 auto;
    }

    .mobile-menu__body {
        padding: 18px 20px 24px;
    }

    .mobile-menu__link {
        display: flex;
        min-height: 52px;
        align-items: center;
        border-bottom: 1px solid rgba(109, 10, 10, 0.08);
        color: #5f1b17;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0;
        text-decoration: none;
    }

    .mobile-menu__actions {
        margin-top: 24px;
    }

    .mobile-menu__cta,
    .mobile-menu__secondary {
        display: flex;
        min-height: 52px;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1rem;
        font-weight: 800;
        letter-spacing: 0;
        text-decoration: none;
    }

    .mobile-menu__cta {
        background: #6d0a0a;
        color: #ffffff;
        box-shadow: 0 16px 34px rgba(109, 10, 10, 0.18);
    }

    .mobile-menu__secondary {
        margin-top: 12px;
        color: #6d0a0a;
    }

    .mobile-overlay {
        position: fixed;
        inset: 0;
        z-index: 50;
        background: rgba(19, 15, 14, 0.34);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .mobile-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }

    @media (max-width: 1024px) {
        .site-nav__inner {
            width: min(100% - 1.5rem, 1240px);
        }

        .site-nav__logo {
            font-size: 48px;
        }

        .site-nav__desktop {
            gap: 16px;
        }

        .nav-link {
            padding: 0 12px;
            font-size: 0.86rem;
        }

        .nav-cta {
            min-height: 40px;
            padding: 0 16px;
            font-size: 0.86rem;
        }

        .article-nav__bar {
            gap: 12px;
        }

        .article-nav__logo {
            font-size: 36px;
        }

        .article-nav__time {
            display: none;
        }
    }

    @media (max-width: 820px) {
        .site-nav__bar {
            min-height: 68px;
        }

        .site-nav__desktop {
            display: none;
        }

        .site-nav__logo {
            font-size: 44px;
        }

        .mobile-menu-btn {
            display: inline-flex;
        }

        .article-nav__bar {
            min-height: 62px;
            grid-template-columns: auto minmax(0, 1fr) auto;
        }

        .article-nav__logo {
            display: none;
        }

        .article-nav__back span {
            display: none;
        }

        .article-nav__back {
            width: 40px;
            min-height: 40px;
            padding: 0;
        }

        .article-nav__link {
            min-height: 40px;
            padding: 0 13px;
            font-size: 0.8rem;
        }
    }
</style>

<script>
(function() {
    var articleNavBackButton = document.getElementById('articleNavBackButton');
    var hamburgerBtn = document.getElementById('hamburgerBtn');
    var closeMenuBtn = document.getElementById('closeMenuBtn');
    var mobileMenu = document.getElementById('mobileMenu');
    var overlay = document.getElementById('mobileOverlay');

    if (articleNavBackButton) {
        articleNavBackButton.addEventListener('click', function() {
            if (window.history.length > 1) {
                window.history.back();
                return;
            }
            window.location.href = '/browse';
        });
    }

    function openMenu() {
        mobileMenu.classList.add('active');
        overlay.classList.add('active');
        if (hamburgerBtn) hamburgerBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
        mobileMenu.classList.remove('active');
        overlay.classList.remove('active');
        if (hamburgerBtn) hamburgerBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
    }

    if (hamburgerBtn) hamburgerBtn.addEventListener('click', openMenu);
    if (closeMenuBtn) closeMenuBtn.addEventListener('click', closeMenu);
    if (overlay) overlay.addEventListener('click', closeMenu);

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && mobileMenu && mobileMenu.classList.contains('active')) {
            closeMenu();
        }
    });
})();
</script>
