        max-width: 100%;
        box-sizing: border-box;
        padding: clamp(24px, 4vw, 34px) clamp(16px, 3vw, 24px);
        border-radius: clamp(24px, 4vw, 34px);
        border: 1px solid rgba(0, 0, 0, 0.16);
        background: #fff;
    }

    .explore-people-head {
        margin-bottom: 28px;
    }

    .explore-people-kicker {
        margin: 0 0 7px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #6d0a0a;
    }

    .explore-people-head h2 {
        margin: 0;
        font-family: 'Abhaya Libre', serif;
        font-weight: 600;
        font-size: clamp(24px, 3vw, 32px);
        line-height: 1;
        color: #000;
    }

    .explore-people-copy {
        margin: 10px 0 0;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 13px;
        line-height: 1.45;
        color: rgba(0, 0, 0, 0.62);
    }

    .explore-people-list {
        display: flex;
        flex-direction: column;
        gap: 24px;
        width: 100%;
    }

    .explore-people-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        width: 100%;
    }

    .explore-people-main {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }

    .explore-people-copy-block {
        min-width: 0;
    }

    .explore-people-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-family: 'Abhaya Libre', serif;
        font-weight: 700;
        font-size: clamp(19px, 2vw, 22px);
        color: #000;
    }

    .explore-people-role {
        margin-top: 3px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 12px;
        color: rgba(0, 0, 0, 0.62);
    }

    .explore-follow-btn {
        display: flex;
        min-height: 42px;
        min-width: 96px;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 999px;
        background: #6d0a0a;
        padding: 10px 16px;
        cursor: pointer;
    }

    .explore-follow-btn span {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-weight: 800;
        font-size: 12px;
        color: #fff;
        white-space: nowrap;
    }

    .explore-people-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        margin-top: 24px;
        padding: 13px 16px;
        border: 1px solid rgba(109, 10, 10, 0.12);
        border-radius: 999px;
        background: rgba(109, 10, 10, 0.06);
        color: #6d0a0a;
        text-decoration: none;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 13px;
        font-weight: 800;
    }

    @media (max-width: 1100px) {
        .explore-who-to-follow {
            display: none !important;
        }
    }
</style>
