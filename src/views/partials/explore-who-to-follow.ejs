<aside class="explore-who-to-follow" aria-labelledby="explore-who-to-follow-heading">
    <div class="explore-people-head">
        <p class="explore-people-kicker">Shape your feed</p>
        <h2 id="explore-who-to-follow-heading">People to follow</h2>
        <p class="explore-people-copy">Follow readers and writers you trust. Nook uses those signals to make your feed feel more personal.</p>
    </div>

    <div class="explore-people-list">
        <% if (typeof suggestedUsers !== 'undefined' && suggestedUsers && suggestedUsers.length > 0) { %>
            <% suggestedUsers.forEach(function(user) { %>
                <div class="explore-people-item">
                    <div class="explore-people-main">
                        <%- include('../partials/avatar', { user: user, size: 'clamp(40px, 5vw, 55px)' }) %>
                        <div class="explore-people-copy-block">
                            <div class="explore-people-name"><%= user.displayName %></div>
                            <div class="explore-people-role"><%= user.role || 'Reader' %></div>
                        </div>
                    </div>
                    <button type="button" aria-label="Follow <%= user.displayName %>" class="explore-follow-btn" data-user-id="<%= user._id %>">
                        <span>Follow</span>
                    </button>
                </div>
            <% }); %>
        <% } else { %>
            <%- include('../partials/empty-state-card', {
                title: 'No suggestions yet',
                copy: 'Follow suggestions will appear when there are more people near your reading pattern.',
                compact: true
            }) %>
        <% } %>
    </div>

    <a href="/browse" class="explore-people-cta">Find more readers and writers</a>
</aside>

<script>
(function() {
    var followBtns = document.querySelectorAll('.explore-follow-btn');
    followBtns.forEach(function(btn) {
        btn.addEventListener('click', async function() {
            var userId = this.getAttribute('data-user-id');
            if (!userId) return;
            
            try {
                var response = await fetch('/api/users/' + userId + '/follow', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                var result = await response.json();
                if (result.success) {
                    this.innerHTML = '<span style="font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif; font-weight: 800; font-size: 12px; color: #fff; white-space: nowrap;">Following</span>';
                    this.style.opacity = '0.7';
                    this.style.pointerEvents = 'none';
                }
            } catch (err) {
                console.error('Follow failed:', err);
            }
        });
    });
})();
</script>

<style>
    .explore-who-to-follow {
        margin-left: auto;
        margin-right: clamp(8px, 1vw, 16px);
        margin-top: clamp(16px, 2vw, 24px);
