<aside class="explore-who-to-follow" aria-labelledby="explore-who-to-follow-heading" style="padding: clamp(24px, 4vw, 47px) clamp(16px, 3vw, 29px); border-radius: clamp(24px, 4vw, 58px); border: 1px solid #000; background: #fff; overflow: hidden;">
    <div style="display: flex; flex-direction: column; height: auto; max-height: 704px; width: 100%; align-items: center; justify-content: space-between;">
        <h2 id="explore-who-to-follow-heading" style="margin: 0; width: 100%; font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(20px, 3vw, 32px); color: #000;">
            Who to follow
        </h2>
        
        <div style="display: flex; flex-direction: column; width: 100%;">
            <% if (typeof suggestedUsers !== 'undefined' && suggestedUsers && suggestedUsers.length > 0) { %>
                <% suggestedUsers.forEach(function(user, index) { %>
                    <div style="display: flex; width: 100%; align-items: center; justify-content: space-between; <%= index < suggestedUsers.length - 1 ? 'margin-bottom: clamp(24px, 4vw, 47px);' : '' %>">
                        <div style="display: inline-flex; align-items: center; gap: clamp(16px, 3vw, 27px);">
                            <%- include('../partials/avatar', { user: user, size: 'clamp(40px, 5vw, 55px)' }) %>
                            <div style="display: flex; width: 100%; max-width: 165px; flex-direction: column; align-items: flex-start; gap: 5px;">
                                <div style="font-family: 'Abhaya Libre', serif; font-weight: 700; font-size: clamp(18px, 2.5vw, 25px); color: #000;"><%= user.displayName %></div>
                                <div style="font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(16px, 2vw, 22px); color: #000;"><%= user.role || 'Reader' %></div>
                            </div>
                        </div>
                        <button type="button" aria-label="Follow <%= user.displayName %>" class="explore-follow-btn" data-user-id="<%= user._id %>" style="display: flex; height: clamp(44px, 7vw, 60px); min-width: clamp(100px, 15vw, 157px); align-items: center; justify-content: center; gap: 10px; border-radius: clamp(24px, 4vw, 45px); background: #6d0a0a; padding: clamp(6px, 1vw, 10px) clamp(12px, 2vw, 20px); border: none; cursor: pointer;">
                            <span style="font-family: 'Abhaya Libre', serif; font-weight: 500; font-size: clamp(16px, 2vw, 20px); color: #fff; white-space: nowrap;">Follow</span>
                        </button>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="margin: 0; font-family: 'Abhaya Libre', serif; font-size: clamp(16px, 2.5vw, 24px); color: rgba(0,0,0,0.5);">No suggestions yet.</p>
            <% } %>
        </div>
    </div>
</aside>

<script>
(function() {
    var followBtns = document.querySelectorAll('.explore-follow-btn');
    followBtns.forEach(function(btn) {
        btn.addEventListener('click', async function() {
            var userId = this.getAttribute('data-user-id');
            if (!userId) return;
            
            try {
                var response = await fetch('/api/users/' + userId + '/follow', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                var result = await response.json();
                if (result.success) {
                    this.innerHTML = '<span style="font-family: \'Abhaya Libre\', serif; font-weight: 500; font-size: 20px; color: #fff; white-space: nowrap;">Following</span>';
                    this.style.opacity = '0.7';
                    this.style.pointerEvents = 'none';
                }
            } catch (err) {
                console.error('Follow failed:', err);
            }
        });
    });
})();
</script>

<style>
    .explore-who-to-follow {
        margin-left: auto;
        margin-right: clamp(8px, 1vw, 16px);
        margin-top: clamp(16px, 2vw, 24px);
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    @media (max-width: 1100px) {
        .explore-who-to-follow {
            display: none !important;
        }
    }
</style>
