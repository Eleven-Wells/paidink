<aside class="home-trending" aria-labelledby="trending-heading">
    <div class="home-trending-inner">
        <h2 id="trending-heading">
            Trending
        </h2>
        
        <div class="trending-list">
        <% if (typeof trendingPosts !== 'undefined' && trendingPosts && trendingPosts.length > 0) { %>
            <% trendingPosts.forEach(function(post, index) { %>
                <article class="trending-post">
                    <div class="trending-post-info">
                        <%- include('../partials/avatar', { user: post.author, size: '55px' }) %>
                        <div>
                            <p class="trending-label">Up next</p>
                            <p class="trending-author"><%= post.author ? post.author.displayName : 'Anonymous' %></p>
                            <p class="trending-title"><%= post.title %></p>
                            <p class="trending-meta"><%= post.readTime || '5m' %> read <%= post.likes ? post.likes.length : 0 %> likes</p>
                        </div>
                    </div>
                    <button type="button" aria-label="Save article" class="trending-save-btn">
                        <svg width="33" height="33" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                        </svg>
                    </button>
                    <% if (index < trendingPosts.length - 1) { %>
                        <hr class="trending-divider" />
                    <% } %>
                </article>
            <% }); %>
        <% } else { %>
            <%- include('../partials/empty-state-card', {
                title: 'No trend line yet',
                copy: 'Popular posts will appear here once readers start moving through the feed.',
                compact: true
            }) %>
        <% } %>
        </div>
    </div>
</aside>

<style>
    .home-trending {
        width: 100%;
    }

    .home-trending-inner {
        padding: 24px;
        width: 100%;
        border: 1px solid rgba(0, 0, 0, 0.15);
        border-radius: 24px;
    }

    .home-trending-inner > h2 {
        margin: 0;
        font-family: 'Abhaya Libre', serif;
        font-weight: 400;
        font-size: 32px;
        color: #000;
        margin-bottom: 32px;
    }

    .trending-post {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 19px;
        width: 100%;
        padding-bottom: 32px;
    }

    .trending-post-info {
        display: inline-flex;
        align-items: flex-start;
        justify-content: space-between;
        width: 100%;
    }

    .trending-post-info > div {
        font-family: 'Abhaya Libre', serif;
        font-weight: 400;
        font-size: 24px;
        color: #000;
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-left: 26px;
    }

    .trending-label { margin: 0; }
    .trending-author { margin: 0; }
    .trending-title { margin: 0; font-weight: 500; }
    .trending-meta { margin: 0; color: rgba(0,0,0,0.6); }

    .trending-save-btn {
        display: flex;
        height: 33px;
        width: 33px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        background: none;
        border: none;
        cursor: pointer;
        margin-left: 16px;
    }

    .trending-list {
        display: flex;
        flex-direction: column;
        gap: 32px;
        width: 100%;
    }

    .trending-divider {
        width: 100%;
        height: 1px;
        border: none;
        background: rgba(0,0,0,0.15);
        margin: 0;
    }

    @media (max-width: 1400px) {
        .home-trending-inner > h2 {
            font-size: 28px;
        }
        .trending-post-info > div {
            font-size: 20px;
        }
    }

    @media (max-width: 1024px) {
        .home-trending {
            display: none;
        }
    }
</style>
