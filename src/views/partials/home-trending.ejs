<aside class="home-trending" aria-labelledby="trending-heading">
    <div class="home-trending-inner">
        <div class="sidebar-section-head">
            <p class="sidebar-section-kicker">Popular now</p>
            <h2 id="trending-heading">Trending reads</h2>
            <p class="sidebar-section-copy">Start here when you want something readers are already opening, saving, and talking about.</p>
        </div>
        
        <div class="trending-list">
        <% if (typeof trendingPosts !== 'undefined' && trendingPosts && trendingPosts.length > 0) { %>
            <% trendingPosts.forEach(function(post, index) { %>
                <article class="trending-post">
                    <div class="trending-post-info">
                        <%- include('../partials/avatar', { user: post.author, size: '55px' }) %>
                        <div>
                            <p class="trending-label">Up next</p>
                            <p class="trending-author"><%= post.author ? post.author.displayName : 'Anonymous' %></p>
                            <p class="trending-title"><%= post.title %></p>
                            <p class="trending-meta"><%= post.readTime || '5m' %> read <%= post.likes ? post.likes.length : 0 %> likes</p>
                        </div>
                    </div>
                    <div class="trending-actions">
                        <a href="/post/<%= post.slug || '#' %>" class="sidebar-secondary-cta">Read</a>
                        <button type="button" aria-label="Save article" class="trending-save-btn">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                            </svg>
                        </button>
                    </div>
                    <% if (index < trendingPosts.length - 1) { %>
                        <hr class="trending-divider" />
                    <% } %>
                </article>
            <% }); %>
        <% } else { %>
            <%- include('../partials/empty-state-card', {
                title: 'No trend line yet',
                copy: 'Popular posts will appear here once readers start moving through the feed.',
                compact: true
            }) %>
        <% } %>
        </div>
        <a href="/browse?tab=trending" class="sidebar-primary-cta">See more trending posts</a>
    </div>
</aside>

<style>
    .home-trending {
        width: 100%;
    }

    .home-trending-inner {
        padding: 24px;
        width: 100%;
        border: 1px solid rgba(0, 0, 0, 0.15);
        border-radius: 24px;
    }

    .home-trending .sidebar-section-head {
        margin-bottom: 28px;
    }

    .home-trending .sidebar-section-kicker {
        margin: 0 0 7px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #6d0a0a;
    }

    .home-trending-inner h2 {
        margin: 0;
        font-family: 'Abhaya Libre', serif;
        font-weight: 600;
        font-size: 32px;
        color: #000;
        line-height: 1;
    }

    .home-trending .sidebar-section-copy {
        margin: 10px 0 0;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 13px;
        line-height: 1.45;
        color: rgba(0, 0, 0, 0.62);
    }

    .trending-post {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 19px;
        width: 100%;
        padding-bottom: 32px;
    }

    .trending-post-info {
        display: inline-flex;
        align-items: flex-start;
        justify-content: space-between;
        width: 100%;
    }

    .trending-post-info > div {
        font-family: 'Abhaya Libre', serif;
        font-weight: 400;
        font-size: 20px;
        color: #000;
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-left: 26px;
    }

    .trending-label { margin: 0; color: #6d0a0a; font-size: 16px; }
    .trending-author { margin: 0; }
    .trending-title { margin: 0; font-weight: 500; }
    .trending-meta { margin: 0; color: rgba(0,0,0,0.6); font-size: 16px; }

    .trending-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
    }

    .trending-save-btn {
        display: flex;
        height: 40px;
        width: 40px;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        background: rgba(109, 10, 10, 0.06);
        border: 1px solid rgba(109, 10, 10, 0.12);
        border-radius: 999px;
        color: #6d0a0a;
        cursor: pointer;
    }

    .trending-list {
        display: flex;
        flex-direction: column;
        gap: 32px;
        width: 100%;
    }

    .trending-divider {
        width: 100%;
        height: 1px;
        border: none;
        background: rgba(0,0,0,0.15);
        margin: 0;
    }

    .home-trending .sidebar-primary-cta,
    .home-trending .sidebar-secondary-cta {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 999px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        font-weight: 800;
    }

    .home-trending .sidebar-primary-cta {
        width: 100%;
        margin-top: 24px;
        padding: 13px 16px;
        background: #6d0a0a;
        color: #fff;
        font-size: 13px;
    }

    .home-trending .sidebar-secondary-cta {
        padding: 10px 15px;
        border: 1px solid rgba(109, 10, 10, 0.14);
        color: #6d0a0a;
        font-size: 12px;
    }

    @media (max-width: 1400px) {
        .home-trending-inner h2 {
            font-size: 28px;
        }
        .trending-post-info > div {
            font-size: 18px;
        }
    }

    @media (max-width: 1024px) {
        .home-trending {
            display: none;
        }
    }
</style>
