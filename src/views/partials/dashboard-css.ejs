<% const isLightDashboard = typeof dashboardTheme !== 'undefined' && dashboardTheme === 'light'; %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Abhaya+Libre:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<style>
    :root {
        --dash-accent: #6d0a0a;
        --dash-accent-strong: #4c0707;
        --dash-success: #15803d;
        --dash-danger: #b91c1c;
        --dash-warning: #b45309;
        <% if (isLightDashboard) { %>
        --dash-bg: #fcf7f2;
        --dash-bg-alt: #fffdfb;
        --dash-text: #181211;
        --dash-muted: #6f6560;
        --dash-muted-strong: #938680;
        --dash-grid-line: rgba(109, 10, 10, 0.04);
        --dash-card-bg: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(255, 247, 241, 0.98));
        --dash-card-border: rgba(109, 10, 10, 0.12);
        --dash-card-border-strong: rgba(109, 10, 10, 0.18);
        --dash-card-shadow: 0 24px 60px rgba(109, 10, 10, 0.08);
        --dash-nav-bg: rgba(255, 250, 245, 0.88);
        --dash-nav-border: rgba(109, 10, 10, 0.08);
        --dash-primary-bg: #6d0a0a;
        --dash-primary-hover: #520808;
        --dash-primary-text: #ffffff;
        --dash-primary-shadow: 0 16px 36px rgba(109, 10, 10, 0.18);
        --dash-secondary-bg: rgba(109, 10, 10, 0.04);
        --dash-secondary-hover-bg: rgba(109, 10, 10, 0.08);
        --dash-secondary-border: rgba(109, 10, 10, 0.12);
        --dash-secondary-text: #6d0a0a;
        --dash-mobile-menu-bg: #fffaf6;
        --dash-mobile-link: #3d2f2b;
        --dash-overlay: rgba(53, 33, 28, 0.22);
        --dash-input-border: rgba(109, 10, 10, 0.14);
        --dash-input-text: #181211;
        --dash-input-placeholder: #968b85;
        --dash-select-bg: #fffaf6;
        --dash-select-border: rgba(109, 10, 10, 0.12);
        --dash-select-hover-bg: rgba(109, 10, 10, 0.05);
        --dash-select-hover-border: rgba(109, 10, 10, 0.18);
        --dash-toast-bg: rgba(255, 255, 255, 0.98);
        --dash-toast-text: #181211;
        --dash-toast-border: rgba(109, 10, 10, 0.1);
        --dash-method-border: rgba(109, 10, 10, 0.12);
        --dash-method-hover-bg: rgba(109, 10, 10, 0.05);
        <% } else { %>
        --dash-bg: #040404;
        --dash-bg-alt: #040404;
        --dash-text: #ffffff;
        --dash-muted: rgba(255, 255, 255, 0.5);
        --dash-muted-strong: rgba(255, 255, 255, 0.35);
        --dash-grid-line: rgba(255, 255, 255, 0.06);
        --dash-card-bg: linear-gradient(145deg, rgba(16, 16, 16, 0.96), rgba(5, 5, 5, 0.98));
        --dash-card-border: rgba(255, 255, 255, 0.08);
        --dash-card-border-strong: rgba(255, 255, 255, 0.16);
        --dash-card-shadow: 0 24px 80px rgba(0, 0, 0, 0.34);
        --dash-nav-bg: rgba(4, 4, 4, 0.8);
        --dash-nav-border: rgba(255, 255, 255, 0.05);
        --dash-primary-bg: #ffffff;
        --dash-primary-hover: #f3f3f3;
        --dash-primary-text: #000000;
        --dash-primary-shadow: 0 10px 40px rgba(255, 255, 255, 0.15);
        --dash-secondary-bg: transparent;
        --dash-secondary-hover-bg: rgba(255, 255, 255, 0.1);
        --dash-secondary-border: rgba(255, 255, 255, 0.2);
        --dash-secondary-text: #ffffff;
        --dash-mobile-menu-bg: #0a0a0a;
        --dash-mobile-link: rgba(255, 255, 255, 0.8);
        --dash-overlay: rgba(0, 0, 0, 0.8);
        --dash-input-border: rgba(255, 255, 255, 0.12);
        --dash-input-text: #ffffff;
        --dash-input-placeholder: rgba(255, 255, 255, 0.4);
        --dash-select-bg: rgba(15, 15, 15, 0.98);
        --dash-select-border: rgba(255, 255, 255, 0.1);
        --dash-select-hover-bg: rgba(255, 255, 255, 0.05);
        --dash-select-hover-border: rgba(255, 255, 255, 0.2);
        --dash-toast-bg: linear-gradient(145deg, rgba(16, 16, 16, 0.98), rgba(5, 5, 5, 0.98));
        --dash-toast-text: #ffffff;
        --dash-toast-border: rgba(255, 255, 255, 0.1);
        --dash-method-border: rgba(255, 255, 255, 0.12);
        --dash-method-hover-bg: rgba(255, 255, 255, 0.05);
        <% } %>
    }

    * { box-sizing: border-box; }

    body {
        font-family: 'Inter', sans-serif;
        background:
            radial-gradient(circle at top left, rgba(109, 10, 10, 0.08), transparent 30%),
            linear-gradient(180deg, var(--dash-bg-alt) 0%, var(--dash-bg) 100%);
        color: var(--dash-text);
        overflow-x: hidden;
        min-height: 100vh;
    }

    .font-heading { font-family: 'Space Grotesk', sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }

    .text-muted { color: var(--dash-muted); }

    .bg-noise {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        opacity: <%= isLightDashboard ? '0.02' : '0.03' %>;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160%22 xmlns='http://www.w3.org/2000/svg%22%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.92' numOctaves='2'/%3E%3C/filter%3E%3Crect width='160' height='160' filter='url(%23noise)' opacity='0.95'/%3E%3C/svg%3E");
    }

    .bg-grid {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        opacity: <%= isLightDashboard ? '0.06' : '0.05' %>;
        background-image:
            linear-gradient(var(--dash-grid-line) 1px, transparent 1px),
            linear-gradient(90deg, var(--dash-grid-line) 1px, transparent 1px);
        background-size: 120px 120px;
        mask-image: radial-gradient(circle at center, black 42%, transparent 86%);
    }

    .glass-card {
        background: var(--dash-card-bg);
        border: 1px solid var(--dash-card-border);
        backdrop-filter: blur(12px);
        box-shadow: var(--dash-card-shadow);
    }

    .glass-nav {
        background: var(--dash-nav-bg);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid var(--dash-nav-border);
    }

    .btn-primary-dark {
        background: var(--dash-primary-bg);
        color: var(--dash-primary-text);
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .btn-primary-dark:hover {
        transform: translateY(-1px);
        background: var(--dash-primary-hover);
        box-shadow: var(--dash-primary-shadow);
    }

    .btn-secondary {
        background: var(--dash-secondary-bg);
        border: 1px solid var(--dash-secondary-border);
        color: var(--dash-secondary-text);
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-secondary:hover {
        background: var(--dash-secondary-hover-bg);
        border-color: var(--dash-card-border-strong);
    }

    .dash-nav-link {
        color: var(--dash-muted);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        transition: color 0.2s ease;
    }

    .dash-nav-link:hover,
    .dash-nav-link.active {
        color: var(--dash-text);
    }

    .dashboard-logo {
        transition: opacity 0.2s ease;
    }

    .dashboard-logo:hover {
        opacity: 0.85;
    }

    .dashboard-nav-divider {
        border-left: 1px solid var(--dash-card-border);
    }

    .dashboard-user-badge {
        background: linear-gradient(135deg, rgba(109, 10, 10, 0.92), rgba(191, 86, 55, 0.88));
        color: #ffffff;
        box-shadow: 0 12px 30px rgba(109, 10, 10, 0.18);
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .dashboard-logout-link:hover {
        color: <%= isLightDashboard ? '#b91c1c' : '#fca5a5' %>;
    }

    .dashboard-mobile-toggle {
        color: var(--dash-text);
        transition: color 0.2s ease;
        z-index: 60;
        cursor: pointer;
    }

    .dashboard-mobile-toggle:hover {
        color: var(--dash-accent);
    }

    .desktop-nav { display: flex; }

    @media (max-width: 768px) {
        .desktop-nav { display: none !important; }
    }

    .mobile-menu {
        transform: translateX(100%);
        transition: transform 0.3s ease;
        background: var(--dash-mobile-menu-bg);
        position: fixed;
        top: 0;
        right: 0;
        width: 300px;
        height: 100vh;
        z-index: 75;
        border-left: 1px solid var(--dash-card-border);
        box-shadow: -24px 0 60px rgba(0, 0, 0, <%= isLightDashboard ? '0.12' : '0.35' %>);
    }

    .mobile-menu.active { transform: translateX(0); }

    .mobile-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 45;
        background: var(--dash-overlay);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .mobile-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }

    .dashboard-mobile-title {
        color: var(--dash-text);
    }

    .dashboard-mobile-link {
        color: var(--dash-mobile-link);
        transition: color 0.2s ease, background 0.2s ease;
    }

    .dashboard-mobile-link:hover,
    .dashboard-mobile-link:focus {
        color: var(--dash-accent);
    }

    .dashboard-mobile-footer {
        border-color: var(--dash-card-border);
    }

    .dashboard-mobile-footer.border-b {
        border-bottom-color: var(--dash-card-border);
    }

    .dashboard-mobile-footer.border-t {
        border-top-color: var(--dash-card-border);
    }

    .input-dark {
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--dash-input-border);
        color: var(--dash-input-text);
        padding: 12px 0;
        font-size: 0.875rem;
        transition: border-color 0.3s ease;
        width: 100%;
    }

    .input-dark:focus {
        outline: none;
        border-color: var(--dash-accent);
    }

    .input-dark::placeholder {
        color: var(--dash-input-placeholder);
    }

    .custom-select {
        position: relative;
        width: 100%;
    }

    .custom-select-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 12px 16px;
        background: <%= isLightDashboard ? 'rgba(109, 10, 10, 0.03)' : 'rgba(255, 255, 255, 0.05)' %>;
        border: 1px solid var(--dash-select-border);
        border-radius: 10px;
        color: var(--dash-input-text);
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }

    .custom-select-trigger:hover {
        border-color: var(--dash-select-hover-border);
        background: var(--dash-select-hover-bg);
    }

    .custom-select-trigger:focus {
        outline: none;
        border-color: rgba(109, 10, 10, 0.38);
        box-shadow: 0 0 0 3px rgba(109, 10, 10, 0.12);
    }

    .custom-select-trigger .selected-text {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .custom-select-trigger .chevron {
        width: 16px;
        height: 16px;
        transition: transform 0.2s ease;
        opacity: 0.6;
    }

    .custom-select.open .custom-select-trigger .chevron {
        transform: rotate(180deg);
    }

    .custom-select-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        background: var(--dash-select-bg);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--dash-select-border);
        border-radius: 12px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, <%= isLightDashboard ? '0.08' : '0.5' %>);
        z-index: 2000;
        max-height: 280px;
        overflow-y: auto;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.2s ease;
    }

    .custom-select.open .custom-select-dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .custom-select-dropdown::-webkit-scrollbar {
        width: 6px;
    }

    .custom-select-dropdown::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-select-dropdown::-webkit-scrollbar-thumb {
        background: <%= isLightDashboard ? 'rgba(109, 10, 10, 0.14)' : 'rgba(255, 255, 255, 0.1)' %>;
        border-radius: 3px;
    }

    .custom-select-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        color: <%= isLightDashboard ? '#514541' : 'rgba(255, 255, 255, 0.8)' %>;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .custom-select-option:hover {
        background: var(--dash-select-hover-bg);
        color: var(--dash-text);
    }

    .custom-select-option.selected {
        background: <%= isLightDashboard ? 'rgba(109, 10, 10, 0.08)' : 'rgba(139, 92, 246, 0.15)' %>;
        color: <%= isLightDashboard ? 'var(--dash-accent)' : '#ffffff' %>;
    }

    .custom-select-option.selected::after {
        content: '';
        width: 8px;
        height: 8px;
        background: <%= isLightDashboard ? 'var(--dash-accent)' : '#8b5cf6' %>;
        border-radius: 50%;
    }

    select[data-custom-select] {
        position: absolute;
        opacity: 0;
        pointer-events: none;
        width: 0;
        height: 0;
        overflow: hidden;
    }

    .toast {
        position: fixed;
        bottom: 24px;
        right: 24px;
        padding: 16px 24px;
        border-radius: 12px;
        background: var(--dash-toast-bg);
        border: 1px solid var(--dash-toast-border);
        color: var(--dash-toast-text);
        font-size: 0.875rem;
        box-shadow: 0 24px 80px rgba(0, 0, 0, <%= isLightDashboard ? '0.12' : '0.5' %>);
        z-index: 2000;
        transform: translateY(100px);
        opacity: 0;
        transition: all 0.3s ease;
    }

    .toast.show {
        transform: translateY(0);
        opacity: 1;
    }

    .toast.success { border-left: 4px solid #22c55e; }
    .toast.error { border-left: 4px solid #ef4444; }

    .method-card {
        border: 1px solid var(--dash-method-border);
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .method-card:hover {
        border-color: var(--dash-card-border-strong);
        background: var(--dash-method-hover-bg);
    }

    .method-card.selected {
        border-color: var(--dash-accent);
        background: <%= isLightDashboard ? 'rgba(109, 10, 10, 0.08)' : 'rgba(255, 255, 255, 0.1)' %>;
    }

    @media (max-width: 1024px) {
        main {
            padding-bottom: 80px;
        }
    }
</style>
