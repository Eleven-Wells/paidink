<aside class="home-side-nav" style="grid-area: nav;">
    <nav>
        <a href="/" aria-label="Home">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
            <span>Home</span>
        </a>
        <a href="/browse" aria-label="Explore">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
            </svg>
            <span>Explore</span>
        </a>
        <a href="/activity" aria-label="Activity"
            style="position: relative; display: inline-flex; align-items: center; gap: 15px;">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="currentColor">
                <path
                    d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" />
            </svg>
            <span>Activity</span>
            <% if (typeof unreadCount !=='undefined' && unreadCount> 0) { %>
                <span class="home-nav-badge">
                    <%= unreadCount> 99 ? '99+' : unreadCount %>
                </span>
                <% } %>
        </a>
        <a href="/dashboard" aria-label="Dashboard">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="14" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
            </svg>
            <span>Dashboard</span>
        </a>
        <a href="/profile" aria-label="Profile">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
            <span>Profile</span>
        </a>
    </nav>
    <a href="/#post-composer" class="side-nav-cta">
        Write Post
    </a>
</aside>

<style>
    .home-side-nav {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
        padding: 18px 18px 32px 24px;
        width: 100%;
        height: 100vh;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .home-side-nav>nav {
        display: flex;
        flex-direction: column;
        gap: 30px;
        width: min(100%, 232px);
    }

    .home-side-nav>nav>a {
        display: inline-flex;
        align-items: center;
        gap: 15px;
        text-decoration: none;
        color: #000;
        cursor: pointer;
        border-radius: 999px;
        padding: 4px 8px 4px 0;
        transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

    .home-side-nav>nav>a:hover,
    .home-side-nav>nav>a:focus {
        color: #6d0a0a;
        background: rgba(109, 10, 10, 0.04);
    }

    .home-side-nav>nav>a svg,
    .side-nav-cta {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .home-side-nav>nav>a.is-pressing svg {
        animation: sideNavIconPop 0.38s cubic-bezier(0.2, 0.9, 0.2, 1.2) both;
    }

    .side-nav-cta.is-pressing {
        animation: sideNavCtaPress 0.32s cubic-bezier(0.2, 0.85, 0.2, 1) both;
    }

    .home-side-nav>nav>a>span {
        font-family: 'Abhaya Libre', serif;
        font-weight: 400;
        font-size: 32px;
        white-space: nowrap;
    }

    .home-nav-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: 999px;
        background: #6d0a0a;
        color: #fff;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 700;
    }

    .side-nav-cta {
        display: flex;
        height: 70px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 10px;
        width: min(100%, 232px);
        background: #6d0a0a;
        border-radius: 45px;
        text-decoration: none;
        color: #fff;
        font-family: 'Abhaya Libre', serif;
        font-weight: 500;
        font-size: 28px;
        white-space: nowrap;
        cursor: pointer;
    }

    .side-nav-cta:hover,
    .side-nav-cta:focus {
        transform: translateY(-1px);
        box-shadow: 0 14px 28px rgba(109, 10, 10, 0.18);
    }

    @keyframes sideNavIconPop {
        0% { transform: translateY(0) scale(1); }
        36% { transform: translateY(-7px) scale(1.16) rotate(-5deg); }
        64% { transform: translateY(2px) scale(0.95) rotate(3deg); }
        100% { transform: translateY(0) scale(1.04) rotate(0); }
    }

    @keyframes sideNavCtaPress {
        0% { transform: translateY(0) scale(1); }
        45% { transform: translateY(-2px) scale(1.03); }
        100% { transform: translateY(0) scale(1); }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-side-nav>nav>a,
        .home-side-nav>nav>a svg,
        .side-nav-cta {
            transition: none;
        }

        .home-side-nav>nav>a.is-pressing svg,
        .side-nav-cta.is-pressing {
            animation: none;
        }
    }

    @media (max-width: 1400px) {
        .home-side-nav>nav>a>span {
            font-size: 28px;
        }

        .home-side-nav>nav {
            width: min(100%, 210px);
            gap: 28px;
        }

        .side-nav-cta {
            font-size: 24px;
            height: 60px;
        }
    }

    @media (max-width: 1024px) {
        .home-side-nav {
            display: none;
        }
    }
</style>

<script>
(function() {
    var sidebarItems = document.querySelectorAll('.home-side-nav > nav > a, .home-side-nav .side-nav-cta');
    sidebarItems.forEach(function(item) {
        item.addEventListener('click', function() {
            item.classList.remove('is-pressing');
            void item.offsetWidth;
            item.classList.add('is-pressing');
            window.setTimeout(function() {
                item.classList.remove('is-pressing');
            }, 420);
        });
    });
})();
</script>
