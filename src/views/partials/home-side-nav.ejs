<aside class="home-side-nav">
    <nav>
        <a href="/" aria-label="Home">
            <%- include('./animated-nav-icon', { icon: 'home', size: 38 }) %>
            <span>Home</span>
        </a>
        <a href="/browse" aria-label="Explore">
            <%- include('./animated-nav-icon', { icon: 'explore', size: 38 }) %>
            <span>Explore</span>
        </a>
        <a href="/subscriptions" aria-label="Subscription">
            <%- include('./animated-nav-icon', { icon: 'subscription', size: 38 }) %>
            <span>Subscription</span>
        </a>
        <a href="/chat" aria-label="Chat">
            <%- include('./animated-nav-icon', { icon: 'chat', size: 38 }) %>
            <span>Chat</span>
        </a>
        <a href="/activity" aria-label="Activity"
            style="position: relative; display: inline-flex; align-items: center; gap: 15px;">
            <%- include('./animated-nav-icon', { icon: 'activity', size: 38 }) %>
            <span>Activity</span>
            <% if (typeof unreadCount !=='undefined' && unreadCount> 0) { %>
                <span class="home-nav-badge">
                    <%= unreadCount> 99 ? '99+' : unreadCount %>
                </span>
                <% } %>
        </a>
        <a href="/dashboard" aria-label="Dashboard">
            <%- include('./animated-nav-icon', { icon: 'dashboard', size: 36 }) %>
            <span>Dashboard</span>
        </a>
        <a href="/profile" aria-label="Profile">
            <%- include('./animated-nav-icon', { icon: 'profile', size: 38 }) %>
            <span>Profile</span>
        </a>
    </nav>
    <a href="/#post-composer" class="side-nav-cta">
        Write Post
    </a>
</aside>

<style>
    .home-side-nav {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: space-between;
        gap: 28px;
        padding: 12px 14px;
        width: 100%;
        height: 100vh;
        position: sticky;
        top: 0;
        z-index: 1;
    }

    .home-side-nav>nav {
        display: flex;
        flex-direction: column;
        gap: 20px;
        font-size: 15px;
        width: min(100%, 150px);
    }

    .home-side-nav>nav>a {
        display: inline-flex;
        align-items: center;
        gap: 15px;
        text-decoration: none;
        color: #000;
        cursor: pointer;
        border-radius: 999px;
        padding: 4px 8px 4px 0;
        transition: color 0.2s ease, background 0.2s ease;
    }

    .home-side-nav>nav>a:hover,
    .home-side-nav>nav>a:focus {
        color: #6d0a0a;
        background: rgba(109, 10, 10, 0.04);
    }

    .home-side-nav>nav>a svg {
        flex: 0 0 auto;
        overflow: visible;
    }

    .animated-nav-icon {
        --nav-icon-draw: 64;
    }

    .animated-nav-icon .nav-icon-path,
    .animated-nav-icon .nav-icon-tile {
        vector-effect: non-scaling-stroke;
    }

    .animated-nav-icon-home .nav-icon-home-roof,
    .animated-nav-icon-home .nav-icon-home-frame,
    .animated-nav-icon-home .nav-icon-home-door,
    .animated-nav-icon-explore .nav-icon-compass-ring,
    .animated-nav-icon-explore .nav-icon-compass-needle,
    .animated-nav-icon-activity .nav-icon-bell-body,
    .animated-nav-icon-activity .nav-icon-bell-cap,
    .animated-nav-icon-activity .nav-icon-bell-clapper,
    .animated-nav-icon-profile .nav-icon-profile-head,
    .animated-nav-icon-profile .nav-icon-profile-shoulders,
    .animated-nav-icon-subscription .nav-icon-subscription-book,
    .animated-nav-icon-chat .nav-icon-chat-bubble {
        stroke-dasharray: var(--nav-icon-draw);
        stroke-dashoffset: 0;
    }

    .nav-icon-compass-needle,
    .nav-icon-bell-body,
    .nav-icon-bell-clapper,
    .nav-icon-profile-head,
    .nav-icon-tile {
        transform-box: fill-box;
        transform-origin: center;
    }

    .nav-icon-bell-ring,
    .nav-icon-profile-spark,
    .nav-icon-chat-dot {
        opacity: 0;
        vector-effect: non-scaling-stroke;
    }

    .home-side-nav>nav>a:hover .nav-icon-home-roof,
    .home-side-nav>nav>a:focus .nav-icon-home-roof,
    .home-side-nav>nav>a.is-pressing .nav-icon-home-roof {
        animation: navIconDraw 0.58s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-side-nav>nav>a:hover .nav-icon-home-door,
    .home-side-nav>nav>a:focus .nav-icon-home-door,
    .home-side-nav>nav>a.is-pressing .nav-icon-home-door {
        animation: navIconDoor 0.58s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-side-nav>nav>a:hover .nav-icon-compass-ring,
    .home-side-nav>nav>a:focus .nav-icon-compass-ring,
    .home-side-nav>nav>a.is-pressing .nav-icon-compass-ring {
        animation: navIconDraw 0.62s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-side-nav>nav>a:hover .nav-icon-compass-needle,
    .home-side-nav>nav>a:focus .nav-icon-compass-needle,
    .home-side-nav>nav>a.is-pressing .nav-icon-compass-needle {
        animation: navIconNeedle 0.68s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-side-nav>nav>a:hover .nav-icon-compass-dot,
    .home-side-nav>nav>a:focus .nav-icon-compass-dot,
    .home-side-nav>nav>a.is-pressing .nav-icon-compass-dot {
        animation: navIconPulse 0.5s ease both;
    }

    .home-side-nav>nav>a:hover .nav-icon-bell-body,
    .home-side-nav>nav>a:focus .nav-icon-bell-body,
    .home-side-nav>nav>a.is-pressing .nav-icon-bell-body {
        animation: navIconBell 0.72s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-side-nav>nav>a:hover .nav-icon-bell-clapper,
    .home-side-nav>nav>a:focus .nav-icon-bell-clapper,
    .home-side-nav>nav>a.is-pressing .nav-icon-bell-clapper {
        animation: navIconClapper 0.72s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-side-nav>nav>a:hover .nav-icon-bell-ring,
    .home-side-nav>nav>a:focus .nav-icon-bell-ring,
    .home-side-nav>nav>a.is-pressing .nav-icon-bell-ring {
        animation: navIconRing 0.72s ease both;
    }

    .home-side-nav>nav>a:hover .nav-icon-tile,
    .home-side-nav>nav>a:focus .nav-icon-tile,
    .home-side-nav>nav>a.is-pressing .nav-icon-tile {
        animation: navIconTile 0.58s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-side-nav>nav>a:hover .nav-icon-tile-2,
    .home-side-nav>nav>a:focus .nav-icon-tile-2,
    .home-side-nav>nav>a.is-pressing .nav-icon-tile-2 { animation-delay: 0.04s; }

    .home-side-nav>nav>a:hover .nav-icon-tile-3,
    .home-side-nav>nav>a:focus .nav-icon-tile-3,
    .home-side-nav>nav>a.is-pressing .nav-icon-tile-3 { animation-delay: 0.08s; }

    .home-side-nav>nav>a:hover .nav-icon-tile-4,
    .home-side-nav>nav>a:focus .nav-icon-tile-4,
    .home-side-nav>nav>a.is-pressing .nav-icon-tile-4 { animation-delay: 0.12s; }

    .home-side-nav>nav>a:hover .nav-icon-profile-head,
    .home-side-nav>nav>a:focus .nav-icon-profile-head,
    .home-side-nav>nav>a.is-pressing .nav-icon-profile-head {
        animation: navIconHead 0.62s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-side-nav>nav>a:hover .nav-icon-profile-shoulders,
    .home-side-nav>nav>a:focus .nav-icon-profile-shoulders,
    .home-side-nav>nav>a.is-pressing .nav-icon-profile-shoulders {
        animation: navIconDraw 0.58s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-side-nav>nav>a:hover .nav-icon-profile-spark,
    .home-side-nav>nav>a:focus .nav-icon-profile-spark,
    .home-side-nav>nav>a.is-pressing .nav-icon-profile-spark {
        animation: navIconSpark 0.6s ease both;
    }

    .home-side-nav>nav>a:hover .nav-icon-subscription-book,
    .home-side-nav>nav>a:focus .nav-icon-subscription-book,
    .home-side-nav>nav>a.is-pressing .nav-icon-subscription-book {
        animation: navIconDraw 0.58s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-side-nav>nav>a:hover .nav-icon-chat-bubble,
    .home-side-nav>nav>a:focus .nav-icon-chat-bubble,
    .home-side-nav>nav>a.is-pressing .nav-icon-chat-bubble {
        animation: navIconDraw 0.58s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .home-side-nav>nav>a:hover .nav-icon-chat-dot,
    .home-side-nav>nav>a:focus .nav-icon-chat-dot,
    .home-side-nav>nav>a.is-pressing .nav-icon-chat-dot {
        animation: navIconRing 0.72s ease both;
    }

    .side-nav-cta {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .side-nav-cta.is-pressing {
        animation: sideNavCtaPress 0.32s cubic-bezier(0.2, 0.85, 0.2, 1) both;
    }

    .home-side-nav>nav>a>span {
        font-family: 'Abhaya Libre', serif;
        font-weight: 400;
        font-size: 32px;
        white-space: nowrap;
    }

    .home-nav-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: 999px;
        background: #6d0a0a;
        color: #fff;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 700;
    }

    .side-nav-cta {
        display: flex;
        height: 70px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 10px;
        width: min(100%, 232px);
        background: #6d0a0a;
        border-radius: 45px;
        text-decoration: none;
        color: #fff;
        font-family: 'Abhaya Libre', serif;
        font-weight: 500;
        font-size: 28px;
        white-space: nowrap;
        cursor: pointer;
    }

    .side-nav-cta:hover,
    .side-nav-cta:focus {
        transform: translateY(-1px);
        box-shadow: 0 14px 28px rgba(109, 10, 10, 0.18);
    }

    @keyframes sideNavCtaPress {
        0% { transform: translateY(0) scale(1); }
        45% { transform: translateY(-2px) scale(1.03); }
        100% { transform: translateY(0) scale(1); }
    }

    @keyframes navIconDraw {
        0% { stroke-dashoffset: var(--nav-icon-draw); opacity: 0.35; }
        100% { stroke-dashoffset: 0; opacity: 1; }
    }

    @keyframes navIconDoor {
        0% { stroke-dashoffset: var(--nav-icon-draw); transform: translateY(2px); opacity: 0.2; }
        100% { stroke-dashoffset: 0; transform: translateY(0); opacity: 1; }
    }

    @keyframes navIconNeedle {
        0% { transform: rotate(-36deg) scale(0.82); opacity: 0.45; }
        58% { transform: rotate(12deg) scale(1.08); opacity: 1; }
        100% { transform: rotate(0) scale(1); opacity: 1; }
    }

    @keyframes navIconPulse {
        0% { transform: scale(0.35); opacity: 0.2; }
        55% { transform: scale(1.45); opacity: 1; }
        100% { transform: scale(1); opacity: 1; }
    }

    @keyframes navIconBell {
        0% { transform: rotate(0); }
        22% { transform: rotate(-11deg); }
        48% { transform: rotate(9deg); }
        72% { transform: rotate(-4deg); }
        100% { transform: rotate(0); }
    }

    @keyframes navIconClapper {
        0% { transform: translateX(0); }
        22% { transform: translateX(1.5px); }
        48% { transform: translateX(-1.3px); }
        72% { transform: translateX(0.6px); }
        100% { transform: translateX(0); }
    }

    @keyframes navIconRing {
        0%, 100% { opacity: 0; transform: translateY(0); }
        30% { opacity: 1; transform: translateY(-1px); }
        70% { opacity: 0.55; transform: translateY(-2px); }
    }

    @keyframes navIconTile {
        0% { transform: translateY(2px) scale(0.82); opacity: 0.35; }
        58% { transform: translateY(-1px) scale(1.08); opacity: 1; }
        100% { transform: translateY(0) scale(1); opacity: 1; }
    }

    @keyframes navIconHead {
        0% { transform: translateY(2px) scale(0.86); opacity: 0.45; }
        60% { transform: translateY(-1px) scale(1.08); opacity: 1; }
        100% { transform: translateY(0) scale(1); opacity: 1; }
    }

    @keyframes navIconSpark {
        0%, 100% { opacity: 0; transform: scale(0.5) rotate(0); }
        42% { opacity: 1; transform: scale(1.18) rotate(90deg); }
        72% { opacity: 0.7; transform: scale(1) rotate(135deg); }
    }

    @media (prefers-reduced-motion: reduce) {
        .home-side-nav>nav>a,
        .home-side-nav>nav>a svg,
        .home-side-nav>nav>a svg *,
        .side-nav-cta {
            transition: none;
            animation: none !important;
        }

        .side-nav-cta.is-pressing {
            animation: none;
        }
    }

    @media (max-width: 1400px) {
        .home-side-nav>nav>a>span {
            font-size: 28px;
        }

        .home-side-nav>nav {
            width: min(100%, 210px);
            gap: 28px;
        }

        .side-nav-cta {
            font-size: 24px;
            height: 60px;
        }
    }

    /* Nav visibility is controlled by .home-nav-column in home-logged-in.ejs */
</style>

<script>
(function() {
    var sidebarItems = document.querySelectorAll('.home-side-nav > nav > a, .home-side-nav .side-nav-cta');
    sidebarItems.forEach(function(item) {
        item.addEventListener('click', function() {
            item.classList.remove('is-pressing');
            void item.offsetWidth;
            item.classList.add('is-pressing');
            window.setTimeout(function() {
                item.classList.remove('is-pressing');
            }, 420);
        });
    });
})();
</script>
