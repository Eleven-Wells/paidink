<aside class="explore-trending" aria-labelledby="explore-trending-heading" style="padding: clamp(24px, 4vw, 46px) clamp(12px, 2vw, 16px); border-radius: clamp(24px, 4vw, 58px); border: 1px solid #000; background: #fff;">
    <div style="display: flex; flex-direction: column; width: 100%; align-items: flex-start; gap: clamp(16px, 3vw, 32px);">
        <h2 id="explore-trending-heading" style="margin: 0; font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(20px, 3vw, 32px); color: #000;">
            Trending
        </h2>
        
        <div style="display: flex; flex-direction: column; align-items: flex-start; gap: clamp(24px, 4vw, 46px); width: 100%;">
            <% if (typeof trendingPosts !== 'undefined' && trendingPosts && trendingPosts.length > 0) { %>
                <% trendingPosts.forEach(function(post, index) { %>
                    <article style="display: flex; flex-direction: column; align-items: center; gap: clamp(12px, 2vw, 19px); width: 100%;">
                        <div style="display: flex; align-items: flex-start; justify-content: space-between; width: 100%;">
                            <div style="display: flex; align-items: flex-start; gap: clamp(12px, 2vw, 26px);">
                                <%- include('../partials/avatar', { user: post.author, size: 'clamp(40px, 5vw, 55px)' }) %>
                                <div style="font-family: 'Abhaya Libre', serif; font-weight: 400; font-size: clamp(16px, 2vw, 24px); color: #000;">
                                    <p style="margin: 0;">Up next</p>
                                    <p style="margin: 4px 0 0;"><%= post.author ? post.author.displayName : 'Anonymous' %></p>
                                    <p style="margin: 4px 0 0; font-weight: 500;"><%= post.title %></p>
                                    <p style="margin: 4px 0 0; color: rgba(0,0,0,0.6);"><%= post.readTime || '5m' %> read <%= post.likes ? post.likes.length : 0 %> likes</p>
                                </div>
                            </div>
                            <button type="button" aria-label="Save article" style="margin-left: clamp(8px, 1.5vw, 16px); display: flex; height: clamp(24px, 3vw, 33px); width: clamp(24px, 3vw, 33px); flex-shrink: 0; align-items: center; justify-content: center; background: none; border: none; cursor: pointer;">
                                <svg width="clamp(24px, 3vw, 33px)" height="clamp(24px, 3vw, 33px)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                                </svg>
                            </button>
                        </div>
                        <% if (index < trendingPosts.length - 1) { %>
                            <img alt="Divider" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 610 1' preserveAspectRatio='none'%3E%3Cline x1='0' y1='0.5' x2='610' y2='0.5' stroke='rgba(0,0,0,0.15)' stroke-width='1'/%3E%3C/svg%3E" style="width: 100%; height: 1px; object-fit: contain; display: block;" />
                        <% } %>
                    </article>
                <% }); %>
            <% } else { %>
                <%- include('../partials/empty-state-card', {
                    title: 'Nothing is trending yet',
                    copy: 'The most-read posts will show up here once the room gets moving.',
                    compact: true
                }) %>
            <% } %>
        </div>
    </div>
</aside>

<style>
    .explore-trending {
        margin-left: auto;
        margin-right: clamp(8px, 1vw, 16px);
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    @media (max-width: 1100px) {
        .explore-trending {
            display: none !important;
        }
    }
</style>
