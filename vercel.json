{
    "functions": {
        "api/index.js": {
            "runtime": "nodejs@20",
            "maxDuration": 30
        },
        "api/cron.js": {
            "runtime": "nodejs@20",
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/public/(.*)",
            "destination": "/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/api/index"
        }
    ],
    "headers": [
        {
            "source": "/public/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, immutable"
                }
            ]
        },
        {
            "source": "/public/images/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400, immutable"
                }
            ]
        }
    ],
    "crons": [
        {
            "path": "/api/cron?job=tools-update",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/cron?job=content-ingestion",
            "schedule": "0 */6 * * *"
        },
        {
            "path": "/api/cron?job=feed-update",
            "schedule": "0 */2 * * *"
        },
        {
            "path": "/api/cron?job=seo-update",
            "schedule": "0 3 * * *"
        },
        {
            "path": "/api/cron?job=content-cleanup",
            "schedule": "0 4 * * 0"
        },
        {
            "path": "/api/cron?job=reader-pool-sweep",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron?job=unfunded-reads-sweep",
            "schedule": "30 0 * * *"
        }
    ],
    "github": {
        "enabled": true,
        "silent": true
    }
}
