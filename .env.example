# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MongoDB connection string
# Local: mongodb://admin:password@localhost:27017/simpleblog?authSource=admin
# Production (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb://admin:password@localhost:27017/simpleblog?authSource=admin

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_here

# ============================================================================
# API KEYS (Required for functionality)
# ============================================================================

# OpenAI API Key - for AI content generation
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Unsplash API Key - for fetching images
# Get yours at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# NewsAPI Key - for fetching news articles (optional)
# Get yours at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server port
PORT=5050

# Environment mode (development, production)
NODE_ENV=development

# ============================================================================
# ADMIN & SECURITY
# ============================================================================

# Admin API Key - required for protected endpoints
# Generate a secure random string: openssl rand -hex 32
ADMIN_API_KEY=generate_a_secure_random_string_here

# Vercel Cron Secret - required for /api/cron endpoint authorization
# Must match the value in Vercel project settings (Environment Variables)
# CRON_SECRET=generate_a_secure_random_string_here

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5050,http://localhost:3000,https://your-production-domain.com

# ---------------------------------------------------------------------------
# IP Allowlisting (optional)
# Comma-separated list of IP addresses allowed to access admin endpoints
# Leave empty to allow all IPs
# ADMIN_ALLOWED_IPS=203.0.113.1,198.51.100.42
ADMIN_ALLOWED_IPS=

# ---------------------------------------------------------------------------
# API Key Rotation (optional)
# Set to 'true' to enable API key rotation support
API_KEY_ROTATION_ENABLED=false

# ---------------------------------------------------------------------------
# Rate Limiting for Admin API (optional)
# Maximum requests per API key per window
ADMIN_RATE_LIMIT_MAX=100
# Window in milliseconds (60000 = 1 minute)
ADMIN_RATE_LIMIT_WINDOW=60000

# ---------------------------------------------------------------------------
# CSRF Protection (optional)
# Set to 'true' to enable CSRF protection for admin endpoints
# CSRF_ENABLED=false
# Secret for CSRF token generation (generate: openssl rand -hex 32)
# CSRF_SECRET=your_csrf_secret_here

# ============================================================================
# ERROR TRACKING (Sentry)
# ============================================================================

# Sentry DSN for error tracking (optional but recommended for production)
# Get yours at: https://sentry.io
# SENTRY_DSN=https://examplePublicKey@o123456.ingest.sentry.io/1234567

# Discord webhook for beta reviews (optional)
# Create a webhook in the Discord channel where review alerts should appear.
# DISCORD_REVIEW_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Supabase Auth (for social login with Google, X/Twitter, Discord)
# Find these in your Supabase project: Settings > API
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Base URL for sitemap and SEO (include protocol and trailing slash)
BASE_URL=http://localhost:5050

# Maximum content length for AI processing
MAX_CONTENT_LENGTH=5000

# Limit of content sources to process
CONTENT_SOURCES_LIMIT=10

# AI summary length
AI_SUMMARY_LENGTH=300

# AI rewrite length
AI_REWRITE_LENGTH=800

# ============================================================================
# CRON SCHEDULE CONFIGURATION (cron format)
# ============================================================================

# Tools/dev resources update - every hour
TOOLS_UPDATE_SCHEDULE=0 * * * *

# Content ingestion - every 6 hours
CONTENT_INGESTION_SCHEDULE=0 */6 * * *

# Feed update - every 2 hours
FEED_UPDATE_SCHEDULE=0 */2 * * *

# SEO update - daily at 3 AM
SEO_UPDATE_SCHEDULE=0 3 * * *

# Content cleanup - weekly on Sunday at 4 AM
CLEANUP_SCHEDULE=0 4 * * 0

# ============================================================================
# OPTIONAL: SMTP CONFIGURATION (for newsletter emails)
# ============================================================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# ============================================================================
# LOGGING
# ============================================================================

# Log level: debug, info, warn, error, fatal
LOG_LEVEL=info

# ============================================================================
# FEATURE FLAGS (set to 'false' to disable features)
# ============================================================================

# Content features
FEATURE_AI_GENERATION=true
FEATURE_AUTO_INGESTION=true
FEATURE_IMAGE_GENERATION=true
FEATURE_INTERNAL_LINKING=true

# SEO features
FEATURE_SITEMAP=true
FEATURE_SEO_UPDATES=true

# Social features
FEATURE_NEWSLETTER=true
FEATURE_SOCIAL_SHARING=false

# Security features
FEATURE_RATE_LIMITING=true
FEATURE_IP_ALLOWLIST=false

# Analytics features
FEATURE_AUDIT_LOGGING=true

# Maintenance
MAINTENANCE_MODE=false
